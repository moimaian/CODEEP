#!/bin/bash
# /usr/bin/codeep — instalado pelo pacote .deb.
#
# Roda como o usuário comum que clicou no menu (não como root). Só faz duas
# coisas:
#   1) sincroniza o código instalado pelo pacote em /opt/codeep para
#      $HOME/CODEEP, sem nunca tocar em dados do usuário (PROJECTS/, data/,
#      checkpoints/, hpo/, tools/) nem em caches de bytecode;
#   2) delega tudo o mais — criação/atualização do venv em
#      $HOME/.venv/CODEEP, instalação das dependências científicas (janela
#      Install Requirements) e criação do .desktop em
#      ~/.local/share/applications — para o próprio CODEEP.py, que já faz isso
#      sozinho na primeira execução (ver _bootstrap_venv em CODEEP.py).
set -euo pipefail

SRC_DIR="/opt/codeep"
APP_DIR="${HOME}/CODEEP"

if [ ! -d "$SRC_DIR" ]; then
    echo "codeep: $SRC_DIR não encontrado — o pacote está corrompido ou foi removido." >&2
    exit 1
fi

mkdir -p "$APP_DIR"

# Proteção para quem desenvolve o CODEEP: se $HOME/CODEEP for um repositório git (a cópia de
# trabalho do desenvolvedor), NÃO a sobrescrevemos com a versão do pacote — isso apagaria
# alterações ainda não comitadas. Quem só usa o programa nunca tem essa pasta .git.
if [ -d "$APP_DIR/.git" ]; then
    echo "codeep: $APP_DIR é um repositório git — sincronização com $SRC_DIR ignorada." >&2
elif command -v rsync >/dev/null 2>&1; then
    rsync -a \
        --exclude='PROJECTS/' \
        --exclude='data/' \
        --exclude='checkpoints/' \
        --exclude='hpo/' \
        --exclude='tools/' \
        --exclude='__pycache__/' \
        --exclude='*.pyc' \
        "$SRC_DIR"/ "$APP_DIR"/
else
    # Fallback sem rsync: copia tudo exceto as pastas de dados do usuário.
    for item in "$SRC_DIR"/*; do
        name="$(basename "$item")"
        case "$name" in
            PROJECTS|data|checkpoints|hpo|tools) continue ;;
        esac
        cp -rf "$item" "$APP_DIR"/
    done
fi

# O menu abre o CODEEP sem terminal (Terminal=false no .desktop; a saída do programa fica em
# ~/.local/state/CODEEP/terminal.log, acessível por "Ver Terminal" na aba INÍCIO). Só a
# PRIMEIRA execução, que ainda precisa criar o venv e pede confirmação no terminal, é
# reaberta dentro de um emulador de terminal.
VENV_PY="${HOME}/.venv/CODEEP/bin/python"
if [ ! -x "$VENV_PY" ] && [ ! -t 0 ] && [ -z "${CODEEP_SETUP_TERMINAL:-}" ]; then
    export CODEEP_SETUP_TERMINAL=1
    SELF="$(readlink -f "$0")"
    if command -v gnome-terminal >/dev/null 2>&1; then
        exec gnome-terminal --title="CODEEP - Setup" -- "$SELF" "$@"
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        exec x-terminal-emulator -e "$SELF"
    elif command -v xterm >/dev/null 2>&1; then
        exec xterm -T "CODEEP - Setup" -e "$SELF" "$@"
    fi
fi

# Com o venv já criado, entra direto nele (o mesmo comando do atalho que o CODEEP grava em
# ~/.local/share/applications); sem ele, o CODEEP.py cria o venv e se reinicia dentro dele.
if [ -x "$VENV_PY" ]; then
    exec env PYTHONNOUSERSITE=1 "$VENV_PY" "$APP_DIR/CODEEP.py" "$@"
fi
exec python3 "$APP_DIR/CODEEP.py" "$@"
