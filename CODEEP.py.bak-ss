# QGroupBox sem cor de fundo própria (só a borda) — sobrepõe localmente o "background:
# #14253A" do QGroupBox global (_SS_MAIN acima) com o mesmo tom da janela principal
# (BG_DEEP #0D1B2A), mantendo borda/título/margens herdados do estilo global (o Qt mescla
# propriedade a propriedade entre o stylesheet local do widget e o da aplicação — só a
# propriedade especificada aqui é sobrescrita). Usado nos grupos da aba Home.
_SS_GROUPBOX_NO_BG = "QGroupBox { background: #0D1B2A; }"


class CollapsibleGroupBox(QGroupBox):
    """QGroupBox colapsável ao clicar no título ou na borda."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._collapsed = False

    def _collapsed_height(self):
        return max(28, self.fontMetrics().height() + 14)

    def _set_layout_widgets_visible(self, layout, visible):
        if layout is None:
            return
        for i in range(layout.count()):
            item = layout.itemAt(i)
            widget = item.widget()
            if widget is not None:
                widget.setVisible(visible)
            child_layout = item.layout()
            if child_layout is not None:
                self._set_layout_widgets_visible(child_layout, visible)

    def set_collapsed(self, collapsed):
        self._collapsed = bool(collapsed)
        self._set_layout_widgets_visible(self.layout(), not self._collapsed)
        if self._collapsed:
            h = self._collapsed_height()
            self.setMinimumHeight(h)
            self.setMaximumHeight(h)
        else:
            self.setMinimumHeight(0)
            self.setMaximumHeight(16777215)
            self.adjustSize()

    def _is_toggle_hit(self, pos):
        title_h = self._collapsed_height()
        border = 6
        if pos.y() <= title_h:
            return True
        return (
            pos.x() <= border
            or pos.x() >= self.width() - border
            or pos.y() >= self.height() - border
        )

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton and self._is_toggle_hit(event.pos()):
            self.set_collapsed(not self._collapsed)
            event.accept()
            return
        super().mousePressEvent(event)


# ==========================================================================================================================================
# ═══════════════════════════ WORKER GENÉRICO ══════════════════════════════
# Arquitectura de dois níveis:
#
#   PipelineWorker (QThread)
#     └─ _ChildProcess (multiprocessing.Process)
#           └─ fn(*args, **kwargs)   ← pipeline real (download, treino, etc.)
#
# O pipeline roda em um processo filho independente do CODEEP.
# Stop chama proc.terminate() + proc.kill() no filho — o CODEEP continua
# aberto normalmente. stdout/stderr do filho são lidos via multiprocessing.Queue
# e emitidos como sinais Qt linha a linha.
#
# Progresso: parseia linhas do tqdm ("NN%|" ou "N/M") para valor real.
# ETA:       calculado a partir do progresso real e tempo decorrido.
# ==========================================================================================================================================
import io, contextlib, traceback, time as _time, re as _re
import multiprocessing as _mp

# Função de topo de módulo necessária para multiprocessing no Linux (fork-safe)
def _child_run(fn, args, kwargs, queue):
    """Executada no processo filho. Redireciona stdout/stderr para a queue."""
    import io, sys, contextlib, traceback

    # Garante UTF-8 no processo filho (spawn não herda locale do pai)
    import locale, os
    os.environ.setdefault("PYTHONIOENCODING", "utf-8")
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass

    class _QueueWriter(io.TextIOBase):
        """Escreve linhas na queue compartilhada entre filho e pai."""
        def __init__(self, q):
            super().__init__()
            self._q   = q
            self._buf = ""

        def write(self, s):
            self._buf += s
            while "\n" in self._buf:
                line, self._buf = self._buf.split("\n", 1)
                self._q.put(("line", line))
            return len(s)

        def flush(self):
            if self._buf:
                self._q.put(("line", self._buf))
                self._buf = ""

    writer = _QueueWriter(queue)
    try:
        with contextlib.redirect_stdout(writer), contextlib.redirect_stderr(writer):
            fn(*args, **kwargs)
        queue.put(("done", True))
    except Exception:
        writer.write(traceback.format_exc())
        writer.flush()
        queue.put(("done", False))


class PipelineWorker(QThread):
    """
    QThread que gerencia um processo filho (multiprocessing.Process).
    O pipeline roda no filho; Stop() mata apenas o filho — CODEEP continua.
    Emite log_signal, progress_signal, eta_signal e finished_signal.
    """
    log_signal      = pyqtSignal(str)
    progress_signal = pyqtSignal(int)   # 0-100, valor real do tqdm
    eta_signal      = pyqtSignal(str)   # ex: "2m 30s"
    finished_signal = pyqtSignal(bool)  # True = sucesso

    # Regex para extrair progresso de linhas do tqdm e similares
    _RE_PCT  = _re.compile(r'\b(\d{1,3})%\|')
    _RE_FRAC = _re.compile(r'\b(\d+)/(\d+)\b')

    def __init__(self, fn, args=(), kwargs=None, parent=None):
        super().__init__(parent)
        self.fn       = fn
        self.args     = args
        self.kwargs   = kwargs or {}
        self._proc    = None   # multiprocessing.Process filho
        self._t_start = 0.0

    def run(self):
        """Lança o processo filho e faz polling na queue até ele terminar."""
        self._t_start = _time.monotonic()
        # Queue compartilhada: filho → pai (linhas de log + sinal de fim)
        ctx = _mp.get_context("spawn")  # spawn obrigatório: CUDA não suporta fork
                                 # (~15s overhead amortizado sobre todo o dataset)
        queue = ctx.Queue()

        self._proc = ctx.Process(
            target = _child_run,
            args   = (self.fn, self.args, self.kwargs, queue),
            daemon = False,
        )
        self._proc.start()

        # Polling: lê fila até o filho sinalizar término
        success = False
        while True:
            try:
                msg_type, payload = queue.get(timeout=0.1)
            except Exception:
                # Timeout — verifica se o filho ainda está vivo
                if self._proc is not None and not self._proc.is_alive():
                    # Filho morreu sem enviar "done" (ex: killed pelo Stop)
                    break
                continue

            if msg_type == "line":
                self.log_signal.emit(payload)
                self._parse_progress(payload)
            elif msg_type == "done":
                success = payload
                break

        self.finished_signal.emit(success)

    def _parse_progress(self, line: str):
        """Extrai % real do tqdm e calcula ETA."""
        pct = None
        m = self._RE_PCT.search(line)
        if m:
            pct = min(int(m.group(1)), 99)
        else:
            m = self._RE_FRAC.search(line)
            if m:
                cur, total = int(m.group(1)), int(m.group(2))
                if total > 0:
                    pct = min(int(cur / total * 100), 99)

        if pct is not None and 0 <= pct <= 100:
            self.progress_signal.emit(pct)
            elapsed = _time.monotonic() - self._t_start
            if pct > 0:
                remaining = max(0, elapsed / (pct / 100) - elapsed)
                self.eta_signal.emit(_fmt_eta(remaining))
            else:
                self.eta_signal.emit("—")

    def request_stop(self):
        """Para o download terminando apenas o processo filho.
        O CODEEP continua aberto normalmente."""
        proc = self._proc
        if proc is not None and proc.is_alive():
            proc.terminate()          # SIGTERM suave
            proc.join(timeout=3)      # aguarda até 3 s
            if proc.is_alive():
                proc.kill()           # SIGKILL se necessário
            self._proc = None
        # Emite sinal para restaurar os botões da UI
        self.finished_signal.emit(False)


def _fmt_eta(seconds: float) -> str:
    """Formata segundos restantes em string legível."""
    s = int(seconds)
    if s < 60:
        return f"{s}s"
    elif s < 3600:
        return f"{s // 60}m {s % 60:02d}s"
    else:
        h = s // 3600
        m = (s % 3600) // 60
        return f"{h}h {m:02d}m"


class _LineBuffer(io.TextIOBase):
    """Mantido por compatibilidade com etapas que não usam subprocess
    (ex: exploração, avaliação local). Emite cada linha como sinal Qt."""
    def __init__(self, signal, progress_cb=None):
        super().__init__()
        self._signal      = signal
        self._progress_cb = progress_cb
        self._buf         = ""

    def write(self, s: str) -> int:
        self._buf += s
        while "\n" in self._buf:
            line, self._buf = self._buf.split("\n", 1)
            self._signal.emit(line)
            if self._progress_cb:
                self._progress_cb(line)
        return len(s)

    def flush(self):
        if self._buf:
            self._signal.emit(self._buf)
            if self._progress_cb:
                self._progress_cb(self._buf)
            self._buf = ""


# ==========================================================================================================================================
# ═════════════════════════ HELPERS DE UI ══════════════════════════════════
# ==========================================================================================================================================

def _mk_title(text):
    lbl = QLabel(text); lbl.setAlignment(Qt.AlignCenter)
    lbl.setStyleSheet(_SS_LABEL_TITLE); return lbl

def _mk_section(text):
    lbl = QLabel(text); lbl.setStyleSheet(_SS_LABEL_SECTION); return lbl

def _mk_btn(text, style=_SS_BTN_PRIMARY, width=130):
    btn = QPushButton(text); btn.setFixedWidth(width)
    btn.setStyleSheet(style); return btn

def _mk_nav_row(back_cb, next_cb):
    lay = QHBoxLayout()
    for txt, cb, align in [(" << BACK ", back_cb, Qt.AlignLeft),
                            (" NEXT >> ", next_cb, Qt.AlignRight)]:
        b = QPushButton(txt); b.setFixedWidth(200)
        b.setStyleSheet(_SS_BTN_NAV); b.clicked.connect(cb)
        lay.addWidget(b, alignment=align)
    return lay

def _mk_separator():
    sep = QFrame(); sep.setFrameShape(QFrame.HLine)
    sep.setFrameShadow(QFrame.Sunken)
    sep.setStyleSheet("color:#2A4A6B;"); return sep

def _mk_log_box(height=220):
    box = QTextEdit(); box.setReadOnly(True)
    box.setStyleSheet(_SS_LOG); box.setFixedHeight(height); return box

def _invalidate_layout_chain(widget):
    """Força recomputar o tamanho de TODOS os layouts ancestrais de `widget`, subindo até a
    janela — necessário depois de widget.setVisible() dentro de um layout ANINHADO (um QWidget
    com seu próprio QVBoxLayout, que por sua vez é um item de OUTRO QVBoxLayout mais externo,
    ver _mk_collapsible_log_header/_tab_step2). Confirmado empiricamente: QWidget.setVisible()
    invalida corretamente o layout DIRETO do widget escondido (o sizeHint do pai imediato já
    reflete a mudança, ex.: rodapé encolhendo de 278px para 30px), mas essa invalidação NÃO se
    propaga sozinha para o layout do AVÔ — sem isto, o QScrollArea do meio (onde ficam os
    grupos, ver _tab_step2) nunca fica sabendo que sobrou espaço vertical pra ocupar, e quem
    parece "crescer/encolher" ao colapsar o log ou redimensionar a janela é a área ao redor do
    título/rodapé em vez da área dos grupos."""
    w = widget
    while w is not None:
        lay = w.layout()
        if lay is not None:
            lay.invalidate()
        w.updateGeometry()
        w = w.parentWidget()

def _log(box, line):
    box.append(line)
    box.verticalScrollBar().setValue(box.verticalScrollBar().maximum())

def _mk_progress(idioma_getter=None):
    """Cria QProgressBar em modo indeterminado até receber valor real do tqdm.

    idioma_getter: callable() -> "en"/"pt" (ex.: lambda: self._idioma) — função de módulo, sem
    acesso a self, então precisa de um getter para saber o idioma ATUAL tanto na criação quanto
    (via _connect_worker) nas atualizações subsequentes de formato."""
    idioma = idioma_getter() if idioma_getter else i18n.IDIOMA_PADRAO
    p = QProgressBar()
    p.setRange(0, 100); p.setValue(0)
    p.setFormat(f"{i18n.t('progress_label', idioma)}: %p%  —  {i18n.t('progress_eta_label', idioma)}: —")
    p.setFixedHeight(22)
    return p

def _pulse(bar):
    """Incremento suave quando não há informação de progresso real na linha."""
    v = bar.value()
    if v < 30:          # avança livremente até 30%
        bar.setValue(v + 1)
    # acima de 30% só avança se tqdm emitir valor real

class LocaleAwareDoubleSpinBox(QDoubleSpinBox):
    """QDoubleSpinBox que aceita vírgula E ponto como separador decimal.

    O QDoubleSpinBox comum usa o locale do sistema: numa máquina em pt_BR,
    digitar "12.5" é recusado pelo validador — o caractere sequer aparece no
    campo. Como coordenadas de PDB vêm quase sempre com ponto, copiar um
    valor do PyMOL ou de um arquivo exigia converter à mão, e um descuido
    aqui coloca o bolso no lugar errado sem erro nenhum.

    Aqui os dois separadores são SEMPRE aceitos na entrada; o que muda com o
    idioma da interface é apenas o separador exibido — inglês usa ponto,
    português do Brasil usa vírgula (ver set_idioma, chamada também na troca
    de idioma em tempo de execução).

    OmitGroupSeparator é essencial: sem ele, o locale pt_BR usaria o PONTO
    como separador de milhar, colidindo com o ponto que acabamos de aceitar
    como decimal.
    """

    def __init__(self, parent=None, idioma: str = "pt"):
        super().__init__(parent)
        self.set_idioma(idioma)

    def set_idioma(self, idioma: str):
        loc = (QLocale(QLocale.English, QLocale.UnitedStates)
               if str(idioma).lower().startswith("en")
               else QLocale(QLocale.Portuguese, QLocale.Brazil))
        loc.setNumberOptions(QLocale.OmitGroupSeparator)
        valor = self.value()
        self.setLocale(loc)
        self.setValue(valor)      # reexibe com o separador novo

    def _normalizar(self, texto: str) -> str:
        """Troca o separador 'estrangeiro' pelo do locale corrente."""
        sep = self.locale().decimalPoint()
        outro = "." if sep == "," else ","
        return texto.replace(outro, sep)

    def validate(self, texto, pos):
        # Devolve o texto JÁ normalizado: o QAbstractSpinBox usa a string
        # retornada por validate(), entao digitar "." num campo em pt-BR
        # resulta em "," aparecendo no campo, em vez de tecla ignorada.
        return super().validate(self._normalizar(texto), pos)

    def fixup(self, texto):
        return super().fixup(self._normalizar(texto))

    def valueFromText(self, texto):
        return super().valueFromText(self._normalizar(texto))


class TrainingPlotPanel(QWidget):
    """Curvas de treino ao vivo (Etapa 5) — painel EMBUTIDO na aba.

    Era um QDialog separado; virou painel para ficar acima do Execution
    Log, colapsável pelo mesmo cabeçalho (_mk_collapsible_log_header) e
    com stretch, de modo que o espaço liberado ao fechar o log vá para o
    gráfico.

    Le as MESMAS linhas que ja vao para o Execution Log — nao ha canal novo
    entre o processo filho e a interface, nem alteracao no pipeline_train.
    As linhas de validacao seguem o formato de pipeline_train.train._linha:

        Val   -> total=...  recon=...  kl=...  |  atom=...  posNLL=...
                 posMAE=...A  focal=...  exist=...  bond=...  stop=...
                 charge=...  fcharge=...

    Dois eixos y: o esquerdo traz val total e recon (mesma ordem de
    grandeza); o direito, o KL e a metrica escolhida pelo usuario, que
    costumam ficar uma a duas ordens abaixo e, dividindo o eixo com o
    total, virariam linhas achatadas no zero.
    """

    METRICAS = ["atom", "posNLL", "posMAE", "focal", "exist",
                "bond", "stop", "charge", "fcharge"]

    _RE_EPOCH = _re.compile(r"Epoch\s+(\d+)\s*/\s*(\d+)")
    _RE_VAL   = _re.compile(r"Val\s*[^=]*?\u2192\s*(.*)$")
    _RE_KV    = _re.compile(r"([A-Za-z_]+)\s*=\s*(-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?)")

    def __init__(self, idioma_getter, parent=None):
        super().__init__(parent)
        self._idioma_getter = idioma_getter
        self.setMinimumHeight(240)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        self._epoch = 0
        self._dados = {}

        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        topo = QHBoxLayout()
        self.lbl_metric = QLabel(i18n.t("s5_plot_metric", idioma_getter()))
        self.cb_metric = QComboBox()
        self.cb_metric.addItems(self.METRICAS)
        self.cb_metric.setCurrentText("posMAE")
        self.cb_metric.currentIndexChanged.connect(lambda _=None: self._redesenhar())
        topo.addWidget(self.lbl_metric)
        topo.addWidget(self.cb_metric)
        topo.addStretch()
        lay.addLayout(topo)

        from matplotlib.figure import Figure
        from matplotlib.backends.backend_qt5agg import FigureCanvasQTAgg as _Canvas
        self._fig = Figure(figsize=(7.6, 4.6), facecolor="#0D1B2A")
        self._canvas = _Canvas(self._fig)
        self._canvas.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self._canvas.setMinimumHeight(200)
        lay.addWidget(self._canvas, 1)
        self._ax1 = self._fig.add_subplot(111)
        self._ax2 = self._ax1.twinx()
        self._redesenhar()

    # ── Entrada de dados ──────────────────────────────────────────────
    def reset(self):
        """Zera as series — chamado a cada novo Run."""
        self._epoch = 0
        self._dados = {}
        self._redesenhar()

    def feed_line(self, linha: str):
        m = self._RE_EPOCH.search(linha)
        if m:
            self._epoch = int(m.group(1))
            return
        mv = self._RE_VAL.search(linha)
        if not mv:
            return
        vals = {k: float(v) for k, v in self._RE_KV.findall(mv.group(1))}
        if not vals:
            return
        for k, v in vals.items():
            self._dados.setdefault(k, []).append((self._epoch, v))
        self._redesenhar()

    # ── Desenho ───────────────────────────────────────────────────────
    def _redesenhar(self):
        ax1, ax2 = self._ax1, self._ax2
        ax1.clear(); ax2.clear()
        for ax in (ax1, ax2):
            ax.set_facecolor("#0D1B2A")
            ax.tick_params(colors="#C9D1D9", labelsize=8)
            for sp in ax.spines.values():
                sp.set_color("#2A3F5F")

        # ax2 e um twinx: no momento da criacao o matplotlib ja poe os ticks
        # e o rotulo dele a DIREITA, mas .clear() devolve tudo ao padrao
        # (esquerda). Sem reaplicar a cada redesenho, o rotulo do eixo
        # direito era desenhado por cima do eixo vertical esquerdo.
        ax2.yaxis.tick_right()
        ax2.yaxis.set_label_position("right")

        idioma = self._idioma_getter()
        ax1.set_xlabel(i18n.t("s5_plot_xlabel", idioma), color="#C9D1D9", fontsize=9)
        ax1.set_ylabel(i18n.t("s5_plot_ylabel_left", idioma), color="#C9D1D9", fontsize=9)
        # rotation=270 + labelpad afastam o texto dos numeros do eixo direito,
        # que e' onde ele encostava mesmo depois de ir para o lado certo.
        ax2.set_ylabel(i18n.t("s5_plot_ylabel_right", idioma), color="#C9D1D9",
                       fontsize=9, rotation=270, labelpad=14, va="bottom")

        def _serie(nome):
            d = self._dados.get(nome, [])
            return [e for e, _ in d], [v for _, v in d]

        linhas = []
        for nome, cor in (("total", "#58A6FF"), ("recon", "#3FB950")):
            x, y = _serie(nome)
            if x:
                linhas += ax1.plot(x, y, color=cor, lw=1.8, label=f"val {nome}")
        x, y = _serie("kl")
        if x:
            linhas += ax2.plot(x, y, color="#E3B341", lw=1.4, ls="--", label="kl")
        sel = self.cb_metric.currentText()
        x, y = _serie(sel)
        if x:
            linhas += ax2.plot(x, y, color="#F778BA", lw=1.4, ls=":", label=sel)

        if linhas:
            leg = ax1.legend(linhas, [l.get_label() for l in linhas],
                             loc="upper right", fontsize=8,
                             facecolor="#0D1B2A", edgecolor="#2A3F5F")
            for t in leg.get_texts():
                t.set_color("#C9D1D9")
        else:
            ax1.text(0.5, 0.5, i18n.t("s5_plot_waiting", idioma),
                     ha="center", va="center", transform=ax1.transAxes,
                     color="#6E8CA8", fontsize=10)
        # Grade: uma unica camada, na mesma intensidade nos dois sentidos.
        # ax2 herdava grade propria do rcParams apos o clear(), e as linhas
        # horizontais dele somavam-se as de ax1 — duas camadas translucidas
        # sobrepostas resultavam em horizontais visivelmente mais fortes que
        # as verticais.
        ax1.set_axisbelow(True)
        ax1.grid(True, which="major", axis="both",
                 alpha=0.12, color="#2A3F5F", linewidth=0.7)
        ax2.grid(False)

        # Margens fixas em vez de tight_layout: o tight_layout estava dentro
        # de um try/except silencioso e, quando falhava, nao sobrava espaco
        # para o rotulo da direita. Aqui a reserva e' deterministica.
        self._fig.subplots_adjust(left=0.10, right=0.89, top=0.96, bottom=0.13)
        self._canvas.draw_idle()


def _connect_worker(worker, log_box, prog_bar, btn_run, btn_stop, done_cb, idioma_getter=None):
    """Conecta sinais do PipelineWorker aos widgets da aba.

    - log_signal   → appenda linha no log e faz pulse suave
    - progress_signal → atualiza a barra com valor real do tqdm
    - eta_signal   → atualiza o texto da barra com ETA calculado
    - finished_signal → restaura botões e chama done_cb

    idioma_getter: callable() -> "en"/"pt" (ex.: lambda: self._idioma) — reavaliado a cada
    sinal (não capturado uma vez), para refletir o idioma ATUAL mesmo que o usuário troque de
    idioma enquanto um worker está rodando."""
    def _idioma():
        return idioma_getter() if idioma_getter else i18n.IDIOMA_PADRAO

    worker.log_signal.connect(
        lambda l: (_log(log_box, l), _pulse(prog_bar))
    )
    worker.progress_signal.connect(
        lambda pct: prog_bar.setValue(pct)
    )
    worker.eta_signal.connect(
        lambda eta: prog_bar.setFormat(
            f"{i18n.t('progress_label', _idioma())}: %p%  —  "
            f"{i18n.t('progress_eta_label', _idioma())}: {eta}")
    )
    worker.finished_signal.connect(lambda ok: (
        prog_bar.setValue(100),
        prog_bar.setFormat(
            f"{i18n.t('progress_label', _idioma())}: 100%  —  "
            f"{i18n.t('progress_done', _idioma())}"),
        btn_run.setEnabled(True),
        btn_stop.setEnabled(False),
        _log(log_box, i18n.t("log_completed", _idioma()) if ok
             else i18n.t("log_interrupted", _idioma())),
        done_cb(ok),
    ))
    btn_stop.clicked.connect(worker.request_stop)


def _pipeline_collect(dataset, moad_dir, phase1_max,
                      wants_phase1, wants_phase2, wants_phase3,
                      job_dir, org_terms, desc_terms, p3_ids):
    """Função de módulo (pickle-safe) que executa a coleta no processo filho."""
    import MODULES.pipeline_collect as m
    if wants_phase1 and dataset:
        m.collect_external_dataset(
            dataset=dataset, moad_dir=moad_dir, max_entries=phase1_max)
    if wants_phase2:
        m.collect_phase2(
            job_dir=job_dir,
            organism_terms=org_terms or None,
            description_terms=desc_terms or None)
    if wants_phase3:
        m.collect_phase3(
            job_dir=job_dir,
            extra_pdb_ids=p3_ids,
            target_list={})
    m.show_status(job_dir=job_dir)

def _pipeline_check_active_units(ckpt_dir, tensor_dir):
    """Função de módulo (pickle-safe) que roda o diagnóstico "active units"
    (ver MODULES.pipeline_evaluate.compute_active_units) no processo filho —
    carrega o checkpoint, roda o encoder sobre o split de validação e
    reporta quantas dimensões do espaço latente estão realmente ativas.
    Imprime um relatório de texto simples, capturado linha a linha pela
    queue do PipelineWorker (ver _child_run) e reunido pelo chamador
    (MainWindow._run_active_units_check) num QMessageBox."""
    import MODULES.pipeline_evaluate as m
    from pathlib import Path as _P

    result = m.compute_active_units(_P(ckpt_dir), _P(tensor_dir))
    if result is None:
        raise RuntimeError(
            "Não foi possível calcular active units — veja as mensagens "
            "acima (checkpoint/tensor_dir ausentes, split de validação "
            "vazio ou PyTorch indisponível)."
        )

    frac = result["fraction_active"] * 100
    print(f"Checkpoint : {ckpt_dir}")
    print(f"Época salva: {result['ckpt_epoch']}")
    print(f"Split usado: {result['split']}  ({result['n_samples_used']} amostras)")
    print(f"Limiar     : {result['threshold']}")
    print()
    print(f"Active units: {result['n_active']} / {result['n_total']}  ({frac:.1f}%)")
    print()
    if result["fraction_active"] >= 0.5:
        print("✅ Boa utilização do espaço latente — a maioria das dimensões está ativa.")
    elif result["fraction_active"] >= 0.10:
        print("⚠️  Utilização parcial — parte considerável das dimensões pode estar morta.")
    else:
        print("❌ Poucas dimensões ativas — forte indício de colapso PARCIAL de posterior,")
        print("   mesmo que o KL médio agregado (log de treino) não pareça colapsado.")

def _ckpt_pos_frame(ckpt_dir):
    """Lê do checkpoint o referencial em que a cabeça de posições foi treinada.

    Devolve None para checkpoints anteriores à correção do referencial, que
    é o que generate_candidates interpreta como legado (ver a nota lá).
    """
    import torch as _t
    try:
        ck = _t.load(ckpt_dir / "best_model.pt", map_location="cpu",
                     weights_only=False)
        return (ck.get("config") or {}).get("pos_frame")
    except Exception:
        return None


def _pipeline_generate(root, job_dir, pdb, ckpt, n_samples, temperature,
                       cutoff, min_atoms, top_n, out, ligand_ref, site_pdb,
                       site_config_overrides=None, final_ff="mmff_uff",
                       induced_fit=False, site_center=None, site_radius=10.0,
                       heuristic_search=False, pocket_rank=1,
                       stop_threshold=0.5, bond_threshold=0.5):
    """Função de módulo (pickle-safe) que executa a geração no processo filho.

    Definição do sítio, em ordem de precedência:
      site_pdb          → arquivo com os resíduos do bolso;
      heuristic_search  → P2Rank escolhe o bolso (pocket_rank na ordem de
                          score) e devolve o centro;
      site_center       → centro informado pelo usuário;
      nenhum            → detecção pelo ligante co-cristalizado do PDB.
    """
    import MODULES.pipeline_generate as m
    from pathlib import Path as _P
    import numpy as np

    # PROJECT_DIR injetado aqui, no filho, após o re-import do módulo
    m.PROJECT_DIR = _P(root)

    pdb_path = _P(pdb)
    ckpt_dir = _P(ckpt)
    default_base = _P(job_dir) / "results" if job_dir else m.PROJECT_DIR / "results"
    out_dir  = _P(out) if out else default_base / pdb_path.stem
    out_dir.mkdir(parents=True, exist_ok=True)

    site_pdb_path = _P(site_pdb) if site_pdb else None

    # Busca heurística: o P2Rank determina o centro, então ele substitui
    # qualquer site_center que tenha vindo da interface (os dois campos são
    # mutuamente exclusivos na Etapa 7, mas a checagem aqui protege o uso
    # programático). O ranking completo fica gravado ao lado dos resultados,
    # para que a escolha do bolso seja auditável depois.
    if heuristic_search and not site_pdb_path:
        import json as _json
        bolsos = m.detect_pockets_p2rank(pdb_path)
        if pocket_rank < 1 or pocket_rank > len(bolsos):
            raise ValueError(
                f"Bolso #{pocket_rank} indisponível: o P2Rank encontrou "
                f"{len(bolsos)} bolso(s) nesta estrutura.")
        escolhido = bolsos[pocket_rank - 1]
        site_center = escolhido["center"]
        with open(out_dir / "pockets_p2rank.json", "w", encoding="utf-8") as f:
            _json.dump({"selected_rank": escolhido["rank"],
                        "radius_A": site_radius,
                        "pockets": bolsos}, f, indent=2)

    site_center = tuple(site_center) if site_center else None

    # Modelo carregado ANTES do sítio — precisa da voxel_config gravada no
    # checkpoint (ver pipeline_generate.load_model) para resolver com que
    # config REVOXELIZAR esse sítio novo. protonate_site/ph/site_qm_method
    # (site_config_overrides, vindos da Etapa 7 da interface) só valem
    # como FALLBACK — para as chaves ausentes do checkpoint, ou quando ele
    # foi treinado antes desta funcionalidade existir; quando o checkpoint
    # tem um valor gravado, ele sempre vence (ver
    # resolve_site_config_overrides — evita o mismatch treino↔inferência
    # que motivou esses parâmetros existirem como config em primeiro lugar).
    model, mod, ckpt_voxel_config = m.load_model(
        ckpt_dir,
        project_dir=_P(root))           # ver Problema 3

    (site_tensor, origin, voxel_size, site_coords, site_elements,
     site_mol, site_is_backbone) = m.pdb_to_site_tensor(
        pdb_path, cutoff, min_atoms, site_pdb=site_pdb_path,
        project_dir=_P(root),           # ver Problema 3
        config_overrides=m.resolve_site_config_overrides(
            ckpt_voxel_config, site_config_overrides),
        site_center=site_center, site_radius_A=site_radius)
    np.savez_compressed(
        out_dir / "site_tensor.npz",
        tensor=site_tensor, origin=origin,
        voxel_size=np.array([voxel_size]))

    ref_mol = None
    if ligand_ref:
        ref_mol, ligand_ref_sdf = m.load_reference_ligand(_P(ligand_ref), out_dir)
        if ref_mol is None:
            raise RuntimeError("Não foi possível ler o ligante de referência selecionado.")

    candidates = m.generate_candidates(
        model, mod, site_tensor,
        tensor_dir=_P(root) / "data" / "tensors",
        n_samples=n_samples, temperature=temperature,
        stop_threshold=stop_threshold, bond_threshold=bond_threshold,
        voxel_size=voxel_size,
        ref_mol=ref_mol,               # ← voxel_size retornado por pdb_to_site_tensor
        site_coords=site_coords, site_elements=site_elements,
        site_mol=site_mol, site_is_backbone=site_is_backbone,
        final_ff=final_ff, induced_fit=induced_fit,
        # Referencial das posições: o modelo prediz relativo à origem da
        # grade, que precisa ser somada de volta (ver generate_candidates).
        origin=origin,
        pos_frame=_ckpt_pos_frame(ckpt_dir))
    if not candidates:
        raise RuntimeError("Nenhum candidato válido gerado.")

    df = m.rank_candidates(candidates, ref_mol=ref_mol)
    df.drop(columns=["_mol"], errors="ignore").to_csv(out_dir / "candidates.csv")
    m.save_sdf(df, out_dir / f"top{top_n}_candidates.sdf", top_n)
    m.save_grid_image(df, out_dir / f"top{top_n}_candidates.png", top_n)
    m.save_html_report(
        df, out_dir / "report.html",
        pdb_name=pdb_path.name, top_n=top_n,
        n_generated=n_samples, generation_time=0, ckpt_info={})
    print(f"\n✅ {len(df)} valid candidates saved to: {out_dir}")
    
# ==========================================================================================================================================
# ══════════════════════ JANELA PRINCIPAL ══════════════════════════════════
# ==========================================================================================================================================
class MainWindow(QMainWindow):

    def __init__(self):
        super().__init__()
        # Idioma da interface (PT-BR/EN, ver MODULES/i18n.py): lido de QSettings para persistir
        # entre sessões, mesmo padrão de bandeiras BR/UK do CODRUG/AgendaLab (i18n.py + widget de
        # bandeiras ao lado do CPU/GPU Monitor). self._i18n_registry guarda (chave, apply_fn,
        # kwargs) para cada texto já traduzido, permitindo reaplicar tudo numa troca de idioma
        # sem precisar reconstruir nenhum widget.
        self._idioma = QSettings("CODEEP", "CODEEP").value("idioma", i18n.IDIOMA_PADRAO)
        if self._idioma not in ("en", "pt"):
            self._idioma = i18n.IDIOMA_PADRAO
        self._i18n_registry = []

        self._tr("app_titulo", self.setWindowTitle)
        self.setStyleSheet(_SS_MAIN)
        sc = QGuiApplication.primaryScreen().availableGeometry()
        self.resize(int(sc.width()*0.50), int(sc.height()*0.50))
        self._center_on_screen()

        self.dp_dir: str = str(Path(__file__).parent)
        self.job_dir: str = ""
        self._workers: dict = {}          # tag → worker ativo
        self._applying_job_state = False
        self._terminal_viewer_proc = None

        self._build_menu()
        self._build_hw_monitor()
        self.tabs = QTabWidget()
        self.setCentralWidget(self.tabs)
        self._build_tabs()
        self._init_tab_state_specs()
        self._connect_state_autosave()
        self._refresh_previous_jobs()
        QTimer.singleShot(0, self._center_on_screen)

    def _tr(self, chave, apply_fn, **kwargs):
        """Registra apply_fn (ex.: label.setText, btn.setToolTip, lambda txt:
        self.tabs.setTabText(0, txt)) para ser reexecutado sempre que o idioma da interface
        mudar, e já aplica o texto do idioma atual imediatamente. chave/kwargs são repassados
        para i18n.t() a cada reaplicação, então strings com placeholders dinâmicos (ex.:
        contagens, caminhos) continuam corretas após trocar de idioma."""
        self._i18n_registry.append((chave, apply_fn, kwargs))
        apply_fn(i18n.t(chave, self._idioma, **kwargs))

    def _trL(self, chave, **kwargs):
        """Cria um QLabel já registrado em i18n (ver _tr) — atalho para os muitos labels
        estáticos espalhados pelos formulários das abas Step 1-8."""
        lbl = QLabel()
        self._tr(chave, lbl.setText, **kwargs)
        return lbl

    def _mk_title_tr(self, chave):
        lbl = QLabel(); lbl.setAlignment(Qt.AlignCenter)
        lbl.setStyleSheet(_SS_LABEL_TITLE)
        self._tr(chave, lbl.setText)
        return lbl

    def _mk_section_tr(self, chave):
        lbl = QLabel(); lbl.setStyleSheet(_SS_LABEL_SECTION)
        self._tr(chave, lbl.setText)
        return lbl

    def _mk_collapsible_log_header(self, log_box, chave="sec_execution_log", start_expanded=True):
        """Cabeçalho clicável (▼/▶ + título) que expande/colapsa log_box — usado em toda aba ou
        grupo com "Execution Log" (ver _build_pipeline_tab/_build_pipeline_group). Só o texto do
        log colapsa; barra de progresso e botões Run/Stop continuam sempre visíveis, fora dessa
        seção, para que o progresso continue acompanhável mesmo com o log fechado."""
        btn = QPushButton()
        btn.setCheckable(True)
        btn.setChecked(start_expanded)
        btn.setCursor(Qt.PointingHandCursor)
        btn.setStyleSheet(
            "QPushButton{background:transparent;border:none;text-align:left;"
            "font-size:11pt;font-weight:bold;color:#C9D1D9;padding:2px 0;}"
            "QPushButton:hover{color:#2ECC71;}"
        )
        log_box.setVisible(start_expanded)

        def _apply(_txt=None):
            arrow = "▼" if btn.isChecked() else "▶"
            btn.setText(f"{arrow}  {i18n.t(chave, self._idioma)}")

        self._tr(chave, _apply)

        def _on_toggled(checked):
            log_box.setVisible(checked)
            _apply()
            # Sem isto, o espaço liberado/ocupado ao colapsar/expandir não chega até o
            # QScrollArea do meio (ver _invalidate_layout_chain) — ele fica alocado num
            # widget errado (ex.: a área ao redor do título, no caso da Etapa 2).
            _invalidate_layout_chain(log_box.parentWidget())

        btn.toggled.connect(_on_toggled)
        return btn

    def _mk_btn_tr(self, chave, style=_SS_BTN_PRIMARY, width=130, **kwargs):
        btn = QPushButton(); btn.setFixedWidth(width); btn.setStyleSheet(style)
        self._tr(chave, btn.setText, **kwargs)
        return btn

    def _mk_combo_tr(self, item_keys):
        """QComboBox cujos itens são traduzidos e reaplicados numa troca de idioma (ver _tr) —
        usa setItemText em vez de clear()+addItems() para preservar currentIndex(). Chamadores
        que precisam do VALOR (não do texto exibido) de cada item devem indexar por
        currentIndex() contra sua própria lista paralela de valores internos (mesmo padrão já
        usado por _SITE_QM_METHOD_VALUES/_FINAL_FF_VALUES) — nunca por currentText(), que muda
        com o idioma."""
        combo = QComboBox()
        combo.addItems([""] * len(item_keys))
        for i, chave in enumerate(item_keys):
            self._tr(chave, lambda txt, c=combo, idx=i: c.setItemText(idx, txt))
        return combo

    def _mk_nav_row_tr(self, back_cb, next_cb):
        lay = QHBoxLayout()
        for chave, cb, align in [("nav_back", back_cb, Qt.AlignLeft),
                                  ("nav_next", next_cb, Qt.AlignRight)]:
            b = QPushButton(); b.setFixedWidth(200); b.setStyleSheet(_SS_BTN_NAV)
            self._tr(chave, b.setText)
            b.clicked.connect(cb)
            lay.addWidget(b, alignment=align)
        return lay

    @staticmethod
    def _wrap_scroll_widget(content_widget):
        """Mantém o conteúdo real ancorado no topo do QScrollArea.

        Quando o viewport fica mais alto do que o conteúdo, o espaço extra deve
        aparecer depois do último grupo/campo, e não ser redistribuído dentro do
        próprio conteúdo.
        """
        wrapper = QWidget()
        wl = QVBoxLayout(wrapper)
        wl.setContentsMargins(0, 0, 0, 0)
        wl.setSpacing(0)
        wl.addWidget(content_widget)
        wl.addStretch(1)
        return wrapper

    def _definir_idioma(self, idioma):
        if idioma == self._idioma:
            return
        self._idioma = idioma
        QSettings("CODEEP", "CODEEP").setValue("idioma", idioma)
        # Separador decimal de TODOS os campos numericos de uma vez: varre a
        # arvore de widgets em vez de exigir um registro por campo (eram ~20,
        # espalhados por quatro abas — um esquecido passaria despercebido ate
        # alguem digitar um ponto no idioma errado).
        for _sp in self.findChildren(LocaleAwareDoubleSpinBox):
            _sp.set_idioma(self._idioma)

        for chave, apply_fn, kwargs in self._i18n_registry:
            apply_fn(i18n.t(chave, self._idioma, **kwargs))
            # A tradução para PT costuma ser mais longa que o texto original em EN — botões com
            # largura fixa foram dimensionados uma única vez na construção da interface, para o
            # texto do idioma inicial. Sem isso, o texto do idioma mais longo ficaria cortado.
            # _ensure_button_text_fits só AUMENTA a largura quando necessário (nunca reduz), então
            # o layout permanece estável ao alternar os idiomas.
            target = getattr(apply_fn, "__self__", None)
            if isinstance(target, QPushButton):
                self._ensure_button_text_fits(target)

    @staticmethod
    def _ensure_button_text_fits(button):
        text = button.text() or ""
        if not text.strip():
            return
        button.ensurePolished()
        required_width = button.sizeHint().width() + 8
        if button.icon() and not button.icon().isNull():
            required_width += button.iconSize().width()

        current_min = button.minimumWidth()
        current_max = button.maximumWidth()
        has_fixed_width = current_min > 0 and current_min == current_max

        if has_fixed_width:
            if current_min < required_width:
                button.setFixedWidth(required_width)
            return

        if current_min < required_width:
            button.setMinimumWidth(required_width)

    def _center_on_screen(self):
        screen = self.screen() or QGuiApplication.primaryScreen()
        if screen is None:
            return
        available = screen.availableGeometry()
        frame = self.frameGeometry()
        frame.moveCenter(available.center())
        self.move(frame.topLeft())

    # ── Fechamento da janela ───────────────────────────────────────────────
    def closeEvent(self, event):
        """Trata o fechamento da janela com pipeline em execução.

        Sem isto o fechamento era ambíguo nos dois sentidos. A janela era
        destruída mas o processo filho continuava: um treinamento de dois
        dias seguia consumindo a GPU sem nenhuma interface para acompanhá-lo
        ou interrompê-lo, e sem forma de reexibir a janela. Ao mesmo tempo,
        quem fechasse esperando cancelar não cancelava nada.

        As três saídas ficam explícitas. Em segundo plano, o encerramento
        automático do processo é religado ao fim do último worker, para que
        o programa não fique residente para sempre depois que o trabalho
        terminar.
        """
        ativos = [k for k, w in self._workers.items()
                  if w is not None and w.isRunning()]
        if not ativos:
            event.accept()
            return

        nomes = ", ".join(i18n.t(f"worker_{k}", self._idioma) for k in ativos)
        box = QMessageBox(self)
        box.setIcon(QMessageBox.Warning)
        box.setWindowTitle(i18n.t("close_title", self._idioma))
        box.setText(i18n.t("close_text", self._idioma, etapas=nomes))
        box.setInformativeText(i18n.t("close_info", self._idioma))
        b_bg     = box.addButton(i18n.t("close_btn_background", self._idioma),
                                 QMessageBox.AcceptRole)
        b_stop   = box.addButton(i18n.t("close_btn_stop", self._idioma),
                                 QMessageBox.DestructiveRole)
        b_cancel = box.addButton(i18n.t("close_btn_cancel", self._idioma),
                                 QMessageBox.RejectRole)
        box.setDefaultButton(b_cancel)
        box.exec_()
        clicado = box.clickedButton()

        if clicado is b_cancel:
            event.ignore()
            return

        if clicado is b_stop:
            for k in ativos:
                try:
                    self._workers[k].request_stop()
                except Exception as exc:
                    log.warning(f"Falha ao interromper '{k}': {exc}")
            event.accept()
            return

        # Segundo plano: a janela fecha, o filho continua. O processo só
        # encerra quando o último worker terminar (ver _quit_se_ocioso) —
        # do contrário ficaria residente indefinidamente.
        app = QApplication.instance()
        if app is not None:
            app.setQuitOnLastWindowClosed(False)
        for k in ativos:
            try:
                self._workers[k].finished.connect(self._quit_se_ocioso)
            except Exception:
                pass
        log.info("Janela fechada; pipeline segue em segundo plano. "
                 "Acompanhe pelo arquivo de log da etapa.")
        event.accept()

    def _quit_se_ocioso(self):
        """Encerra o programa quando nenhum worker estiver mais rodando."""
        if any(w is not None and w.isRunning() for w in self._workers.values()):
            return
        app = QApplication.instance()
        if app is not None:
            log.info("Pipeline concluído em segundo plano; encerrando o CODEEP.")
            app.quit()

    def _init_tab_state_specs(self):
        # Nomes dos hiperparâmetros da Etapa 4 (Optuna) — vêm da mesma fonte que
        # constrói os widgets (ver _tab_step4), para não haver duas listas
        # para manter em sincronia.
        _opt_param_names = sorted(getattr(self, "_opt_param_widgets", {}))

        self._tab_state_specs = {
            "step1": [
                "ed_root", "rb_job_new", "rb_job_load", "cb_prev_job",
                "ed_job_name", "dt_job_stamp", "te_org_terms",
                "te_desc_terms", "te_phase3_ids",
            ],
            # Step 2 — "Data Management": três grupos com Run/Stop e persistência
            # PRÓPRIOS (não mais "stepN" para curadoria/exploração, já que não são mais
            # abas — ver _tab_step2/_grp_data_collection/_grp_data_curation/
            # _grp_data_exploration). "step2" continua com esse nome (só a Collection,
            # que não mudou de posição); Curation/Exploration ganham chaves descritivas
            # próprias — ver _migrate_tab_state_files_v2 para a migração dos arquivos
            # antigos (stepN.json de antes desta fusão).
            "step2": [
                "cb_dataset", "cb_phase", "sp_phase1_max", "ed_moad_dir", "chk_status",
            ],
            "step2cur": [
                "sp_cur_workers", "sp_cutoff", "sp_min_site", "sp_max_mw",
                "sp_min_heavy", "cb_cur_phase", "chk_cur_thread", "chk_cur_process",
            ],
            "step2exp": ["cb_explore_phase"],
            "step3": [
                "ed_vox_pair", "sp_vox_workers", "chk_vox_parallel_pairs", "sp_grid",
                "sp_vox_pad", "sp_max_qm",
                "sp_vox_batch", "cb_qm_basis", "chk_ecfp4", "cb_vox_phase",
                "chk_protonate_site", "dsb_site_ph", "cb_site_qm_method",
            ],
            # Etapa 4 (Optuna): os controles do espaço de busca são gerados a partir de
            # pipeline_optimize.SEARCH_SPACE_SPEC, então a lista de atributos
            # também é derivada dele — acrescentar um hiperparâmetro lá passa
            # a ser salvo/restaurado aqui sem edição manual.
            "step4": [
                "cb_opt_sampler",
                "cb_opt_phase", "sp_opt_trials", "sp_opt_epochs", "dsb_opt_subset",
                "sp_opt_seed", "sp_opt_min_resource", "sp_opt_reduction",
                "cb_opt_device", "ed_opt_study", "ed_opt_resume",
                "chk_opt_freeze_enc", "chk_opt_keep_ckpts", "ed_opt_out",
            ] + [
                f"{prefix}_opt_{name}"
                for name in _opt_param_names
                for prefix in ("chk", "ed")
            ] + [
                # cb_opt_objective vem POR ÚLTIMO de propósito: restaurar os
                # checkboxes de beta dispara _opt_update_objective_state, que
                # força o objetivo de volta para val_recon enquanto algum beta
                # ainda estiver marcado. Aplicado antes deles, o val_total
                # salvo pelo usuário era desfeito no meio da restauração.
                "cb_opt_objective",
            ],
            "step5": [
                "cb_train_phase", "sp_epochs", "sp_batch", "sp_latent", "sp_hidden",
                "sp_gnn_layers", "dsb_lr", "dsb_beta", "sp_warmup",
                "dsb_pos_weight", "dsb_stop_weight", "dsb_focal_weight", "dsb_dropout",
                "dsb_weight_decay", "dsb_grad_clip",
                "sp_patience", "cb_train_device", "ed_resume", "chk_freeze_enc",
                "ed_ckpt_out",
            ],
            "step6": ["ed_eval_ckpt", "chk_do_generate", "cb_eval_phase"],
            "step7": [
                "cb_gen_phase", "ed_gen_pdb", "ed_gen_site_pdb", "ed_gen_ckpt",
                "ed_gen_out", "ed_ligand_ref", "sp_n_samples", "dsb_temp",
                "dsb_stop_thr", "dsb_bond_thr",
                "sp_cutoff_gen", "sp_top_n", "sp_min_atoms_gen", "chk_gen_protonate_site",
                "dsb_gen_ph", "cb_gen_site_qm_method", "cb_gen_qm_basis", "cb_final_ff",
                "chk_induced_fit", "chk_use_site_center", "dsb_site_x", "dsb_site_y",
                "dsb_site_z", "dsb_site_radius", "chk_heuristic_search", "sp_pocket_rank",
            ],
        }

    def _connect_state_autosave(self):
        for step_key, attrs in self._tab_state_specs.items():
            for attr in attrs:
                widget = getattr(self, attr, None)
                if widget is None:
                    continue
                if isinstance(widget, QLineEdit):
                    widget.textChanged.connect(lambda _=None, key=step_key: self._save_tab_state(key))
                elif isinstance(widget, QTextEdit):
                    widget.textChanged.connect(lambda key=step_key: self._save_tab_state(key))
                elif isinstance(widget, QComboBox):
                    widget.currentIndexChanged.connect(lambda _=None, key=step_key: self._save_tab_state(key))
                elif isinstance(widget, (QCheckBox, QRadioButton)):
                    widget.toggled.connect(lambda _=None, key=step_key: self._save_tab_state(key))
                elif isinstance(widget, (QSpinBox, QDoubleSpinBox)):
                    widget.valueChanged.connect(lambda _=None, key=step_key: self._save_tab_state(key))
                elif isinstance(widget, QDateTimeEdit):
                    widget.dateTimeChanged.connect(lambda _=None, key=step_key: self._save_tab_state(key))

    def _tab_state_path(self, step_key: str, job_dir: Optional[str] = None) -> Optional[str]:
        base_dir = job_dir or self.job_dir
        if not base_dir:
            return None
        return os.path.join(base_dir, f"{step_key}.json")

    def _widget_state_value(self, widget):
        if isinstance(widget, QComboBox):
            return {"index": widget.currentIndex(), "text": widget.currentText()}
        if isinstance(widget, (QCheckBox, QRadioButton)):
            return widget.isChecked()
        if isinstance(widget, QDateTimeEdit):
            return widget.dateTime().toString("yyyy-MM-ddTHH:mm:ss")
        if isinstance(widget, QDoubleSpinBox):
            return widget.value()
        if isinstance(widget, QSpinBox):
            return widget.value()
        if isinstance(widget, QTextEdit):
            return widget.toPlainText()
        if isinstance(widget, (QLineEdit, QLabel)):
            return widget.text()
        return None

    def _widget_set_state_value(self, widget, value):
        if widget is None or value is None:
            return
        try:
            if isinstance(widget, QComboBox):
                if isinstance(value, dict):
                    idx = value.get("index")
                    text = value.get("text", "")
                else:
                    idx = None
                    text = str(value)
                if isinstance(idx, int) and 0 <= idx < widget.count():
                    widget.setCurrentIndex(idx)
                else:
                    found = widget.findText(text)
                    if found >= 0:
                        widget.setCurrentIndex(found)
                    elif widget.isEditable():
                        widget.setEditText(text)
            elif isinstance(widget, (QCheckBox, QRadioButton)):
                widget.setChecked(bool(value))
            elif isinstance(widget, QDateTimeEdit):
                dt = QDateTime.fromString(str(value), "yyyy-MM-ddTHH:mm:ss")
                if dt.isValid():
                    widget.setDateTime(dt)
            elif isinstance(widget, QDoubleSpinBox):
                widget.setValue(float(value))
            elif isinstance(widget, QSpinBox):
                widget.setValue(int(value))
            elif isinstance(widget, QTextEdit):
                widget.setPlainText(str(value))
            elif isinstance(widget, (QLineEdit, QLabel)):
                widget.setText(str(value))
        except (TypeError, ValueError):
            pass

    def _collect_tab_state(self, step_key: str) -> dict:
        state = {}
        for attr in self._tab_state_specs.get(step_key, []):
            widget = getattr(self, attr, None)
            value = self._widget_state_value(widget)
            if value is not None:
                state[attr] = value

        if step_key == "step1":
            state["job_id"] = self.lbl_job_id.text().strip()
            state["job_dir"] = self.job_dir
            state["root_dir"] = self.ed_root.text().strip()

        return state

    def _apply_tab_state(self, step_key: str, state: dict):
        if not isinstance(state, dict) or not state:
            return

        if step_key == "step1":
            root_value = state.get("ed_root") or state.get("root_dir")
            if root_value:
                self._widget_set_state_value(getattr(self, "ed_root", None), root_value)
            selected_job = None
            prev_job_state = state.get("cb_prev_job")
            if isinstance(prev_job_state, dict):
                selected_job = prev_job_state.get("text", "")
            elif prev_job_state:
                selected_job = str(prev_job_state)
            self._refresh_previous_jobs(selected_job=selected_job or state.get("job_id", ""))

        for attr in self._tab_state_specs.get(step_key, []):
            if attr not in state:
                continue
            self._widget_set_state_value(getattr(self, attr, None), state[attr])

        if step_key == "step1":
            self._sync_step1_job_mode()
            self._update_job_id()
            self._refresh_paths()

    def _legacy_step1_state(self, job_dir: Optional[str]) -> dict:
        if not job_dir:
            return {}
        cfg_path = os.path.join(job_dir, "job_config.json")
        if not os.path.isfile(cfg_path):
            return {}
        try:
            with open(cfg_path, "r", encoding="utf-8") as f:
                payload = json.load(f)
        except (OSError, json.JSONDecodeError):
            return {}

        job_id = payload.get("job_id") or os.path.basename(os.path.normpath(job_dir))
        state = {
            "ed_root": payload.get("root_dir", self.ed_root.text().strip()),
            "ed_job_name": payload.get("job_name", ""),
            "te_org_terms": "\n".join(payload.get("organism_terms", [])),
            "te_desc_terms": "\n".join(payload.get("desc_terms", [])),
            "te_phase3_ids": "\n".join(payload.get("phase3_pdb_ids", [])),
            "rb_job_load": True,
            "rb_job_new": False,
            "cb_prev_job": {"text": job_id},
            "job_id": job_id,
            "job_dir": payload.get("job_dir", job_dir),
            "root_dir": payload.get("root_dir", self.ed_root.text().strip()),
        }
        stamp_text = str(job_id)[:16]
        dt = QDateTime.fromString(stamp_text, "yyyy-MM-dd_HH-mm")
        if dt.isValid():
            state["dt_job_stamp"] = dt.toString("yyyy-MM-ddTHH:mm:ss")
        return state

    def _read_tab_state(self, step_key: str, job_dir: Optional[str] = None) -> dict:
        path = self._tab_state_path(step_key, job_dir)
        if path and os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    payload = json.load(f)
            except (OSError, json.JSONDecodeError):
                payload = {}
            if isinstance(payload, dict):
                state = payload.get("state")
                if isinstance(state, dict):
                    return state
                return payload

        if step_key == "step1":
            return self._legacy_step1_state(job_dir)
        return {}

    def _save_tab_state(self, step_key: str):
        if self._applying_job_state:
            return
        path = self._tab_state_path(step_key)
        if not path:
            return
        payload = {
            "step": step_key,
            "job_id": os.path.basename(self.job_dir) if self.job_dir else self.lbl_job_id.text().strip(),
            "job_dir": self.job_dir,
            "saved_at": datetime.now().isoformat(),
            "state": self._collect_tab_state(step_key),
        }
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="utf-8") as f:
                json.dump(payload, f, indent=2, ensure_ascii=False)
        except OSError:
            pass

    def _save_all_tab_states(self):
        for step_key in self._tab_state_specs:
            self._save_tab_state(step_key)

    @staticmethod
    def _migrate_tab_state_files(job_dir: str):
        """Renomeia stepN.json de jobs criados antes da Etapa 6 existir.

        A inserção da otimização de hiperparâmetros empurrou treino/avaliação/
        geração de 6/7/8 para 7/8/9. Sem esta migração, um job antigo abriria
        essas três abas com os defaults de fábrica — as configurações não se
        perderiam (os arquivos continuariam lá), mas sumiriam da interface,
        o que o usuário leria como perda de dados.

        Renomeia do maior para o menor para não sobrescrever nada, e só
        quando o destino ainda não existe (jobs já migrados ficam intactos).
        """
        for n in (8, 7, 6):
            src = os.path.join(job_dir, f"step{n}.json")
            dst = os.path.join(job_dir, f"step{n + 1}.json")
            if os.path.isfile(src) and not os.path.exists(dst):
                try:
                    os.rename(src, dst)
                    log.info(f"Job migrado: step{n}.json → step{n + 1}.json")
                except OSError:
                    pass

    @staticmethod
    def _migrate_tab_state_files_v2(job_dir: str):
        """Adequa stepN.json de jobs criados antes da fusão das Steps 2/3/4
        (Collection/Curation/Exploration) em "Data Management" e do reposicionamento
        das etapas seguintes (Voxelization/Optuna/Training/Evaluation/Generation:
        5/6/7/8/9 → 3/4/5/6/7).

        Roda DEPOIS de _migrate_tab_state_files (que já lida com a inserção anterior
        do Optuna) — assume como entrada de partida o esquema pós-Optuna, pré-fusão:
        2=Collection, 3=Curation, 4=Exploration, 5=Voxelization, 6=Optuna,
        7=Training, 8=Evaluation, 9=Generation (ver _init_tab_state_specs para o
        esquema atual). Sem esta migração, um job antigo abriria essas abas com os
        defaults de fábrica — as configurações não se perderiam (os arquivos
        continuariam lá), mas sumiriam da interface, o que o usuário leria como
        perda de dados.
        """
        # Curation/Exploration não são mais "stepN" (não são mais abas — viraram
        # grupos dentro da Step 2, com chave própria — ver _init_tab_state_specs).
        for src_n, dst_key in ((3, "step2cur"), (4, "step2exp")):
            src = os.path.join(job_dir, f"step{src_n}.json")
            dst = os.path.join(job_dir, f"{dst_key}.json")
            if os.path.isfile(src) and not os.path.exists(dst):
                try:
                    os.rename(src, dst)
                    log.info(f"Job migrado: step{src_n}.json → {dst_key}.json")
                except OSError:
                    pass

        # Voxelization/Optuna/Training/Evaluation/Generation: 5/6/7/8/9 -> 3/4/5/6/7
        # (do maior pro menor, pra não sobrescrever nada no caminho).
        for n in (9, 8, 7, 6, 5):
            src = os.path.join(job_dir, f"step{n}.json")
            dst = os.path.join(job_dir, f"step{n - 2}.json")
            if os.path.isfile(src) and not os.path.exists(dst):
                try:
                    os.rename(src, dst)
                    log.info(f"Job migrado: step{n}.json → step{n - 2}.json")
                except OSError:
                    pass

    def _load_job_state_into_ui(self, job_dir: str):
        self._migrate_tab_state_files(job_dir)
        self._migrate_tab_state_files_v2(job_dir)
        self._applying_job_state = True
        try:
            for step_key in self._tab_state_specs:
                self._apply_tab_state(step_key, self._read_tab_state(step_key, job_dir))
        finally:
            self._applying_job_state = False

    def _refresh_previous_jobs(self, selected_job: str = ""):
        combo = getattr(self, "cb_prev_job", None)
        root_edit = getattr(self, "ed_root", None)
        if combo is None or root_edit is None:
            return

        root = root_edit.text().strip() or self.dp_dir
        jobs_dir = os.path.join(root, "JOBS")
        jobs = []
        if os.path.isdir(jobs_dir):
            jobs = sorted(
                [name for name in os.listdir(jobs_dir) if os.path.isdir(os.path.join(jobs_dir, name))],
                reverse=True,
            )

        current = selected_job or combo.currentText().strip()
        combo.blockSignals(True)
        combo.clear()
        combo.addItems(jobs)
        if current:
            idx = combo.findText(current)
            if idx >= 0:
                combo.setCurrentIndex(idx)
        combo.blockSignals(False)

    def _sync_step1_job_mode_checks(self):
        sender = self.sender()

        if sender is self.rb_job_new and self.rb_job_new.isChecked():
            self.rb_job_load.blockSignals(True)
            self.rb_job_load.setChecked(False)
            self.rb_job_load.blockSignals(False)
        elif sender is self.rb_job_load and self.rb_job_load.isChecked():
            self.rb_job_new.blockSignals(True)
            self.rb_job_new.setChecked(False)
            self.rb_job_new.blockSignals(False)

        if not self.rb_job_new.isChecked() and not self.rb_job_load.isChecked():
            self.rb_job_new.blockSignals(True)
            self.rb_job_new.setChecked(True)
            self.rb_job_new.blockSignals(False)

    def _apply_step1_job_mode_styles(self):
        for widget in (
            getattr(self, "ed_job_name", None),
            getattr(self, "dt_job_stamp", None),
            getattr(self, "cb_prev_job", None),
        ):
            if widget is None:
                continue
            widget.setStyleSheet("" if widget.isEnabled() else _SS_STEP1_JOB_FIELD_DISABLED)

    def _sync_step1_job_mode(self):
        is_load = getattr(self, "rb_job_load", None) is not None and self.rb_job_load.isChecked()
        if hasattr(self, "ed_job_name"):
            self.ed_job_name.setEnabled(not is_load)
        if hasattr(self, "dt_job_stamp"):
            self.dt_job_stamp.setEnabled(not is_load)
            if not is_load:
                self.dt_job_stamp.setDateTime(QDateTime.currentDateTime())
        if hasattr(self, "cb_prev_job"):
            self.cb_prev_job.setEnabled(is_load)
            if is_load:
                self._refresh_previous_jobs()
        self._apply_step1_job_mode_styles()
        self._update_job_id()

    @staticmethod
    def _datetime_from_job_id(job_id: str) -> Optional[QDateTime]:
        job_id = (job_id or "").strip()
        if len(job_id) < 16:
            return None
        dt = QDateTime.fromString(job_id[:16], "yyyy-MM-dd_HH-mm")
        return dt if dt.isValid() else None

    def _load_project(self, job_dir: str):
        if not os.path.isdir(job_dir):
            QMessageBox.warning(
                self, i18n.t("msg_warning_title", self._idioma),
                i18n.t("s1_msg_job_not_found", self._idioma, job_dir=job_dir),
            )
            return

        self.job_dir = job_dir
        self._load_job_state_into_ui(job_dir)
        self._sync_step1_job_mode()
        self.lbl_job_id.setText(os.path.basename(os.path.normpath(job_dir)))
        self._refresh_previous_jobs(selected_job=self.lbl_job_id.text().strip())
        self.lbl_job_status.setText(i18n.t("s1_msg_job_loaded", self._idioma, job_dir=job_dir))
        root = self.ed_root.text().strip() or self.dp_dir
        self._refresh_paths()
        self._inject_root(root, job_dir)
        self._save_all_tab_states()

    # ── Menu ──────────────────────────────────────────────────────────────
    def _build_menu(self):
        mb = self.menuBar()
        menu = mb.addMenu("")
        self._tr("menu_title", menu.setTitle)
        # Itens de menu sem ícones — chaves i18n na ordem das abas
        menu_keys = [
            "menu_home",  "menu_step1",
            "menu_step2", "menu_step3",
            "menu_step4", "menu_step5",
            "menu_step6", "menu_step7",
        ]
        for i, chave in enumerate(menu_keys):
            act = QAction(self)
            self._tr(chave, act.setText)
            act.triggered.connect(lambda _, idx=i: self.tabs.setCurrentIndex(idx))
            menu.addAction(act)
        menu.addSeparator()
        act_exit = QAction(self)
        self._tr("menu_exit", act_exit.setText)
        act_exit.triggered.connect(lambda: self.close())
        menu.addAction(act_exit)

        help_menu = mb.addMenu("")
        self._tr("menu_help", help_menu.setTitle)
        act_req = QAction(self)
        self._tr("menu_install_requirements", act_req.setText)
        act_req.triggered.connect(self._show_requirements)
        help_menu.addAction(act_req)
        act_report = QAction(self)
        self._tr("menu_final_report", act_report.setText)
        act_report.triggered.connect(self._generate_final_report)
        help_menu.addAction(act_report)
        help_menu.addSeparator()
        act_about = QAction(self)
        self._tr("menu_about", act_about.setText)
        act_about.triggered.connect(self._show_about)
        help_menu.addAction(act_about)

    # ── Monitor CPU + GPU ─────────────────────────────────────────────────
    def _build_hw_monitor(self):
        self._mon_widget = QWidget()
        self._mon_widget.setStyleSheet("background:transparent;")
        lay = QHBoxLayout(self._mon_widget)
        lay.setContentsMargins(0,0,4,0); lay.setSpacing(6)

        # Bandeiras BR/UK de seleção de idioma (mesmo padrão do CODRUG/AgendaLab,
        # MODULES/i18n.py) — ao lado do CPU/GPU Monitor, no canto superior direito da janela
        # principal. Usa ícones SVG próprios (ICONS/flag_br.svg, ICONS/flag_gb.svg) em vez de
        # emoji de bandeira: em muitos ambientes Linux/Qt o emoji de bandeira (par de "Regional
        # Indicator Symbols") não tem glifo colorido combinado disponível na fonte do sistema e
        # cai no fallback textual (as duas letras do código do país), em vez de desenhar a
        # bandeira.
        flag_style = (
            "QPushButton{border:none;background:transparent;padding:0;}"
            "QPushButton:hover{background:#16283B;border-radius:4px;}"
        )
        flag_icon_size = QSize(24, 16)

        self.btn_bandeira_pt = QPushButton()
        self.btn_bandeira_pt.setIcon(QIcon(os.path.join(self.dp_dir, "ICONS", "flag_br.svg")))
        self.btn_bandeira_pt.setIconSize(flag_icon_size)
        self.btn_bandeira_pt.setFlat(True)
        self.btn_bandeira_pt.setFixedSize(30, 22)
        self.btn_bandeira_pt.setStyleSheet(flag_style)
        self._tr("tooltip_bandeira_pt", self.btn_bandeira_pt.setToolTip)
        self.btn_bandeira_pt.clicked.connect(lambda: self._definir_idioma("pt"))
        lay.addWidget(self.btn_bandeira_pt)

        self.btn_bandeira_en = QPushButton()
        self.btn_bandeira_en.setIcon(QIcon(os.path.join(self.dp_dir, "ICONS", "flag_gb.svg")))
        self.btn_bandeira_en.setIconSize(flag_icon_size)
        self.btn_bandeira_en.setFlat(True)
        self.btn_bandeira_en.setFixedSize(30, 22)
        self.btn_bandeira_en.setStyleSheet(flag_style)
        self._tr("tooltip_bandeira_en", self.btn_bandeira_en.setToolTip)
        self.btn_bandeira_en.clicked.connect(lambda: self._definir_idioma("en"))
        lay.addWidget(self.btn_bandeira_en)

        # Monitor de CPU/GPU — mesmo padrão do CODRUG (MODULES/hw_monitor_window.py): em vez de
        # QLabels embutidos aqui atualizados por um QTimer da janela principal (que dependem do
        # event loop desta janela estar livre — e por isso "congelam" se algo bloquear esse event
        # loop), só um botão que abre uma janela de monitor num PROCESSO totalmente separado (seu
        # próprio QApplication/event loop), imune ao que a janela principal estiver fazendo.
        self.btn_open_hw_monitor = QPushButton()
        self._tr("btn_cpu_gpu_monitor", self.btn_open_hw_monitor.setText)
        self._tr(
            "tooltip_cpu_gpu_monitor",
            lambda txt: self.btn_open_hw_monitor.setToolTip(
                f"<html><p style='font-size:10pt;'>{txt}</p></html>"),
        )
        self.btn_open_hw_monitor.setStyleSheet(
            "QPushButton{padding:4px 12px;border:2px solid #6E8CA8;border-radius:6px;"
            "background:#0D1B2A;color:#6E8CA8;font-weight:bold;font-size:9pt;}"
            "QPushButton:hover{background:#16283B;}"
        )
        self.btn_open_hw_monitor.clicked.connect(self.open_hw_monitor_window)
        lay.addWidget(self.btn_open_hw_monitor)

        self.menuBar().setCornerWidget(self._mon_widget, Qt.TopRightCorner)

    def open_hw_monitor_window(self):
        """Abre MODULES/hw_monitor_window.py como um processo separado (não uma QThread): assim
        ele mantém seu próprio QApplication/event loop e continua atualizando a cada 1,5s mesmo
        que a janela principal esteja ocupada."""
        script_path = os.path.join(self.dp_dir, "MODULES", "hw_monitor_window.py")
        if not os.path.isfile(script_path):
            QMessageBox.warning(
                self, i18n.t("msg_title_monitor", self._idioma),
                i18n.t("msg_monitor_script_not_found", self._idioma, path=script_path))
            return
        try:
            subprocess.Popen([sys.executable, script_path])
        except Exception as e:
            QMessageBox.critical(
                self, i18n.t("msg_title_monitor_error", self._idioma),
                i18n.t("msg_monitor_open_error", self._idioma, error=e))

    def _sync_cur_executor_checks(self):
        sender = self.sender()

        if sender is self.chk_cur_thread and self.chk_cur_thread.isChecked():
            self.chk_cur_process.blockSignals(True)
            self.chk_cur_process.setChecked(False)
            self.chk_cur_process.blockSignals(False)

        elif sender is self.chk_cur_process and self.chk_cur_process.isChecked():
            self.chk_cur_thread.blockSignals(True)
            self.chk_cur_thread.setChecked(False)
            self.chk_cur_thread.blockSignals(False)

        # Nunca deixa os dois desligados
        if not self.chk_cur_thread.isChecked() and not self.chk_cur_process.isChecked():
            self.chk_cur_thread.blockSignals(True)
            self.chk_cur_thread.setChecked(True)
            self.chk_cur_thread.blockSignals(False)

    # ── Abas — sem ícones, apenas nome curto, traduzido via i18n ───────────
    def _build_tabs(self):
        """Constrói e adiciona as oito abas (Home + 7 etapas).

        Cada `_tab_stepN()` roda AQUI, de forma síncrona, na primeira
        construção da janela — antes de o usuário ter tido qualquer chance
        de abrir "Install Requirements". A maioria das etapas só importa seu
        módulo pipeline_*.py mais tarde, dentro do run_fn() executado no
        clique de "Run" (em processo filho); mas nada IMPEDE que uma aba
        futura precise, como a Etapa 4 (Optuna) precisa hoje, ler alguma
        constante do módulo em tempo de construção da aba — e nem toda
        dependência pesada desse módulo é garantida existir num venv
        recém-criado pelo bootstrap (que instala só PyQt5). Foi exatamente
        isso que derrubou o app inteiro antes da janela aparecer, quando
        pipeline_optimize.py importava pandas incondicionalmente no topo do
        arquivo (corrigido lá, com import local — ver o módulo).
        Esse `try/except` é a segunda camada: se uma aba falhar por
        QUALQUER motivo, no futuro, a janela ainda abre, com as demais abas
        utilizáveis e a que falhou substituída por um aviso — em vez do
        processo inteiro morrer com um traceback bruto no terminal, que é
        precisamente o tipo de falha que a Seção de acessibilidade deste
        trabalho existe para evitar.
        """
        builders = [
            (self._tab_home,  "tab_home"),
            (self._tab_step1, "tab_step1"),
            (self._tab_step2, "tab_step2"),   # Data Management (fusão Collection+Curation+Exploration)
            (self._tab_step3, "tab_step3"),   # Voxelization
            (self._tab_step4, "tab_step4"),   # Hyperparameter optimization (Optuna)
            (self._tab_step5, "tab_step5"),   # Training
            (self._tab_step6, "tab_step6"),   # Evaluation
            (self._tab_step7, "tab_step7"),   # Generation
        ]
        for idx, (build_fn, chave) in enumerate(builders):
            try:
                page = build_fn()
            except Exception as exc:
                log.error(f"Falha ao construir a aba '{chave}': "
                         f"{type(exc).__name__}: {exc}", exc_info=True)
                page = self._tab_load_error(chave, exc)
            self.tabs.addTab(page, "")
            self._tr(chave, lambda txt, i=idx: self.tabs.setTabText(i, txt))

    def _tab_load_error(self, chave: str, exc: Exception) -> QWidget:
        """Aba de reserva exibida quando a construção de uma etapa falha.

        Mantém a janela utilizável: as demais abas continuam funcionando, e
        esta explica o que houve em vez de deixar o processo morrer.
        """
        w = QWidget()
        lay = QVBoxLayout(w)
        lay.setContentsMargins(36, 32, 36, 24)
        nome_aba = i18n.t(chave, self._idioma)  # nome amigável, não a chave crua
        titulo = QLabel(i18n.t("tab_load_error_title", self._idioma, aba=nome_aba))
        titulo.setStyleSheet("font-weight: bold; font-size: 13pt; color: #F57C6F;")
        titulo.setWordWrap(True)
        detalhe = QLabel(i18n.t("tab_load_error_detail", self._idioma,
                                erro=f"{type(exc).__name__}: {exc}"))
        detalhe.setWordWrap(True)
        detalhe.setStyleSheet("color: #C9D1D9;")
        lay.addWidget(titulo)
        lay.addWidget(detalhe)
        lay.addStretch(1)
        return w

    # ══════════════════════════════════════════════════════════════════════
    # TAB 0 — HOME
    # ══════════════════════════════════════════════════════════════════════

    # ── Coleta de informações de hardware ─────────────────────────────────
    @staticmethod
    def _hw_cpu_info() -> list[tuple[str, str]]:
        """Retorna lista de (label, valor) com informações da CPU.

        Tenta múltiplas fontes em ordem de confiabilidade:
          1. lscpu  — mais completo (Model name, MHz, cache)
          2. /proc/cpuinfo — fallback para model e clock em MHz
          3. psutil — fallback para contagem de núcleos e RAM
        """
        import platform, subprocess as _sp, re as _re
        rows = []

        # ── Valores a coletar (preenchidos pelas fontes abaixo) ───────────
        model      = ""
        base_mhz   = 0.0
        max_mhz    = 0.0
        cores_phys = 0
        cores_log  = 0
        sockets    = 1
        l2_cache   = ""
        l3_cache   = ""

        # ── Fonte 1: lscpu ────────────────────────────────────────────────
        try:
            out = _sp.check_output(["lscpu"], text=True, stderr=_sp.DEVNULL)
            for line in out.splitlines():
                k, _, v = line.partition(":")
                k = k.strip(); v = v.strip()
                # Model name — campo principal
                if k == "Model name":
                    model = v
                # Sockets e cores por socket → núcleos físicos
                elif k == "Socket(s)":
                    try: sockets = int(v)
                    except Exception: pass
                elif k == "Core(s) per socket":
                    try: cores_phys = int(v) * sockets
                    except Exception: pass
                # Threads lógicas
                elif k == "CPU(s)":
                    try: cores_log = int(v)
                    except Exception: pass
                # Clock base: "CPU MHz" ou "CPU base MHz" ou "BogoMIPS"
                elif k in ("CPU MHz", "CPU base MHz", "Frequency (MHz)"):
                    try: base_mhz = float(v)
                    except Exception: pass
                # Clock máximo
                elif k == "CPU max MHz":
                    try: max_mhz = float(v)
                    except Exception: pass
                # Cache
                elif k == "L2 cache":
                    l2_cache = v
                elif k == "L3 cache":
                    l3_cache = v
        except Exception:
            pass

        # ── Fonte 2: /proc/cpuinfo ────────────────────────────────────────
        # Usado quando lscpu não trouxe modelo ou clock
        try:
            cpuinfo = open("/proc/cpuinfo").read()
            if not model:
                m = _re.search(r"model name\s*:\s*(.+)", cpuinfo)
                if m:
                    model = m.group(1).strip()
            if base_mhz == 0.0:
                m = _re.search(r"cpu MHz\s*:\s*([\d.]+)", cpuinfo)
                if m:
                    base_mhz = float(m.group(1))
            if cores_phys == 0:
                # cpu cores é por socket; multiplica por physical id count
                cores_m = _re.findall(r"cpu cores\s*:\s*(\d+)", cpuinfo)
                phys_ids = set(_re.findall(r"physical id\s*:\s*(\d+)", cpuinfo))
                if cores_m:
                    n_sockets = len(phys_ids) or 1
                    cores_phys = int(cores_m[0]) * n_sockets
        except Exception:
            pass

        # ── Fonte 3: psutil ───────────────────────────────────────────────
        if _PSUTIL_OK:
            import psutil as _ps
            if cores_phys == 0:
                cores_phys = _ps.cpu_count(logical=False) or 0
            if cores_log == 0:
                cores_log  = _ps.cpu_count(logical=True)  or 0
            # psutil.cpu_freq() retorna base e max em MHz
            try:
                freq = _ps.cpu_freq()
                if freq:
                    if base_mhz == 0.0 and freq.current:
                        base_mhz = freq.current
                    if max_mhz == 0.0 and freq.max:
                        max_mhz = freq.max
            except Exception:
                pass

        # ── Fallback final de modelo ───────────────────────────────────────
        if not model:
            model = platform.processor() or "N/A"

        # ── Monta a lista de linhas ────────────────────────────────────────
        rows.append(("Architecture", platform.machine()))
        rows.append(("Model",        model if model else "N/A"))
        rows.append(("Base clock",
                      f"{base_mhz/1000:.2f} GHz" if base_mhz else "N/A"))
        rows.append(("Max clock",
                      f"{max_mhz/1000:.2f} GHz"  if max_mhz  else "N/A"))
        rows.append(("Physical cores",  str(cores_phys) if cores_phys else "N/A"))
        rows.append(("Logical threads", str(cores_log)  if cores_log  else "N/A"))
        if l2_cache:
            rows.append(("L2 cache", l2_cache))
        if l3_cache:
            rows.append(("L3 cache", l3_cache))

        # RAM via psutil
        if _PSUTIL_OK:
            import psutil as _ps
            try:
                mem = _ps.virtual_memory()
                rows.append(("RAM total",
                              f"{mem.total / 1073741824:.1f} GB"))
                rows.append(("RAM available",
                              f"{mem.available / 1073741824:.1f} GB"))
            except Exception:
                pass

        return rows

    @staticmethod
    def _hw_gpu_info() -> list[tuple[str, str]]:
        """Retorna lista de (label, valor) com informações da GPU via nvidia-smi.

        Nota: 'cuda_version' não é um campo válido de --query-gpu do nvidia-smi.
        A versão CUDA máxima suportada pelo driver vem de 'nvidia-smi' direto,
        e a versão CUDA em uso pelo PyTorch vem de torch.version.cuda.
        """
        import subprocess as _sp, shutil as _sh
        rows = []
        if not _sh.which("nvidia-smi"):
            rows.append(("GPU", "nvidia-smi not found"))
            return rows
        try:
            # Campos válidos de --query-gpu (cuda_version NÃO é aceito aqui)
            fields = (
                "name,memory.total,"
                "clocks.max.sm,"
                "clocks.max.memory,power.limit"
            )
            raw = _sp.check_output(
                ["nvidia-smi",
                 f"--query-gpu={fields}",
                 "--format=csv,noheader,nounits"],
                text=True, stderr=_sp.PIPE, timeout=4
            ).strip().splitlines()[0]
            parts = [p.strip() for p in raw.split(",")]
            labels = [
                "Model", "VRAM total (MiB)",
                "Max SM clock (MHz)", "Max mem clock (MHz)",
                "TDP (W)",
            ]
            for lbl, val in zip(labels, parts):
                rows.append((lbl, val))

            # Versão CUDA máxima suportada pelo driver (linha do cabeçalho)
            try:
                header = _sp.check_output(
                    ["nvidia-smi"], text=True,
                    stderr=_sp.DEVNULL, timeout=4
                )
                import re as _re
                m = _re.search(r"CUDA Version:\s*([\d.]+)", header)
                if m:
                    rows.append(("CUDA max (driver)", m.group(1)))
            except Exception:
                pass

            # Versão CUDA em uso pelo PyTorch
            if _TORCH_OK:
                import torch as _t
                rows.append(("CUDA (PyTorch)",
                              _t.version.cuda or "N/A"))

            # CUDA cores, TFLOPs — derivados da arquitetura via torch
            if _TORCH_OK:
                import torch as _t
                if _t.cuda.is_available():
                    props = _t.cuda.get_device_properties(0)
                    mp    = props.multi_processor_count
                    rows.append(("Multiprocessors (SM)", str(mp)))
                    # Mapeamento compute capability → CUDA cores por SM
                    major = props.major
                    cores_per_sm = {
                        9: 128,   # Hopper (H100)
                        8: 128,   # Ampere RTX 30/40 (A100 usa 64, mas é raro)
                        7: 64,    # Volta / Turing
                        6: 128,   # Pascal (GP102/104; GP100 usa 64)
                        5: 128,   # Maxwell
                    }.get(major, 64)
                    total_cores = mp * cores_per_sm
                    rows.append(("CUDA cores (est.)", str(total_cores)))
                    # FP32 TFLOPs: cores × 2 operações/ciclo × clock_Hz / 1e12
                    try:
                        sm_vals = [v for l, v in rows if "Max SM clock" in l]
                        if sm_vals:
                            tflops = (total_cores * 2 * float(sm_vals[0])) / 1e6
                            rows.append(("FP32 perf. (TFLOPs, est.)",
                                          f"{tflops:.1f}"))
                    except Exception:
                        pass
                    rows.append(("Compute capability",
                                  f"{props.major}.{props.minor}"))
        except Exception as e:
            rows.append(("Error", str(e)))
        return rows

    @staticmethod
    def _sw_versions() -> list[tuple[str, str]]:
        """Retorna lista de (biblioteca, versão) para o quadro Software Specs."""
        import importlib, subprocess as _sp, shutil as _sh
        rows = []

        # Python
        rows.append(("Python", sys.version.split()[0]))

        # Bibliotecas — tenta importar e ler __version__
        libs = [
            ("PyQt5",           "PyQt5.QtCore",    "PYQT_VERSION_STR"),
            ("PyTorch",         "torch",            "__version__"),
            ("torch-geometric", "torch_geometric",  "__version__"),
            ("NumPy",           "numpy",            "__version__"),
            ("Pandas",          "pandas",           "__version__"),
            ("Matplotlib",      "matplotlib",       "__version__"),
            ("Seaborn",         "seaborn",          "__version__"),
            ("scikit-learn",    "sklearn",          "__version__"),
            ("SciPy",           "scipy",            "__version__"),
            ("RDKit",           "rdkit",            "__version__"),
            ("BioPython",       "Bio",              "__version__"),
            ("PySCF",           "pyscf",            "__version__"),
            ("CuPy",            "cupy",             "__version__"),
            ("tqdm",            "tqdm",             "__version__"),
        ]
        for display, mod_name, attr in libs:
            try:
                mod = importlib.import_module(mod_name)
                ver = getattr(mod, attr, None) or "installed"
                rows.append((display, ver))
            except ImportError:
                rows.append((display, "not installed"))

        # Backend real de voxelização — NÃO é o mesmo que "CuPy importou".
        # O import de cupy sempre funciona sem GPU/NVRTC funcionais; quem
        # falha é a compilação JIT do primeiro kernel real, só na hora do
        # uso (ver o smoke-test de pipeline_voxelize.py, que exercita
        # exatamente esse caminho). Reusar aqui o mesmo HAS_CUPY, em vez de
        # testar de novo, evita que a Home diga "GPU ok" enquanto a
        # curadoria trava horas depois com um traceback de NVRTC.
        try:
            import MODULES.pipeline_voxelize as _vx
            if _vx.HAS_CUPY:
                rows.append(("Voxelização (GPU/CuPy)", "ok"))
            else:
                rows.append(("Voxelização (GPU/CuPy)",
                             "CPU/NumPy — CuPy indisponível ou NVRTC quebrado"))
        except Exception as _exc:
            rows.append(("Voxelização (GPU/CuPy)", f"erro ao testar: {_exc}"))

        # ── Ferramentas externas (binários, não pacotes pip) ──────────────
        # xtb: níveis de teoria semi-empíricos da voxelização (Etapa 3).
        # Java + P2Rank: busca heurística de sítio da Etapa 7. O P2Rank
        # exige Java 17+, então a versão do Java é informada junto — um
        # Java 11 com P2Rank instalado falha na execução, e o usuário
        # precisa conseguir ver isso aqui.
        # Usa a mesma busca de CODEEP_requirements.detect_xtb() (PATH +
        # tools/xtb*/bin/xtb), não só shutil.which — senão esta linha diria
        # "not installed" mesmo logo depois de instalar via Install
        # Requirements, que grava em tools/, não no PATH do sistema.
        try:
            import CODEEP_requirements as _req
            _xtb = _req.detect_xtb()
        except Exception:
            _xtb = _sh.which("xtb")
        rows.append(("xtb", "installed" if _xtb else "not installed"))

        _java = _sh.which("java")
        if _java:
            try:
                _out = _sp.run([_java, "-version"], capture_output=True,
                               text=True, timeout=5)
                _txt = (_out.stderr or _out.stdout or "").splitlines()
                _jv = _txt[0].split('"')[1] if _txt and '"' in _txt[0] else "installed"
            except Exception:
                _jv = "installed"
            try:
                _major = int(_jv.split(".")[0])
                if _major < 17:
                    _jv += "  (P2Rank exige 17+)"
            except (ValueError, IndexError):
                pass
            rows.append(("Java (JRE)", _jv))
        else:
            rows.append(("Java (JRE)", "not installed"))

        try:
            import MODULES.pipeline_generate as _pg
            _prank = _pg._p2rank_bin()
        except Exception:
            _prank = _sh.which("prank")
        if _prank:
            _pv = "installed"
            for _part in Path(_prank).resolve().parts:
                if _part.lower().startswith("p2rank"):
                    _pv = _part.replace("p2rank_", "").replace("p2rank-", "") or "installed"
                    break
            rows.append(("P2Rank", _pv))
        else:
            rows.append(("P2Rank", "not installed"))

        # CUDA via torch
        if _TORCH_OK:
            import torch as _t
            rows.append(("CUDA (torch)",
                          _t.version.cuda or "N/A"))

        # Driver NVIDIA
        if _sh.which("nvidia-smi"):
            try:
                drv = _sp.check_output(
                    ["nvidia-smi","--query-gpu=driver_version",
                     "--format=csv,noheader"],
                    text=True, stderr=_sp.DEVNULL, timeout=3
                ).strip().splitlines()[0].strip()
                rows.append(("NVIDIA driver", drv))
            except Exception:
                rows.append(("NVIDIA driver", "N/A"))
        else:
            rows.append(("NVIDIA driver", "nvidia-smi not found"))

        return rows

    # ── Construção da aba Home ─────────────────────────────────────────────
    def _tab_home(self):
        w = QWidget()
        outer = QVBoxLayout(w)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        # ── Cabeçalho fixo ───────────────────────────────────────────────
        header = QWidget()
        hl = QVBoxLayout(header)
        hl.setContentsMargins(36, 32, 36, 16)
        hl.setSpacing(16)

        _logo_path = Path(__file__).resolve().parent / "ICONS" / "CODEEP2.png"
        hdr = QLabel()
        hdr.setAlignment(Qt.AlignCenter)
        if _logo_path.exists():
            _pix = QPixmap(str(_logo_path))
            # Escala para largura máxima de 150px mantendo proporção
            # Ajuste o valor conforme o tamanho da sua imagem
            if not _pix.isNull():
                _pix = _pix.scaledToWidth(150, Qt.SmoothTransformation)
            hdr.setPixmap(_pix)
        else:
            # Fallback: texto original caso a imagem não seja encontrada
            hdr.setText("CODEEP")
            hdr.setStyleSheet(
                "font-size:42pt;font-weight:bold;color:#2ECC71;letter-spacing:8px;")
        hl.addWidget(hdr)
        tagline = self._trL("home_tagline")
        tagline.setAlignment(Qt.AlignCenter)
        tagline.setStyleSheet("font-size:13pt;color:#95A5A6;")
        hl.addWidget(tagline)

        hl.addWidget(_mk_separator())
        outer.addWidget(header)

        # ── Miolo elástico: apenas os grupos crescem/encolhem ───────────
        scroll = QScrollArea(); scroll.setWidgetResizable(True)
        middle = QWidget()
        lay = QVBoxLayout(middle)
        lay.setContentsMargins(36, 16, 36, 16)
        lay.setSpacing(0)

        # ── Linha dupla: Hardware Specs CPU | Hardware Specs GPU ───────────
        hw_row = QHBoxLayout(); hw_row.setSpacing(14)

        # Quadro CPU
        cpu_grp = CollapsibleGroupBox()
        cpu_grp.setStyleSheet(_SS_GROUPBOX_NO_BG)
        self._tr("home_grp_cpu", cpu_grp.setTitle)
        cpu_form = QFormLayout(cpu_grp)
        cpu_form.setHorizontalSpacing(16); cpu_form.setVerticalSpacing(4)
        for label, val in self._hw_cpu_info():
            lbl_k = QLabel(label)
            lbl_k.setStyleSheet("color:#6E8CA8;font-size:9pt;")
            lbl_v = QLabel(val)
            lbl_v.setStyleSheet("font-weight:bold;font-size:9pt;color:#C9D1D9;")
            lbl_v.setTextInteractionFlags(Qt.TextSelectableByMouse)
            cpu_form.addRow(lbl_k, lbl_v)
        cpu_grp.set_collapsed(False)
        hw_row.addWidget(cpu_grp, 1)

        # Quadro GPU
        gpu_grp = CollapsibleGroupBox()
        gpu_grp.setStyleSheet(_SS_GROUPBOX_NO_BG)
        self._tr("home_grp_gpu", gpu_grp.setTitle)
        gpu_form = QFormLayout(gpu_grp)
        gpu_form.setHorizontalSpacing(16); gpu_form.setVerticalSpacing(4)
        for label, val in self._hw_gpu_info():
            lbl_k = QLabel(label)
            lbl_k.setStyleSheet("color:#6E8CA8;font-size:9pt;")
            lbl_v = QLabel(val)
            lbl_v.setStyleSheet("font-weight:bold;font-size:9pt;color:#C9D1D9;")
            lbl_v.setTextInteractionFlags(Qt.TextSelectableByMouse)
            gpu_form.addRow(lbl_k, lbl_v)
        gpu_grp.set_collapsed(False)
        hw_row.addWidget(gpu_grp, 1)

        lay.addLayout(hw_row)
        lay.addStretch(1)

        # ── Software Specs ─────────────────────────────────────────────────
        sw_grp = CollapsibleGroupBox()
        sw_grp.setStyleSheet(_SS_GROUPBOX_NO_BG)
        self._tr("home_grp_sw", sw_grp.setTitle)
        sw_grid = QGridLayout(sw_grp)
        sw_grid.setHorizontalSpacing(24); sw_grid.setVerticalSpacing(4)
        sw_items = self._sw_versions()
        # Distribui em 3 colunas para não ficar muito alto
        cols = 3
        for i, (lib, ver) in enumerate(sw_items):
            row, col = divmod(i, cols)
            lbl_lib = QLabel(lib)
            lbl_lib.setStyleSheet("color:#6E8CA8;font-size:9pt;")
            lbl_ver = QLabel(ver)
            # Mesma fonte branca em negrito usada nos valores de Hardware Specs — CPU/GPU.
            lbl_ver.setStyleSheet("font-weight:bold;font-size:9pt;color:#C9D1D9;")
            lbl_ver.setTextInteractionFlags(Qt.TextSelectableByMouse)
            sw_grid.addWidget(lbl_lib, row, col*2)
            sw_grid.addWidget(lbl_ver, row, col*2+1)
        sw_grp.set_collapsed(False)
        lay.addWidget(sw_grp)
        lay.addStretch(1)

        # ── Pipeline — Steps ───────────────────────────────────────────────
        pipe_grp = CollapsibleGroupBox()
        pipe_grp.setStyleSheet(_SS_GROUPBOX_NO_BG)
        self._tr("home_grp_pipeline", pipe_grp.setTitle)
        pipe_lay = QGridLayout(pipe_grp)
        pipe_lay.setHorizontalSpacing(20); pipe_lay.setVerticalSpacing(4)
        step_keys = [
            ("home_step1_name", "home_step1_desc"),
            ("home_step2_name", "home_step2_desc"),
            ("home_step3_name", "home_step3_desc"),
            ("home_step4_name", "home_step4_desc"),
            ("home_step5_name", "home_step5_desc"),
            ("home_step6_name", "home_step6_desc"),
            ("home_step7_name", "home_step7_desc"),
        ]
        for i, (name_key, desc_key) in enumerate(step_keys):
            name_lbl = QLabel()
            # Mesma fonte branca em negrito usada nos valores de Hardware Specs — CPU/GPU.
            name_lbl.setStyleSheet("font-weight:bold;font-size:9pt;color:#C9D1D9;")
            self._tr(name_key, lambda txt, lbl=name_lbl: lbl.setText(f"<b>{txt}</b>"))
            desc_lbl = self._trL(desc_key)
            desc_lbl.setStyleSheet("color:#6E8CA8;font-size:9pt;")
            pipe_lay.addWidget(name_lbl, i, 0)
            pipe_lay.addWidget(desc_lbl, i, 1)
        pipe_grp.set_collapsed(False)
        lay.addWidget(pipe_grp)
        scroll.setWidget(middle)
        outer.addWidget(scroll, 1)

        # ── Rodapé fixo ──────────────────────────────────────────────────
        footer = QWidget()
        fl = QVBoxLayout(footer)
        fl.setContentsMargins(36, 16, 36, 24)
        fl.setSpacing(16)

        fl.addWidget(_mk_separator())

        # ── Botões de ação — sem ícones ────────────────────────────────────
        btn_row = QHBoxLayout()
        btn_start = self._mk_btn_tr("home_btn_start", _SS_BTN_PRIMARY, 160)
        btn_start.setFixedHeight(38)
        btn_start.clicked.connect(lambda: self.tabs.setCurrentIndex(1))
        btn_req = self._mk_btn_tr("home_btn_install", _SS_BTN_SECONDARY, 190)
        btn_req.setFixedHeight(38)
        btn_req.clicked.connect(self._show_requirements)
        if not _REQ_MODULE_OK:
            btn_req.setEnabled(False)
        btn_terminal = self._mk_btn_tr("home_btn_terminal", _SS_BTN_SECONDARY, 160)
        btn_terminal.setFixedHeight(38)
        btn_terminal.clicked.connect(self._open_terminal)
        btn_row.addStretch()
        btn_row.addWidget(btn_start)
        btn_row.addSpacing(14)
        btn_row.addWidget(btn_req)
        btn_row.addSpacing(14)
        btn_row.addWidget(btn_terminal)
        btn_row.addStretch()
        fl.addLayout(btn_row)

        ver = QLabel(f"v{VERSAO}  ·  © 2024–2026 CEB/UFPR  ·  {LICENCA_CURTA}")
        ver.setAlignment(Qt.AlignCenter)
        ver.setStyleSheet("font-size:8pt;color:#6E8CA8;margin-top:6px;")
        fl.addWidget(ver)
        outer.addWidget(footer)
        return w

    # ══════════════════════════════════════════════════════════════════════
    # TAB 1 — STEP 1: CONFIGURAÇÃO DO JOB
    # ══════════════════════════════════════════════════════════════════════
    def _tab_step1(self):
        w = QWidget()
        scroll = QScrollArea(); scroll.setWidgetResizable(True)
        inner = QWidget(); lay = QVBoxLayout(inner)
        lay.setContentsMargins(30,16,30,16); lay.setSpacing(12)
        scroll.setWidget(inner)

        lay.addWidget(self._mk_title_tr("title_step1"))
        lay.addWidget(_mk_separator())

        # ── Diretório raiz do CODEEP ───────────────────────────────────────
        grp_dir = QGroupBox(); self._tr("s1_grp_root", grp_dir.setTitle)
        grp_dir.setStyleSheet(_SS_GROUPBOX_NO_BG)
        dl = QVBoxLayout(grp_dir)
        self.ed_root = QLineEdit(self.dp_dir); self.ed_root.setReadOnly(True); self.ed_root.setFixedSize(400, 30)
        self.ed_root.setAlignment(Qt.AlignmentFlag.AlignCenter)
        #dl.addStretch(4)
        dl.addWidget(self.ed_root, alignment=Qt.AlignmentFlag.AlignCenter)
        btn_br = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        btn_br.clicked.connect(self._browse_root)
        dl.addWidget(btn_br, alignment=Qt.AlignmentFlag.AlignCenter)
        #dl.addStretch(4)

        # ── Identificação do Job ───────────────────────────────────────────
        grp_job = QGroupBox(); self._tr("s1_grp_job_id", grp_job.setTitle)
        grp_job.setStyleSheet(_SS_GROUPBOX_NO_BG)
        jf = QFormLayout(grp_job); jf.setHorizontalSpacing(20)
        self.rb_job_new = QCheckBox()
        self._tr("s1_rb_new_project", self.rb_job_new.setText)
        self.rb_job_new.setChecked(True)
        self.rb_job_load = QCheckBox()
        self._tr("s1_rb_load_project", self.rb_job_load.setText)
        mode_row = QWidget(); mode_l = QHBoxLayout(mode_row); mode_l.setContentsMargins(0,0,0,0)
        mode_l.addWidget(self.rb_job_new)
        mode_l.addWidget(self.rb_job_load)
        mode_l.addStretch(1)

        self.cb_prev_job = QComboBox()
        self.cb_prev_job.setEnabled(False)
        self.cb_prev_job.setMaximumWidth(340)
        self._tr("s1_tooltip_prev_job", self.cb_prev_job.setToolTip)
        self.ed_job_name = QLineEdit()
        self._tr("s1_ph_job_name", self.ed_job_name.setPlaceholderText)
        self.ed_job_name.setMaximumWidth(340)
        self.dt_job_stamp = QDateTimeEdit()
        self.dt_job_stamp.setCalendarPopup(False)
        self.dt_job_stamp.setDateTime(QDateTime.currentDateTime())
        self.dt_job_stamp.setDisplayFormat("yyyy-MM-dd_HH-mm")
        self.dt_job_stamp.setMaximumWidth(200)
        self.dt_job_stamp.setReadOnly(True)
        self._tr("s1_tooltip_date", self.dt_job_stamp.setToolTip)
        self.lbl_job_id = QLabel("—")
        self.lbl_job_id.setStyleSheet("font-weight:bold;color:#2ECC71;")
        self.ed_job_name.textChanged.connect(self._update_job_id)
        self.rb_job_new.toggled.connect(self._sync_step1_job_mode_checks)
        self.rb_job_load.toggled.connect(self._sync_step1_job_mode_checks)
        self.rb_job_new.toggled.connect(self._sync_step1_job_mode)
        self.rb_job_load.toggled.connect(self._sync_step1_job_mode)
        self.cb_prev_job.currentIndexChanged.connect(self._update_job_id)
        jf.addRow(self._trL("s1_lbl_job_mode"), mode_row)
        jf.addRow(self._trL("s1_lbl_job_name"), self.ed_job_name)
        jf.addRow(self._trL("s1_lbl_date"),     self.dt_job_stamp)
        jf.addRow(self._trL("s1_lbl_prev_job"), self.cb_prev_job)
        jf.addRow(self._trL("s1_lbl_job_id"),   self.lbl_job_id)

        # ── Termos de busca para Fases 2 e 3 ──────────────────────────────
        grp_search = QGroupBox(); self._tr("s1_grp_search", grp_search.setTitle)
        grp_search.setStyleSheet(_SS_GROUPBOX_NO_BG)
        sl = QVBoxLayout(grp_search); sl.setSpacing(6)

        sl.addWidget(self._mk_section_tr("s1_sec_org_terms"))
        self.te_org_terms = QTextEdit()
        self._tr("s1_ph_org_terms", self.te_org_terms.setPlaceholderText)
        self.te_org_terms.setFixedHeight(150)
        sl.addWidget(self.te_org_terms)

        sl.addWidget(self._mk_section_tr("s1_sec_desc_terms"))
        self.te_desc_terms = QTextEdit()
        self._tr("s1_ph_desc_terms", self.te_desc_terms.setPlaceholderText)
        self.te_desc_terms.setFixedHeight(150)
        sl.addWidget(self.te_desc_terms)

        sl.addWidget(self._mk_section_tr("s1_sec_p3_ids"))
        self.te_phase3_ids = QTextEdit()
        self._tr("s1_ph_p3_ids", self.te_phase3_ids.setPlaceholderText)
        self.te_phase3_ids.setFixedHeight(150)
        sl.addWidget(self.te_phase3_ids)

        top_row = QHBoxLayout()
        top_row.setSpacing(12)
        top_row.addWidget(grp_dir, 1)
        top_row.addWidget(grp_job, 1)
        lay.addLayout(top_row)

        # ── Detected Paths ─────────────────────────────────────────────────
        grp_paths = QGroupBox(); self._tr("s1_grp_paths", grp_paths.setTitle)
        grp_paths.setStyleSheet(_SS_GROUPBOX_NO_BG)
        pf = QFormLayout(grp_paths); pf.setHorizontalSpacing(16)
        pf.setVerticalSpacing(3)

        # Caminhos globais (Fase 1 — compartilhados entre todos os jobs)
        self._path_labels = {}
        global_paths = [
            ("global_phase1_raw", "data/raw/pdb/ (Phase 1)", os.path.join("data", "raw", "pdb")),
            ("global_phase1_curated", "data/curated/ (Phase 1)", os.path.join("data", "curated")),
            ("global_phase1_tensors", "data/tensors/ (Phase 1)", os.path.join("data", "tensors")),
            ("global_phase1_ckpt", "checkpoints/phase1/", os.path.join("checkpoints", "phase1")),
        ]
        _sep = QLabel()
        self._tr("s1_sep_global", lambda txt: _sep.setText(f"<b>{txt}</b>"))
        _sep.setStyleSheet("color:#2ECC71;font-size:9pt;margin-top:4px;")
        pf.addRow(_sep)
        for key, label, sub in global_paths:
            lbl = QLabel("—"); lbl.setStyleSheet("font-size:9pt;color:#2ECC71;font-weight:bold;")
            lbl.setWordWrap(True)
            lbl.setTextFormat(Qt.RichText)
            self._path_labels[key] = (lbl, sub, "global")
            pf.addRow(label, lbl)

        # Caminhos do job (Fases 2/3 — por job_id)
        _sep2 = QLabel()
        self._tr("s1_sep_job", lambda txt: _sep2.setText(f"<b>{txt}</b>"))
        _sep2.setStyleSheet("color:#5DADE2;font-size:9pt;margin-top:6px;")
        pf.addRow(_sep2)
        job_paths = [
            ("job_phase2_raw", "data/raw/pdb/phase2/", os.path.join("data", "raw", "pdb", "phase2")),
            ("job_phase3_raw", "data/raw/pdb/phase3/", os.path.join("data", "raw", "pdb", "phase3")),
            ("job_phase2_curated", "data/curated/phase2/", os.path.join("data", "curated", "phase2")),
            ("job_phase3_curated", "data/curated/phase3/", os.path.join("data", "curated", "phase3")),
            ("job_phase2_tensors", "data/tensors/phase2/", os.path.join("data", "tensors", "phase2")),
            ("job_phase3_tensors", "data/tensors/phase3/", os.path.join("data", "tensors", "phase3")),
            ("job_phase2_ckpt", "checkpoints/phase2/", os.path.join("checkpoints", "phase2")),
            ("job_phase3_ckpt", "checkpoints/phase3/", os.path.join("checkpoints", "phase3")),
        ]
        for key, label, sub in job_paths:
            lbl = QLabel("—"); lbl.setStyleSheet("font-size:9pt;color:#5DADE2;font-weight:bold;")
            lbl.setWordWrap(True)
            lbl.setTextFormat(Qt.RichText)
            self._path_labels[key] = (lbl, sub, "job")
            pf.addRow(label, lbl)

        second_row = QHBoxLayout()
        second_row.setSpacing(12)
        second_row.addWidget(grp_search, 1)
        second_row.addWidget(grp_paths, 1)
        lay.addLayout(second_row)

        # ── Botão e status ─────────────────────────────────────────────────
        self.btn_job_run = self._mk_btn_tr("s1_btn_create_job", _SS_BTN_PRIMARY, 230)
        self.btn_job_run.setFixedHeight(38)
        self.btn_job_run.clicked.connect(self._job_run)
        lay.addWidget(self.btn_job_run, alignment=Qt.AlignCenter)

        self.lbl_job_status = QLabel("")
        self.lbl_job_status.setAlignment(Qt.AlignCenter)
        self.lbl_job_status.setStyleSheet("font-size:9pt;color:#2ECC71;")
        lay.addWidget(self.lbl_job_status)

        lay.addStretch()

        # Empacota scroll
        outer = QVBoxLayout(w); outer.setContentsMargins(0,0,0,0)
        outer.addWidget(scroll)
        # Nav row fora do scroll
        nav = QWidget(); nl = QVBoxLayout(nav); nl.setContentsMargins(8,4,8,8)
        nl.addLayout(self._mk_nav_row_tr(lambda: self.tabs.setCurrentIndex(0),
                                          lambda: self.tabs.setCurrentIndex(2)))
        outer.addWidget(nav)
        self._sync_step1_job_mode()
        return w

    def _browse_root(self):
        d = QFileDialog.getExistingDirectory(
            self, i18n.t("dlg_select_root_title", self._idioma), self.dp_dir)
        if d:
            self.dp_dir = d; self.ed_root.setText(d)
            self._refresh_previous_jobs()
            self._refresh_paths()

    def _update_job_id(self):
        if hasattr(self, "rb_job_load") and self.rb_job_load.isChecked():
            prev = self.cb_prev_job.currentText().strip() if hasattr(self, "cb_prev_job") else ""
            dt = self._datetime_from_job_id(prev)
            if dt is not None and hasattr(self, "dt_job_stamp"):
                self.dt_job_stamp.setDateTime(dt)
            self.lbl_job_id.setText(prev or "—")
            return
        if hasattr(self, "dt_job_stamp"):
            self.dt_job_stamp.setDateTime(QDateTime.currentDateTime())
        name = self.ed_job_name.text().strip()
        stamp = self.dt_job_stamp.dateTime().toString("yyyy-MM-dd_HH-mm")
        self.lbl_job_id.setText(f"{stamp}_{name}" if name else "—")

    def _refresh_paths(self):
        """Atualiza os labels de Detected Paths para global e job-specific."""
        root = self.ed_root.text().strip()
        if not root:
            return

        def _fmt(p: str, kind: str) -> str:
            """Formata apenas os valores/contagens do caminho detectado."""
            from pathlib import Path as _P

            path = _P(p)
            exists = path.exists()
            color = "#2ECC71" if kind == "global" else "#5DADE2"
            icon = "✔" if exists else "✘"

            value_text = "0"
            if exists and path.is_dir():
                pdbs = len(list(path.rglob("*.pdb")))
                sdfs = len(list(path.rglob("*.sdf")))
                pts = len(list(path.rglob("*.pt")))
                npzs = len(list(path.rglob("*.npz")))

                parts = []
                if pdbs:
                    parts.append(f"{pdbs} PDB")
                if sdfs:
                    parts.append(f"{sdfs} SDF")
                if pts:
                    parts.append(f"{pts} .pt")
                if npzs:
                    parts.append(f"{npzs} .npz")

                # Para Phase 1 raw PDB, mostra também o detalhamento por subpasta
                if path.parts[-3:] == ("data", "raw", "pdb"):
                    sub_parts = []
                    for child in sorted([d for d in path.iterdir() if d.is_dir()]):
                        n_child = len(list(child.glob("*.pdb")))
                        if n_child:
                            sub_parts.append(f"{child.name}: {n_child}")
                    if sub_parts:
                        parts.append(" | ".join(sub_parts))

                if parts:
                    value_text = "; ".join(parts)

            if not exists:
                color = "#E74C3C"
                value_text = icon
                return f'<span style="color:{color};font-size:9pt;font-weight:bold;">{value_text}</span>'

            return f'<span style="color:{color};font-size:9pt;font-weight:bold;">{value_text}</span>'

        job_id  = self.lbl_job_id.text().strip()
        has_job = bool(job_id and job_id != "—")

        for key, (lbl, sub, kind) in self._path_labels.items():
            if kind == "global":
                full = os.path.join(root, sub)
            else:
                # Caminhos job-specific ficam em JOBS/<job_id>/
                if has_job:
                    full = os.path.join(root, "JOBS", job_id, sub)
                else:
                    _ph = i18n.t("s1_placeholder_no_job", self._idioma)
                    lbl.setText(f'<span style="color:#BDC3C7;">{_ph}</span>')
                    continue
            lbl.setText(_fmt(full, kind))

    def _job_run(self):
        root = self.ed_root.text().strip()
        is_load = hasattr(self, "rb_job_load") and self.rb_job_load.isChecked()
        name = self.ed_job_name.text().strip()
        if is_load:
            selected_job = self.cb_prev_job.currentText().strip()
            if not root or not selected_job:
                QMessageBox.warning(
                    self, i18n.t("msg_warning_title", self._idioma),
                    i18n.t("s1_msg_select_previous_job", self._idioma)); return
            self._load_project(os.path.join(root, "JOBS", selected_job))
            return

        if not root or not name:
            QMessageBox.warning(
                self, i18n.t("msg_warning_title", self._idioma),
                i18n.t("s1_msg_fill_root_name", self._idioma)); return

        current_dt = QDateTime.currentDateTime()
        self.dt_job_stamp.setDateTime(current_dt)
        stamp    = current_dt.toString("yyyy-MM-dd_HH-mm")
        job_id   = f"{stamp}_{name}"
        job_dir  = os.path.join(root, "JOBS", job_id)

        # Estrutura global da Fase 1
        for sub in [
            os.path.join("data", "raw", "pdb"),
            os.path.join("data", "raw", "sdf"),
            os.path.join("data", "curated"),
            os.path.join("data", "tensors"),
            os.path.join("data", "figures"),
            os.path.join("data", "logs"),
            os.path.join("checkpoints", "phase1"),
        ]:
            os.makedirs(os.path.join(root, sub), exist_ok=True)

        # Estrutura do job para Fases 2 e 3
        for sub in [
            os.path.join("data", "raw", "pdb", "phase2"),
            os.path.join("data", "raw", "pdb", "phase3"),
            os.path.join("data", "raw", "sdf", "phase2"),
            os.path.join("data", "raw", "sdf", "phase3"),
            os.path.join("data", "curated", "phase2"),
            os.path.join("data", "curated", "phase3"),
            os.path.join("data", "tensors", "phase2"),
            os.path.join("data", "tensors", "phase3"),
            os.path.join("data", "figures", "phase2"),
            os.path.join("data", "figures", "phase3"),
            os.path.join("data", "logs", "phase2"),
            os.path.join("data", "logs", "phase3"),
            os.path.join("checkpoints", "phase2"),
            os.path.join("checkpoints", "phase3"),
            "results",
        ]:
            os.makedirs(os.path.join(job_dir, sub), exist_ok=True)

        # Salva configuração do job em JSON (termos de busca + metadados)
        job_config = {
            "job_id":          job_id,
            "job_name":        name,
            "created":         datetime.now().isoformat(),
            "root_dir":        root,
            "job_dir":         job_dir,
            "organism_terms":  self._parse_text_list(self.te_org_terms.toPlainText()),
            "desc_terms":      self._parse_text_list(self.te_desc_terms.toPlainText()),
            "phase3_pdb_ids":  self._parse_csv_ids(self.te_phase3_ids.toPlainText()),
        }
        cfg_path = os.path.join(job_dir, "job_config.json")
        with open(cfg_path, "w", encoding="utf-8") as f:
            json.dump(job_config, f, indent=2, ensure_ascii=False)

        self.job_dir = job_dir
        self.lbl_job_id.setText(job_id)
        self._refresh_previous_jobs(selected_job=job_id)
        self.lbl_job_status.setText(i18n.t("s1_msg_job_ready", self._idioma, job_dir=job_dir))
        self._refresh_paths()
        self._inject_root(root, job_dir)
        self._save_all_tab_states()

    @staticmethod
    def _parse_text_list(text: str) -> list:
        """Converte texto multilinha em lista de strings não-vazias."""
        return [l.strip() for l in text.splitlines() if l.strip()]

    @staticmethod
    def _parse_csv_ids(text: str) -> list:
        """Converte texto com IDs separados por vírgulas ou quebras em lista."""
        import re as _re
        tokens = _re.split(r"[,\n\r\s]+", text)
        return [t.strip().upper() for t in tokens if t.strip()]

    def _inject_root(self, root: str, job_dir: str = ""):
        """Injeta caminhos corretos nos módulos do pipeline.

        Fase 1 (coleta geral, curadoria, exploração, voxelização):
            BASE_DIR, RAW_DIR, CUR_DIR, TENSOR_DIR, FIG_DIR → <root>/data/...

        Fases 2/3 (coleta específica, curadoria job, treino, avaliação, geração):
            Os módulos de coleta recebem job_dir diretamente como argumento,
            não via variável de módulo, para manter a separação limpa.
            checkpoints e logs → <job_dir>/...
        """
        from pathlib import Path as _P
        import importlib

        # Garante que MODULES/ e raiz estão no sys.path
        for p in [os.path.join(os.path.dirname(__file__), "MODULES"),
                  os.path.dirname(__file__)]:
            if p not in sys.path:
                sys.path.insert(0, p)

        _root_p = _P(root)
        _job_p  = _P(job_dir) if job_dir else _root_p

        for mod_name in ["pipeline_collect","pipeline_curate","pipeline_explore",
                         "pipeline_voxelize","pipeline_optimize","pipeline_train",
                         "pipeline_evaluate","pipeline_generate"]:
            try:
                mod = importlib.import_module(f"MODULES.{mod_name}")
                mod._CODEEP_ROOT    = root
                mod._CODEEP_JOB_DIR = str(_job_p)

                if hasattr(mod, "PROJECT_DIR"):
                    mod.PROJECT_DIR = _job_p
                if hasattr(mod, "BASE_DIR"):
                    mod.BASE_DIR    = _root_p / "data"
                if hasattr(mod, "RAW_DIR"):
                    mod.RAW_DIR     = _root_p / "data" / "raw"
                if hasattr(mod, "CUR_DIR"):
                    mod.CUR_DIR     = _root_p / "data" / "curated"
                if hasattr(mod, "TENSOR_DIR"):
                    mod.TENSOR_DIR  = _root_p / "data" / "tensors"
                if hasattr(mod, "FIG_DIR"):
                    mod.FIG_DIR     = _root_p / "data" / "figures"
                if hasattr(mod, "LOG_DIR"):
                    mod.LOG_DIR     = _root_p / "data" / "logs"

            except Exception as e:
                print(f"[CODEEP] warning injecting paths into {mod_name}: {e}")

    # ══════════════════════════════════════════════════════════════════════
    # HELPER GENÉRICO: constrói aba de etapa com log + progresso + botões
    # ══════════════════════════════════════════════════════════════════════
    def _populate_pipeline_body(self, lay, params_widget, run_fn_getter,
                                worker_key, log_height, error_parent,
                                params_min_height=420,
                                shared_log_box=None, all_run_buttons=None,
                                on_worker=None, with_plot=False):
        """Monta o corpo comum a toda aba/grupo de pipeline (parâmetros + progresso + Run/Stop,
        e log colapsável PRÓPRIO quando shared_log_box não é passado) dentro do layout `lay` já
        existente — compartilhado por _build_pipeline_tab (aba inteira, com título/navegação
        própria) e _build_pipeline_group (QGroupBox dentro de uma aba com várias etapas
        fundidas, ver _tab_step2/"Data Management"). error_parent é o widget-pai dos QMessageBox
        de erro (a própria aba/grupo, não a janela inteira, para o diálogo aparecer ancorado no
        lugar certo).

        O painel de parâmetros (scroll) é o ÚNICO item de `lay` com stretch>0 — título (quando é
        _build_pipeline_tab), separador, log, progresso, botões e navegação usam sizeHint fixo,
        então é ele quem absorve todo espaço vertical sobrando quando a janela cresce (ver
        params_min_height abaixo). ANTES disto o painel tinha um TETO (setMaximumHeight) e
        NENHUM stretch — sem nada reivindicando o espaço extra explicitamente, o Qt acabava
        distribuindo-o para o título (QLabel), que parecia "esticar" sozinho ao redimensionar a
        janela ou colapsar o log (bug relatado e confirmado por medição: o QLabel do título
        chegava a 686px de altura numa janela alta, contra ~40px de conteúdo real). Trocar o
        teto por um PISO (setMinimumHeight, só evita ficar espremido demais antes do scroll
        interno assumir) + stretch=1 explícito resolve isso de vez, em toda aba/grupo que passa
        por aqui — não só na que motivou o relato.

        shared_log_box: quando fornecido (ver _tab_step2), este grupo NÃO cria nem posiciona seu
        próprio log — escreve no log compartilhado passado pelo chamador (colapsável, posicionado
        uma única vez fora/abaixo de todos os grupos da aba, ver _mk_collapsible_log_header ali).
        all_run_buttons: lista compartilhada entre os grupos de uma mesma aba fundida — este
        botão Run se registra nela e desabilita os das OUTRAS ações enquanto roda (o log
        compartilhado só faz sentido mostrando UMA ação de cada vez)."""
        # Painel de parâmetros (scroll) — único item com stretch, ver nota acima.
        scroll = QScrollArea(); scroll.setWidgetResizable(True)
        scroll.setWidget(self._wrap_scroll_widget(params_widget))
        scroll.setMinimumHeight(params_min_height)
        lay.addWidget(scroll, 1)

        # Painel de curvas ao vivo (só a Etapa 5 pede). Vem ANTES do log e
        # com stretch maior que o painel de parâmetros: ao colapsar o
        # Execution Log, o espaço liberado vai majoritariamente para cá.
        if with_plot:
            self._training_plot = TrainingPlotPanel(lambda: self._idioma, parent=None)
            lay.addWidget(self._mk_collapsible_log_header(
                self._training_plot, chave="sec_training_plot"))
            lay.addWidget(self._training_plot, 2)

        # Log de execução em tempo real — próprio (colapsável) ou compartilhado com outros
        # grupos da mesma aba (ver shared_log_box acima).
        if shared_log_box is not None:
            log_box = shared_log_box
        else:
            log_box = _mk_log_box(log_height)
            lay.addWidget(self._mk_collapsible_log_header(log_box))
            lay.addWidget(log_box)

        # Barra de progresso
        prog = _mk_progress(lambda: self._idioma); lay.addWidget(prog)
        # Reaplica o texto ocioso ("Progress: 0% — ETA: —") no idioma atual numa troca de
        # idioma — só quando ainda não rodou nada (value==0); depois disso o texto já é mantido
        # atualizado ao vivo por _connect_worker (eta_signal/finished_signal), então não deve ser
        # sobrescrito aqui.
        self._tr("progress_label", lambda _t: prog.setFormat(
            f"{i18n.t('progress_label', self._idioma)}: %p%  —  "
            f"{i18n.t('progress_eta_label', self._idioma)}: —"
        ) if prog.value() == 0 else None)

        # Botões de execução e parada
        btn_row = QHBoxLayout()
        btn_run  = self._mk_btn_tr("btn_run",  _SS_BTN_PRIMARY, 150)
        btn_stop = self._mk_btn_tr("btn_stop", _SS_BTN_DANGER,  100)
        btn_stop.setEnabled(False)
        btn_row.addWidget(btn_run); btn_row.addWidget(btn_stop)
        lay.addLayout(btn_row)

        if all_run_buttons is not None:
            all_run_buttons.append(btn_run)

        def _run():
            if not self.ed_root.text().strip():
                QMessageBox.warning(
                    error_parent, i18n.t("msg_warning_title", self._idioma),
                    i18n.t("msg_please_start_job", self._idioma))
                return
            try:
                spec = run_fn_getter()
            except Exception as e:
                QMessageBox.critical(
                    error_parent, i18n.t("msg_config_error_title", self._idioma), str(e)); return
            # run_fn pode retornar None para dizer "o usuário cancelou" — usado
            # pela Etapa 4 (Optuna), que pergunta antes de rodar quando a estimativa de
            # disco não fecha. Cancelar não é erro; não abre diálogo nenhum.
            if spec is None:
                return
            fn, args, kwargs = spec
            log_box.clear(); prog.setValue(0)
            btn_run.setEnabled(False); btn_stop.setEnabled(True)
            if all_run_buttons is not None:
                for b in all_run_buttons:
                    if b is not btn_run:
                        b.setEnabled(False)
            worker = PipelineWorker(fn, args, kwargs)
            # Gancho para quem quer acompanhar o worker recém-criado — usado
            # pela Etapa 5 para abrir a janela de curvas ao vivo e ligá-la ao
            # log_signal. Fica aqui, e não em _connect_worker, porque este é o
            # único ponto que conhece o worker ANTES de ele começar.
            if on_worker is not None:
                try:
                    on_worker(worker)
                except Exception as _e:
                    log.warning(f"on_worker falhou (seguindo sem ele): {_e}")

            def _on_done(ok):
                if all_run_buttons is not None:
                    for b in all_run_buttons:
                        if b is not btn_run:
                            b.setEnabled(True)

            _connect_worker(worker, log_box, prog, btn_run, btn_stop,
                            _on_done, idioma_getter=lambda: self._idioma)
            self._workers[worker_key] = worker
            worker.start()

        btn_run.clicked.connect(_run)

    def _build_pipeline_tab(self, title_key, params_widget, run_fn_getter,
                            worker_key, prev_idx, next_idx,
                            log_height=280, on_worker=None, with_plot=False):
        """Constrói o layout padrão de uma aba de pipeline inteira (título + parâmetros +
        log colapsável + progresso + Run/Stop + navegação) — ver _populate_pipeline_body para
        o corpo compartilhado com _build_pipeline_group.

        title_key     : chave i18n (ver MODULES/i18n.py) do título da aba
        params_widget : QWidget com os controles específicos da etapa
        run_fn_getter : callable() → (fn, args, kwargs) a executar
        """
        w = QWidget(); lay = QVBoxLayout(w)
        lay.setContentsMargins(30,20,30,20); lay.setSpacing(12)
        lay.addWidget(self._mk_title_tr(title_key))
        lay.addWidget(_mk_separator())

        self._populate_pipeline_body(lay, params_widget, run_fn_getter, worker_key,
                                     log_height, error_parent=w,
                                     on_worker=on_worker, with_plot=with_plot)

        lay.addLayout(self._mk_nav_row_tr(
            lambda: self.tabs.setCurrentIndex(prev_idx),
            lambda: self.tabs.setCurrentIndex(next_idx),
        ))
        return w

    def _build_pipeline_group(self, title_key, params_widget, run_fn_getter,
                              worker_key, log_height=220, params_min_height=300,
                              shared_log_box=None, all_run_buttons=None):
        """Variante de _build_pipeline_tab que devolve um QGroupBox (parâmetros + progresso +
        Run/Stop, e log colapsável PRÓPRIO só quando shared_log_box não é passado) em vez de
        uma aba inteira — usado quando várias etapas antigas são reunidas dentro de uma única
        aba (ver _tab_step2, "Data Management", que funde os antigos Steps 2/3/4 —
        Collection/Curation/Exploration — em três grupos lado a lado/empilhados). Sem título de
        página nem linha de navegação própria (o QGroupBox já tem seu título; a navegação é da
        aba, não do grupo). shared_log_box/all_run_buttons: ver _populate_pipeline_body."""
        grp = QGroupBox()
        grp.setStyleSheet(_SS_GROUPBOX_NO_BG)
        self._tr(title_key, grp.setTitle)
        lay = QVBoxLayout(grp)
        lay.setContentsMargins(12, 18, 12, 12); lay.setSpacing(8)

        self._populate_pipeline_body(lay, params_widget, run_fn_getter, worker_key,
                                     log_height, error_parent=grp,
                                     params_min_height=params_min_height,
                                     shared_log_box=shared_log_box,
                                     all_run_buttons=all_run_buttons)
        return grp

    # ══════════════════════════════════════════════════════════════════════
    # TAB 2 — STEP 2: DATA MANAGEMENT (fusão de Collection/Curation/Exploration)
    # ══════════════════════════════════════════════════════════════════════
    def _tab_step2(self):
        """Aba "Data Management" — funde as antigas Steps 2 (Collection), 3 (Curation) e
        4 (Exploration), cada uma antes uma aba própria, em três grupos dentro de UMA
        aba só (ver _grp_data_collection/_grp_data_curation/_grp_data_exploration
        abaixo). Cada grupo mantém seu próprio painel de parâmetros e botões Run/Stop
        independentes (dispara um worker "collect"/"curate"/"explore" diferente), mas o
        Execution Log é ÚNICO para a aba inteira — compartilhado pelos três grupos (ver
        shared_log_box em _populate_pipeline_body) e posicionado uma única vez, fora e
        abaixo de qualquer grupo, mostrando a saída de qualquer um deles que esteja
        rodando no momento; enquanto um grupo roda, os botões Run dos outros dois ficam
        desabilitados (ver all_run_buttons), já que só faz sentido um de cada vez escrever
        no mesmo log. Layout: Data Collection e Data Validation and Curation lado a lado
        (duas colunas); Data Exploration abaixo, ocupando a largura das duas colunas.

        Redimensionamento (mesmo princípio das demais abas via _build_pipeline_tab):
        título fixo no topo, Execution Log/barra de progresso de cada grupo/botões fixos
        na parte inferior — só a grade de grupos, no meio, cresce/encolhe (dentro de um
        QScrollArea próprio) quando a janela muda de tamanho."""
        w = QWidget()
        outer = QVBoxLayout(w); outer.setContentsMargins(0, 0, 0, 0); outer.setSpacing(0)

        # ── Título fixo no topo — FORA de qualquer scroll, não acompanha o redimensionamento ──
        header = QWidget(); hl = QVBoxLayout(header)
        hl.setContentsMargins(30, 16, 30, 8); hl.setSpacing(12)
        hl.addWidget(self._mk_title_tr("title_step2"))
        hl.addWidget(_mk_separator())
        outer.addWidget(header)

        # ── Meio: só a grade de grupos cresce/encolhe (único item com stretch) ──────────────
        scroll = QScrollArea(); scroll.setWidgetResizable(True)
        inner = QWidget(); grid = QGridLayout(inner)
        grid.setContentsMargins(30, 8, 30, 8)
        grid.setHorizontalSpacing(16); grid.setVerticalSpacing(16)

        # Log compartilhado: criado aqui (widget único para os três grupos), mas só
        # adicionado ao layout mais abaixo, no rodapé fixo — fora/abaixo de qualquer grupo.
        shared_log_box = _mk_log_box(240)
        all_run_buttons = []

        grp_collection  = self._grp_data_collection(shared_log_box, all_run_buttons)
        grp_curation    = self._grp_data_curation(shared_log_box, all_run_buttons)
        grp_exploration = self._grp_data_exploration(shared_log_box, all_run_buttons)
        exp_wrap = QWidget(); exp_l = QHBoxLayout(exp_wrap)
        exp_l.setContentsMargins(0, 0, 0, 0); exp_l.setSpacing(0)
        exp_l.addStretch(1); exp_l.addWidget(grp_exploration); exp_l.addStretch(1)
        grid.addWidget(grp_collection,   0, 0)
        grid.addWidget(grp_curation,     0, 1)
        grid.addWidget(exp_wrap,         1, 0, 1, 2)
        grid.setColumnStretch(0, 1)
        grid.setColumnStretch(1, 1)

        scroll.setWidget(self._wrap_scroll_widget(inner))
        outer.addWidget(scroll, 1)   # único widget com stretch — é o que cresce/encolhe

        # ── Rodapé fixo: log compartilhado + navegação — FORA do scroll ─────────────────────
        footer = QWidget(); fl = QVBoxLayout(footer)
        fl.setContentsMargins(30, 8, 30, 0); fl.setSpacing(8)
        fl.addWidget(self._mk_collapsible_log_header(shared_log_box))
        fl.addWidget(shared_log_box)
        outer.addWidget(footer)

        nav = QWidget(); nl = QVBoxLayout(nav); nl.setContentsMargins(8,4,8,8)
        nl.addLayout(self._mk_nav_row_tr(lambda: self.tabs.setCurrentIndex(1),
                                          lambda: self.tabs.setCurrentIndex(3)))
        outer.addWidget(nav)
        return w

    # ── Data Management: grupo "Data Collection" (antiga Step 2 standalone) ──────
    def _grp_data_collection(self, shared_log_box=None, all_run_buttons=None):
        """Grupo "Data Collection" dentro da aba fundida Step2/"Data Management"
        (ver _tab_step2) — conteúdo da antiga Step 2 standalone, agora um QGroupBox."""
        params = QWidget(); pf = QFormLayout(params); pf.setSpacing(10)

        # cb_dataset: nomes técnicos de dataset (identificadores usados literalmente pelo
        # pipeline_collect) — NÃO traduzidos de propósito, ver MODULES/i18n.py.
        self.cb_dataset = QComboBox()
        self.cb_dataset.addItems(["lp-pdbbind", "rcsb-wide", "plinder", "moad"])

        # cb_phase: texto exibido traduzido via _mk_combo_tr; o VALOR usado pela lógica abaixo
        # vem de _COLLECT_PHASE_VALUES[currentIndex()] (dígitos "1"/"2"/"3"/"all", nunca
        # currentText() — que mudaria com o idioma).
        self.cb_phase = self._mk_combo_tr(["s2_phase1", "s2_phase2", "s2_phase3", "s2_phase_all"])
        self._COLLECT_PHASE_VALUES = ["1", "2", "3", "all"]
        self._tr("s2_tooltip_phase", self.cb_phase.setToolTip)

        self.sp_phase1_max = QSpinBox()
        self.sp_phase1_max.setRange(1000, 500000)
        self.sp_phase1_max.setValue(50000)

        self.ed_moad_dir = QLineEdit()
        self._tr("s2_ph_moad_dir", self.ed_moad_dir.setPlaceholderText)
        btn_moad = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        btn_moad.clicked.connect(self._browse_moad_dir)
        moad_row = QWidget(); ml = QHBoxLayout(moad_row); ml.setContentsMargins(0,0,0,0)
        ml.addWidget(self.ed_moad_dir); ml.addWidget(btn_moad)

        self.chk_status = QCheckBox(); self._tr("s2_chk_status", self.chk_status.setText)

        pf.addRow(self._trL("s2_lbl_dataset"), self.cb_dataset)
        pf.addRow(self._trL("s2_lbl_phase"), self.cb_phase)
        pf.addRow(self._trL("s2_lbl_max_entries"), self.sp_phase1_max)
        pf.addRow(self._trL("s2_lbl_moad_dir"), moad_row)
        pf.addRow("",                 self.chk_status)

        def run_fn():
            import MODULES.pipeline_collect as m
            if self.chk_status.isChecked():
                return m.show_status, (), {
                    "job_dir": self.job_dir or None
                }

            root        = self.ed_root.text().strip()
            job_dir     = self.job_dir or root
            phase       = self._COLLECT_PHASE_VALUES[self.cb_phase.currentIndex()]
            dataset     = self.cb_dataset.currentText()
            moad_dir    = self.ed_moad_dir.text().strip()
            phase1_max = self.sp_phase1_max.value()
            org_terms   = self._parse_text_list(self.te_org_terms.toPlainText())
            desc_terms  = self._parse_text_list(self.te_desc_terms.toPlainText())
            p3_ids      = self._parse_csv_ids(self.te_phase3_ids.toPlainText())

            wants_phase1 = phase in ("1", "all")
            wants_phase2 = phase in ("2", "all")
            wants_phase3 = phase in ("3", "all")

            # Validação Phase 2 — termos obrigatórios
            if wants_phase2 and not org_terms and not desc_terms:
                resp = QMessageBox.question(
                    params,
                    i18n.t("s2_dlg_phase2_title", self._idioma),
                    i18n.t("s2_dlg_phase2_body", self._idioma),
                    QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
                )
                if resp != QMessageBox.Yes:
                    raise ValueError(i18n.t("s2_err_phase2_cancelled", self._idioma))
                wants_phase2 = False

            # Validação Phase 3 — IDs obrigatórios
            if wants_phase3 and not p3_ids:
                resp = QMessageBox.question(
                    params,
                    i18n.t("s2_dlg_phase3_title", self._idioma),
                    i18n.t("s2_dlg_phase3_body", self._idioma),
                    QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
                )
                if resp != QMessageBox.Yes:
                    raise ValueError(i18n.t("s2_err_phase3_cancelled", self._idioma))
                wants_phase3 = False

            # Verificação final — pelo menos uma fase ativa após validações
            if not any([wants_phase1, wants_phase2, wants_phase3]):
                raise ValueError(i18n.t("s2_err_no_phase_active", self._idioma))

            return _pipeline_collect, (), dict(
                dataset      = dataset,
                moad_dir     = moad_dir,
                phase1_max   = phase1_max,
                wants_phase1 = wants_phase1,
                wants_phase2 = wants_phase2,
                wants_phase3 = wants_phase3,
                job_dir      = job_dir,
                org_terms    = org_terms,
                desc_terms   = desc_terms,
                p3_ids       = p3_ids,
            )

        return self._build_pipeline_group("s2_grp_title", params, run_fn, "collect",
                                          shared_log_box=shared_log_box,
                                          all_run_buttons=all_run_buttons)

    # ══════════════════════════════════════════════════════════════════════
    # DATA MANAGEMENT — grupo "Data Validation and Curation" (antiga Step 3)
    # ══════════════════════════════════════════════════════════════════════
    def _grp_data_curation(self, shared_log_box=None, all_run_buttons=None):
        """Grupo "Data Validation and Curation" dentro da aba fundida Step2/"Data
        Management" (ver _tab_step2) — conteúdo da antiga Step 3 standalone, agora um
        QGroupBox."""
        params = QWidget(); pf = QFormLayout(params); pf.setSpacing(10)

        self.sp_cur_workers = QSpinBox()
        self.sp_cur_workers.setRange(0,64); self.sp_cur_workers.setValue(0)
        self._tr("s2cur_tooltip_workers", self.sp_cur_workers.setToolTip)
        self.sp_cutoff = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.sp_cutoff.setRange(3.0,12.0); self.sp_cutoff.setValue(6.0)
        self.sp_cutoff.setSingleStep(0.5)
        self.sp_min_site = QSpinBox()
        self.sp_min_site.setRange(1,50); self.sp_min_site.setValue(5)
        self.sp_max_mw = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.sp_max_mw.setRange(100,2000); self.sp_max_mw.setValue(800)
        self.sp_min_heavy = QSpinBox()
        self.sp_min_heavy.setRange(1,30); self.sp_min_heavy.setValue(7)
        self.cb_cur_phase = QComboBox()
        self.cb_cur_phase.addItems(["1", "2", "3"])
        self.chk_cur_thread = QCheckBox("ThreadPoolExecutor")
        self.chk_cur_process = QCheckBox("ProcessPoolExecutor")

        # ProcessPoolExecutor como padrão: Bio.PDB.PDBParser (o trabalho
        # que domina o tempo por par nesta etapa) é Python puro, sem
        # extensão C — presa ao GIL, então ThreadPoolExecutor não
        # paraleliza de verdade essa parte (só a E/S e a busca via
        # cKDTree, que já liberam o GIL sozinhas). Validado nesta sessão:
        # ~2,75 pares/s com 24 threads, bem abaixo do esperado se o
        # gargalo fosse só E/S.
        self.chk_cur_thread.setChecked(False)
        self.chk_cur_process.setChecked(True)

        self.chk_cur_thread.toggled.connect(self._sync_cur_executor_checks)
        self.chk_cur_process.toggled.connect(self._sync_cur_executor_checks)
        
        pf.addRow(self._trL("lbl_phase"), self.cb_cur_phase)
        pf.addRow(self._trL("lbl_workers_auto"),  self.sp_cur_workers)
        pf.addRow(self._trL("s2cur_lbl_cutoff"),     self.sp_cutoff)
        pf.addRow(self._trL("s2cur_lbl_min_site"),   self.sp_min_site)
        pf.addRow(self._trL("s2cur_lbl_max_mw"),     self.sp_max_mw)
        pf.addRow(self._trL("s2cur_lbl_min_heavy"),  self.sp_min_heavy)
        pf.addRow("", self.chk_cur_thread)
        pf.addRow("", self.chk_cur_process)

        def run_fn():
            import MODULES.pipeline_curate as m
            config = dict(m.CURATE_CONFIG)
            config["binding_site_cutoff_A"] = self.sp_cutoff.value()
            config["min_site_residues"] = self.sp_min_site.value()
            config["max_ligand_mw"] = self.sp_max_mw.value()
            config["min_heavy_atoms"] = self.sp_min_heavy.value()

            root = Path(self.ed_root.text().strip())
            job = Path(self.job_dir)
            phase = self.cb_cur_phase.currentText()
            workers = self.sp_cur_workers.value() or None

            if phase == "1":
                input_pdb_dir = root / "data" / "raw" / "pdb"
                output_curated_dir = root / "data" / "curated"
                output_metadata_csv = root / "data" / "curated_metadata.csv"
                output_report_csv = root / "data" / "quality_report.csv"
            elif phase == "2":
                input_pdb_dir = job / "data" / "raw" / "pdb" / "phase2"
                output_curated_dir = job / "data" / "curated" / "phase2"
                output_metadata_csv = job / "data" / "curated" / "phase2_metadata.csv"
                output_report_csv = job / "data" / "curated" / "phase2_quality_report.csv"
            else:
                input_pdb_dir = job / "data" / "raw" / "pdb" / "phase3"
                output_curated_dir = job / "data" / "curated" / "phase3"
                output_metadata_csv = job / "data" / "curated" / "phase3_metadata.csv"
                output_report_csv = job / "data" / "curated" / "phase3_quality_report.csv"
            executor_mode = "process" if self.chk_cur_process.isChecked() else "thread"
            return m.run_curation, (), {
                "config": config,
                "input_pdb_dir": input_pdb_dir,
                "output_curated_dir": output_curated_dir,
                "output_metadata_csv": output_metadata_csv,
                "output_report_csv": output_report_csv,
                "workers": workers,
                "executor_mode": executor_mode,
            }
        
        return self._build_pipeline_group("s2cur_grp_title", params, run_fn, "curate",
                                          shared_log_box=shared_log_box,
                                          all_run_buttons=all_run_buttons)

    # ══════════════════════════════════════════════════════════════════════
    # DATA MANAGEMENT — grupo "Data Exploration" (antiga Step 4)
    # ══════════════════════════════════════════════════════════════════════
    def _grp_data_exploration(self, shared_log_box=None, all_run_buttons=None):
        """Grupo "Data Exploration" dentro da aba fundida Step2/"Data Management"
        (ver _tab_step2) — conteúdo da antiga Step 4 standalone, agora um QGroupBox."""
        grp = QGroupBox()
        grp.setFixedWidth(300)
        grp.setStyleSheet(_SS_GROUPBOX_NO_BG)
        self._tr("s2exp_grp_title", grp.setTitle)
        lay = QVBoxLayout(grp)
        lay.setContentsMargins(12, 18, 12, 12); lay.setSpacing(8)

        params = QWidget(); pf = QVBoxLayout(params)
        pf.setContentsMargins(0, 0, 0, 0)
        pf.setSpacing(8)
        # lbl = self._trL("s2exp_lbl_desc")
        # lbl.setStyleSheet("color:#6E8CA8;font-size:9pt;"); lbl.setWordWrap(True)
        # pf.addWidget(lbl)

        # O próprio botão gera/atualiza o dashboard e em seguida o abre; não há etapa
        # separada de Run/Stop para este grupo.
        self.btn_view_dash = self._mk_btn_tr("s2exp_btn_view_dash", _SS_BTN_SECONDARY, 160)
        self.btn_view_dash.clicked.connect(self._view_explore_dashboard)

        self.cb_explore_phase = QComboBox()
        self.cb_explore_phase.addItems(["1", "2", "3"])
        
        phase_dash_row = QWidget(); dvl = QHBoxLayout(phase_dash_row); dvl.setContentsMargins(0,0,0,0)
        dvl.addWidget(self._trL("lbl_phase")); dvl.addWidget(self.cb_explore_phase); dvl.addWidget(self.btn_view_dash)
        pf.addWidget(phase_dash_row, 0, Qt.AlignmentFlag.AlignLeft)
        lay.addWidget(params)
        return grp

    # ══════════════════════════════════════════════════════════════════════
    # TAB 3 — STEP 3: VOXELIZAÇÃO
    # ══════════════════════════════════════════════════════════════════════
    def _tab_step3(self):
        params = QWidget()
        pv = QVBoxLayout(params)
        pv.setContentsMargins(0, 0, 0, 0)
        pv.setSpacing(0)

        cols = QWidget()
        cl = QHBoxLayout(cols)
        cl.setContentsMargins(0, 0, 0, 0)
        cl.setSpacing(22)

        col_phase = QWidget()
        pf_phase = QFormLayout(col_phase)
        pf_phase.setContentsMargins(0, 0, 0, 0)
        pf_phase.setSpacing(10)

        col_vox = QWidget()
        pf_vox = QFormLayout(col_vox)
        pf_vox.setContentsMargins(0, 0, 0, 0)
        pf_vox.setSpacing(10)

        col_qm = QWidget()
        pf_qm = QFormLayout(col_qm)
        pf_qm.setContentsMargins(0, 0, 0, 0)
        pf_qm.setSpacing(10)

        for col in (col_phase, col_vox, col_qm):
            col.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)

        self.ed_vox_pair = QLineEdit()
        self._tr("s3_ph_pair", self.ed_vox_pair.setPlaceholderText)
        self.sp_vox_workers = QSpinBox()
        self.sp_vox_workers.setRange(0,16); self.sp_vox_workers.setValue(0)
        self._tr("s3_tooltip_vox_workers", self.sp_vox_workers.setToolTip)
        # Desligado por padrão: o ganho é real mas modesto (~15-25%, ver
        # tooltip) e ainda não validado em lote grande — o comportamento
        # sequencial (1 par por vez) continua sendo o caminho testado e
        # recomendado. Quando marcado, sp_vox_workers acima passa a valer
        # de verdade (ver pipeline_voxelize.run: antes disso, um valor
        # >1 ali só emitia um aviso no log e não mudava nada).
        self.chk_vox_parallel_pairs = QCheckBox()
        self._tr("s3_chk_parallel_pairs", self.chk_vox_parallel_pairs.setText)
        self.chk_vox_parallel_pairs.setChecked(False)
        self._tr("s3_tooltip_parallel_pairs", self.chk_vox_parallel_pairs.setToolTip)
        self.sp_grid = QSpinBox()
        self.sp_grid.setRange(16,64); self.sp_grid.setValue(32)
        self.sp_vox_pad = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.sp_vox_pad.setRange(0.5,8.0); self.sp_vox_pad.setValue(3.0)
        self.sp_max_qm = QSpinBox()
        self.sp_max_qm.setRange(10,200); self.sp_max_qm.setValue(60)
        self._tr("s3_tooltip_max_qm", self.sp_max_qm.setToolTip)
        self.sp_vox_batch = QSpinBox()
        self.sp_vox_batch.setRange(10, 2000)
        self.sp_vox_batch.setValue(_BATCH_DEFAULT)
        self.sp_vox_batch.setSingleStep(50)
        # Tooltip com conteúdo dinâmico (preset detectado + status do CuPy) — o texto-modelo
        # (chave) é traduzido normalmente, mas "cupy_status" É ELE MESMO uma string traduzida,
        # então não pode ser um kwarg estático capturado uma vez no registro (ficaria preso no
        # idioma da 1ª chamada); recalculado a cada reaplicação dentro do apply_fn.
        def _apply_vox_batch_tooltip(_txt):
            cupy_key = "s3_cupy_available" if _CUPY_OK else "s3_cupy_unavailable"
            self.sp_vox_batch.setToolTip(i18n.t(
                "s3_tooltip_vox_batch", self._idioma,
                batch=_BATCH_DEFAULT, cupy_status=i18n.t(cupy_key, self._idioma),
            ))
        self._tr("s3_tooltip_vox_batch", _apply_vox_batch_tooltip)
        self.cb_qm_basis = QComboBox()
        self.cb_qm_basis.addItems(["sto-3g","3-21g","6-31g"])
        self._tr("s3_tooltip_qm_basis", self.cb_qm_basis.setToolTip)
        self.chk_ecfp4 = QCheckBox(); self._tr("s3_chk_ecfp4", self.chk_ecfp4.setText)
        self.cb_vox_phase = QComboBox()
        self.cb_vox_phase.addItems(["1", "2", "3"])

        # ── Protonação do sítio + método QM dos canais 3-4 (doador/aceptor) ──
        self.chk_protonate_site = QCheckBox()
        self._tr("s3_chk_protonate_site", self.chk_protonate_site.setText)
        self.chk_protonate_site.setChecked(True)
        self._tr("s3_tooltip_protonate_site", self.chk_protonate_site.setToolTip)
        self.dsb_site_ph = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_site_ph.setDecimals(1); self.dsb_site_ph.setRange(0.0, 14.0)
        self.dsb_site_ph.setValue(7.4); self.dsb_site_ph.setSingleStep(0.5)
        self._tr("s3_tooltip_site_ph", self.dsb_site_ph.setToolTip)
        self.cb_site_qm_method = self._mk_combo_tr(
            ["qm_method_rhf_fragments", "qm_method_gfn_xtb_fragments",
             "qm_method_heuristic"]
        )
        self._tr("s3_tooltip_site_qm_method", self.cb_site_qm_method.setToolTip)
        self._SITE_QM_METHOD_VALUES = [
            "rhf_sto3g_fragments", "gfn_xtb_fragments", "heuristic",
        ]

        pf_phase.addRow(self._trL("lbl_phase"), self.cb_vox_phase)
        pf_phase.addRow(self._trL("s3_lbl_pair"), self.ed_vox_pair)
        pf_phase.addRow(self._trL("lbl_workers_auto"), self.sp_vox_workers)
        pf_phase.addRow("", self.chk_vox_parallel_pairs)

        pf_vox.addRow(self._trL("s3_lbl_grid"), self.sp_grid)
        pf_vox.addRow(self._trL("s3_lbl_padding"), self.sp_vox_pad)
        pf_vox.addRow(self._trL("s3_lbl_max_qm"), self.sp_max_qm)
        pf_vox.addRow(self._trL("s3_lbl_batch"), self.sp_vox_batch)

        pf_qm.addRow(self._trL("s3_lbl_qm_basis"), self.cb_qm_basis)
        pf_qm.addRow("", self.chk_ecfp4)
        pf_qm.addRow("", self.chk_protonate_site)
        pf_qm.addRow(self._trL("s3_lbl_site_ph"), self.dsb_site_ph)
        pf_qm.addRow(self._trL("s3_lbl_site_qm_method"), self.cb_site_qm_method)

        cl.addWidget(col_phase, 1)
        cl.addWidget(col_vox, 1)
        cl.addWidget(col_qm, 1)
        cl.setStretch(0, 1)
        cl.setStretch(1, 1)
        cl.setStretch(2, 1)
        pv.addWidget(cols)

        def run_fn():
            import MODULES.pipeline_voxelize as m
            import types

            config = dict(m.VOXEL_CONFIG)
            config["grid_size"] = self.sp_grid.value()
            config["padding_A"] = self.sp_vox_pad.value()
            config["max_qm_atoms"] = self.sp_max_qm.value()
            config["vox_batch"]    = self.sp_vox_batch.value()
            config["qm_basis"] = self.cb_qm_basis.currentText()
            config["use_ecfp4"] = self.chk_ecfp4.isChecked()
            config["protonate_site"] = self.chk_protonate_site.isChecked()
            config["ph"] = self.dsb_site_ph.value()
            config["site_qm_method"] = self._SITE_QM_METHOD_VALUES[
                self.cb_site_qm_method.currentIndex()
            ]

            root = Path(self.ed_root.text().strip())
            job = Path(self.job_dir)
            phase = self.cb_vox_phase.currentText()

            if phase == "1":
                curated_dir = root / "data" / "curated"
                tensor_dir  = root / "data" / "tensors"
                log_dir     = root / "data" / "logs"
            elif phase == "2":
                curated_dir = job / "data" / "curated" / "phase2"
                tensor_dir  = job / "data" / "tensors" / "phase2"
                log_dir     = job / "data" / "logs" / "phase2"
            else:
                curated_dir = job / "data" / "curated" / "phase3"
                tensor_dir  = job / "data" / "tensors" / "phase3"
                log_dir     = job / "data" / "logs" / "phase3"

            config["log_dir"] = str(log_dir)

            # workers só é repassado de verdade (viabilizando paralelismo
            # entre pares) se o checkbox estiver marcado — desmarcado,
            # sempre None (sequencial), independente do valor do spinbox.
            args_ns = types.SimpleNamespace(
                pair=self.ed_vox_pair.text().strip() or None,
                workers=(self.sp_vox_workers.value() or None)
                        if self.chk_vox_parallel_pairs.isChecked() else None,
            )

            return m.run, (args_ns,), {
                "curated_dir": curated_dir,
                "tensor_dir": tensor_dir,
                "config": config,
            }
        return self._build_pipeline_tab(
            "title_step3",
            params, run_fn, "voxelize", 2, 4
        )

    # ══════════════════════════════════════════════════════════════════════
    # TAB 6 — STEP 6: OTIMIZAÇÃO DE HIPERPARÂMETROS
    # ══════════════════════════════════════════════════════════════════════
    def _tab_step4(self):
        """Busca de hiperparâmetros (Optuna) — ver MODULES/pipeline_optimize.py.

        O espaço de busca não é escrito à mão aqui: vem de
        pipeline_optimize.SEARCH_SPACE_SPEC, que é a mesma fonte usada pela
        linha de comando. Acrescentar um hiperparâmetro lá faz a linha
        aparecer aqui sozinha, sem tocar na interface.
        """
        import MODULES.pipeline_optimize as opt

        params = QWidget()
        outer  = QVBoxLayout(params); outer.setSpacing(10)

        # ── Orçamento da busca ────────────────────────────────────────────
        grp_budget = QGroupBox(); grp_budget.setStyleSheet(_SS_GROUPBOX_NO_BG)
        self._tr("s4_grp_budget", grp_budget.setTitle)
        bv = QVBoxLayout(grp_budget); bv.setSpacing(8)

        # Algoritmo de busca (sampler). Fica em linha própria acima das três
        # colunas por ser o controle mestre do grupo — e porque o Grid Search
        # muda o significado de "Trials" (vira o teto da grade, não o nº de
        # amostras). Os rótulos vêm de pipeline_optimize.SAMPLERS; o VALOR
        # usado pela lógica é SAMPLERS[currentIndex()]["name"], nunca o texto.
        self.cb_opt_sampler = QComboBox()
        for s in opt.SAMPLERS:
            self.cb_opt_sampler.addItem(s["label"])
        self.cb_opt_sampler.setCurrentIndex(
            [s["name"] for s in opt.SAMPLERS].index(opt.DEFAULT_SAMPLER))
        self._tr("s4_tooltip_sampler", self.cb_opt_sampler.setToolTip)
        for i, s in enumerate(opt.SAMPLERS):
            self.cb_opt_sampler.setItemData(i, s["help"], Qt.ToolTipRole)

        row_sampler = QWidget()
        rs = QHBoxLayout(row_sampler); rs.setContentsMargins(0,0,0,0); rs.setSpacing(8)
        rs.addWidget(self._trL("s4_lbl_sampler"))
        rs.addWidget(self.cb_opt_sampler, 1)
        rs.addStretch(2)
        bv.addWidget(row_sampler)

        self.cb_opt_phase = QComboBox(); self.cb_opt_phase.addItems(["1", "2", "3"])

        self.sp_opt_trials = QSpinBox()
        self.sp_opt_trials.setRange(2, 10000); self.sp_opt_trials.setValue(40)
        self.sp_opt_epochs = QSpinBox()
        self.sp_opt_epochs.setRange(1, 500);   self.sp_opt_epochs.setValue(15)
        self.dsb_opt_subset = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_opt_subset.setDecimals(2); self.dsb_opt_subset.setRange(0.01, 1.0)
        self.dsb_opt_subset.setSingleStep(0.05); self.dsb_opt_subset.setValue(0.20)
        self.sp_opt_seed = QSpinBox()
        self.sp_opt_seed.setRange(0, 10 ** 6); self.sp_opt_seed.setValue(42)
        self.sp_opt_min_resource = QSpinBox()
        self.sp_opt_min_resource.setRange(1, 100); self.sp_opt_min_resource.setValue(3)
        self.sp_opt_reduction = QSpinBox()
        self.sp_opt_reduction.setRange(2, 10); self.sp_opt_reduction.setValue(3)
        self.cb_opt_device = QComboBox()
        self.cb_opt_device.addItems(["cuda", "cpu", "cuda:0", "cuda:1"])
        self.cb_opt_device.setCurrentText(_DEVICE_DEFAULT)
        self.ed_opt_study = QLineEdit("codeep_hpo")

        self.ed_opt_resume = QLineEdit(); self.ed_opt_resume.setReadOnly(True)
        self._tr("s4_ph_resume", self.ed_opt_resume.setPlaceholderText)
        btn_opt_resume = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        btn_opt_resume.clicked.connect(self._browse_opt_resume)
        row_resume = QWidget(); rr = QHBoxLayout(row_resume); rr.setContentsMargins(0,0,0,0)
        rr.addWidget(self.ed_opt_resume); rr.addWidget(btn_opt_resume)

        self.chk_opt_freeze_enc = QCheckBox()
        self._tr("s4_chk_freeze_enc", self.chk_opt_freeze_enc.setText)
        self.chk_opt_keep_ckpts = QCheckBox()
        self._tr("s4_chk_keep_ckpts", self.chk_opt_keep_ckpts.setText)

        self.ed_opt_out = QLineEdit(); self.ed_opt_out.setReadOnly(True)
        self.ed_opt_out.setPlaceholderText("hpo/")
        btn_opt_out = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        btn_opt_out.clicked.connect(self._browse_opt_out)
        row_out = QWidget(); ro = QHBoxLayout(row_out); ro.setContentsMargins(0,0,0,0)
        ro.addWidget(self.ed_opt_out); ro.addWidget(btn_opt_out)

        # Os nove campos escalares em três colunas lado a lado, preenchidas
        # por coluna: quantidade da busca | dados e poda | reprodutibilidade
        # e execução. Os campos largos (retomar de / pasta de saída) e os
        # checkboxes seguem em linhas de largura total abaixo — espremê-los
        # numa coluna de um terço deixaria o caminho ilegível.
        cols_budget = QWidget()
        bl = QHBoxLayout(cols_budget)
        bl.setContentsMargins(0, 0, 0, 0); bl.setSpacing(22)

        for grupo in (
            [("s4_lbl_phase",        self.cb_opt_phase),
             ("s4_lbl_n_trials",     self.sp_opt_trials),
             ("s4_lbl_trial_epochs", self.sp_opt_epochs)],
            [("s4_lbl_subset",       self.dsb_opt_subset),
             ("s4_lbl_min_resource", self.sp_opt_min_resource),
             ("s4_lbl_reduction",    self.sp_opt_reduction)],
            [("s4_lbl_seed",         self.sp_opt_seed),
             ("s4_lbl_device",       self.cb_opt_device),
             ("s4_lbl_study",        self.ed_opt_study)],
        ):
            col_w = QWidget()
            cf = QFormLayout(col_w)
            cf.setContentsMargins(0, 0, 0, 0); cf.setSpacing(8)
            cf.setFieldGrowthPolicy(QFormLayout.AllNonFixedFieldsGrow)
            for label_key, widget in grupo:
                widget.setMinimumWidth(105)
                cf.addRow(self._trL(label_key), widget)
            bl.addWidget(col_w, 1)

        bv.addWidget(cols_budget)

        bf = QFormLayout(); bf.setSpacing(8)
        for label_key, widget in [
            ("s4_lbl_resume",  row_resume),
            (None,             self.chk_opt_freeze_enc),
            (None,             self.chk_opt_keep_ckpts),
            ("s4_lbl_out_dir", row_out),
        ]:
            bf.addRow(self._trL(label_key) if label_key else "", widget)
        bv.addLayout(bf)
        outer.addWidget(grp_budget)

        # ── Espaço de busca ───────────────────────────────────────────────
        grp_space = QGroupBox(); grp_space.setStyleSheet(_SS_GROUPBOX_NO_BG)
        self._tr("s4_grp_space", grp_space.setTitle)
        sv = QVBoxLayout(grp_space); sv.setSpacing(6)

        note = self._trL("s4_note_space")
        note.setWordWrap(True); note.setStyleSheet("color:#6E8CA8;font-size:9pt;")
        sv.addWidget(note)

        #: {nome do hiperparâmetro: (checkbox, caixa de texto)} — consumido
        #: por run_fn e pelos botões de seleção em massa.
        self._opt_param_widgets: dict = {}

        # Três colunas lado a lado, uma por prioridade. Os grupos têm 4
        # hiperparâmetros cada, então as colunas ficam do mesmo tamanho e a
        # prioridade — que decide o que vem marcado por padrão — passa a ser
        # lida na horizontal, sem rolagem.
        cols_row = QWidget()
        cl = QHBoxLayout(cols_row)
        cl.setContentsMargins(0, 4, 0, 0); cl.setSpacing(22)

        for prio, prio_key in (("high",   "s4_prio_high"),
                               ("medium", "s4_prio_medium"),
                               ("low",    "s4_prio_low")):
            col_w = QWidget()
            cv = QVBoxLayout(col_w)
            cv.setContentsMargins(0, 0, 0, 0); cv.setSpacing(4)

            hdr = self._trL(prio_key)
            hdr.setStyleSheet("font-weight:bold;font-size:9pt;color:#C9D1D9;")
            cv.addWidget(hdr)

            hdr_row = QWidget()
            hl = QHBoxLayout(hdr_row); hl.setContentsMargins(0,0,0,0); hl.setSpacing(8)
            for hdr_key, stretch in (("s4_hdr_param", 1), ("s4_hdr_range", 1)):
                h = self._trL(hdr_key)
                h.setStyleSheet("font-size:8pt;color:#6E8CA8;")
                hl.addWidget(h, stretch)
            cv.addWidget(hdr_row)

            grid = QGridLayout()
            grid.setHorizontalSpacing(8); grid.setVerticalSpacing(4)
            grid.setColumnStretch(1, 1)
            r = 0
            for spec in opt.SEARCH_SPACE_SPEC:
                if spec["priority"] != prio:
                    continue
                name = spec["name"]
                chk = QCheckBox(name)
                chk.setToolTip(spec["help"])
                chk.setChecked(name in opt.DEFAULT_SELECTED)

                ed = QLineEdit(opt.format_default(name))
                ed.setToolTip(spec["help"])
                ed.setEnabled(chk.isChecked())
                # Caixa estreita: com três colunas lado a lado, deixá-la
                # crescer livremente espremeria as colunas vizinhas.
                ed.setMinimumWidth(105)
                # A caixa só é editável com o checkbox marcado: um valor
                # digitado num parâmetro não selecionado seria ignorado
                # silenciosamente, que é pior do que não deixar digitar.
                chk.toggled.connect(ed.setEnabled)

                # Marcar/desmarcar um parâmetro de beta muda quais objetivos
                # são admissíveis — ver _opt_update_objective_state.
                if name in opt.BETA_PARAMS:
                    chk.toggled.connect(self._opt_update_objective_state)

                setattr(self, f"chk_opt_{name}", chk)
                setattr(self, f"ed_opt_{name}",  ed)
                self._opt_param_widgets[name] = (chk, ed)

                grid.addWidget(chk, r, 0)
                grid.addWidget(ed,  r, 1)
                r += 1

            cv.addLayout(grid)
            cv.addStretch()
            cl.addWidget(col_w, 1)

        sv.addWidget(cols_row)

        # ── Objetivo ──────────────────────────────────────────────────────
        # val_total só é admissível com beta FIXO. Se beta_max ou beta_warmup
        # estiverem marcados, a opção é desabilitada e a seleção volta para
        # val_recon — proibir na interface é melhor que aceitar e depois
        # sobrescrever silenciosamente no meio do log.
        self.cb_opt_objective = QComboBox()
        for m in opt.OBJECTIVE_METRICS:
            self.cb_opt_objective.addItem(m["label"])
        for i, m in enumerate(opt.OBJECTIVE_METRICS):
            self.cb_opt_objective.setItemData(i, m["help"], Qt.ToolTipRole)
        self.cb_opt_objective.setCurrentIndex(
            [m["name"] for m in opt.OBJECTIVE_METRICS].index(opt.DEFAULT_OBJECTIVE))
        self._tr("s4_tooltip_objective", self.cb_opt_objective.setToolTip)

        self.lbl_opt_objective_forced = QLabel()
        self.lbl_opt_objective_forced.setStyleSheet(
            "color:#E3B341;font-size:9pt;")

        row_obj = QWidget()
        rb = QHBoxLayout(row_obj); rb.setContentsMargins(0,8,0,0); rb.setSpacing(8)
        rb.addWidget(self._trL("s4_lbl_objective"))
        rb.addWidget(self.cb_opt_objective)
        rb.addWidget(self.lbl_opt_objective_forced, 1)
        rb.addStretch()
        sv.addWidget(row_obj)
        self._tr("s4_note_objective_forced",
                 lambda _t: self._opt_update_objective_state())
        self._opt_update_objective_state()

        sel_row = QWidget(); sl = QHBoxLayout(sel_row); sl.setContentsMargins(0,6,0,0)
        btn_all  = self._mk_btn_tr("s4_btn_select_all",     _SS_BTN_SECONDARY, 130)
        btn_def  = self._mk_btn_tr("s4_btn_select_default", _SS_BTN_SECONDARY, 150)
        btn_none = self._mk_btn_tr("s4_btn_select_none",    _SS_BTN_SECONDARY, 130)
        btn_all.clicked.connect(lambda: self._opt_select("all"))
        btn_def.clicked.connect(lambda: self._opt_select("default"))
        btn_none.clicked.connect(lambda: self._opt_select("none"))
        sl.addWidget(btn_all); sl.addWidget(btn_def); sl.addWidget(btn_none)
        sl.addStretch()
        btn_disk = self._mk_btn_tr("s4_btn_check_disk", _SS_BTN_SECONDARY, 190)
        btn_disk.clicked.connect(self._opt_check_disk)
        sl.addWidget(btn_disk)
        sv.addWidget(sel_row)

        lbl_obj = self._trL("s4_note_objective")
        lbl_obj.setWordWrap(True)
        lbl_obj.setStyleSheet("color:#6E8CA8;font-size:9pt;margin-top:4px;")
        sv.addWidget(lbl_obj)

        # Aviso de fidelidade: NÃO é fixo. Com fração do dataset e épocas por
        # trial altas o bastante, cada trial vira um treino completo e a busca
        # deixa de ser um proxy — dizer "triagem barata" ali seria falso.
        self.lbl_opt_fidelity = QLabel()
        self.lbl_opt_fidelity.setWordWrap(True)
        sv.addWidget(self.lbl_opt_fidelity)
        self.dsb_opt_subset.valueChanged.connect(self._opt_update_fidelity_note)
        self.sp_opt_epochs.valueChanged.connect(self._opt_update_fidelity_note)
        # Refaz o texto também numa troca de idioma.
        self._tr("s4_note_screen", lambda _t: self._opt_update_fidelity_note())
        self._opt_update_fidelity_note()

        outer.addWidget(grp_space)

        def run_fn():
            import MODULES.pipeline_optimize as m

            # O Optuna é opcional no catálogo de dependências — sem esta
            # checagem o erro só apareceria como ImportError no meio do log
            # do processo filho, depois de o usuário já ter clicado em Rodar.
            if importlib.util.find_spec("optuna") is None:
                raise ValueError(i18n.t("s4_err_optuna_missing", self._idioma))

            root = Path(self.ed_root.text().strip())
            job  = Path(self.job_dir) if self.job_dir else root
            phase = self.cb_opt_phase.currentText()

            if phase == "1":
                tensor_dir = root / "data" / "tensors"
                default_out = root / "hpo" / "phase1"
            elif phase == "2":
                tensor_dir = job / "data" / "tensors" / "phase2"
                default_out = job / "hpo" / "phase2"
            else:
                tensor_dir = job / "data" / "tensors" / "phase3"
                default_out = job / "hpo" / "phase3"

            if not (tensor_dir / "tensor_index.csv").exists():
                raise ValueError(i18n.t(
                    "s4_err_tensor_not_found", self._idioma,
                    phase=phase, tensor_dir=tensor_dir))

            selected = self._opt_selected_texts()
            if not selected:
                # Mensagem traduzida: build_search_space também barra o caso,
                # mas a exceção dele é só em português (é módulo de pipeline).
                raise ValueError(i18n.t("s4_err_no_params", self._idioma))
            space = m.build_search_space(selected)
            out_dir = Path(self.ed_opt_out.text().strip() or default_out)

            # Estimativa de disco ANTES de gastar horas de GPU. Se não couber,
            # o usuário decide: seguir mesmo assim ou cancelar.
            disk = m.check_disk_space(
                out_dir, space,
                self.sp_opt_trials.value(), self.sp_opt_epochs.value(),
                self.chk_opt_keep_ckpts.isChecked(),
            )
            if not disk["ok"]:
                resp = QMessageBox.warning(
                    self, i18n.t("s4_dlg_disk_title", self._idioma),
                    disk["message"] + i18n.t("s4_dlg_disk_question", self._idioma),
                    QMessageBox.Yes | QMessageBox.No, QMessageBox.No,
                )
                if resp != QMessageBox.Yes:
                    return None      # cancelado — _build_pipeline_tab entende

            return m.optimize, (), dict(
                tensor_dir=str(tensor_dir),
                out_dir=str(out_dir),
                search_space=space,
                n_trials=self.sp_opt_trials.value(),
                trial_epochs=self.sp_opt_epochs.value(),
                subset_frac=self.dsb_opt_subset.value(),
                seed=self.sp_opt_seed.value(),
                sampler=self._opt_selected_sampler(),
                objective_metric=self._opt_selected_objective(),
                pruner_min_resource=self.sp_opt_min_resource.value(),
                pruner_reduction_factor=self.sp_opt_reduction.value(),
                study_name=self.ed_opt_study.text().strip() or "codeep_hpo",
                device=self.cb_opt_device.currentText(),
                keep_all_checkpoints=self.chk_opt_keep_ckpts.isChecked(),
                resume=self.ed_opt_resume.text().strip() or None,
                freeze_encoder=self.chk_opt_freeze_enc.isChecked(),
                skip_disk_check=True,    # já verificado (e confirmado) acima
            )

        return self._build_pipeline_tab(
            "title_step4",
            params, run_fn, "optimize", 3, 5, log_height=300
        )

    # ── Auxiliares da Etapa 4 ─────────────────────────────────────────────
    def _opt_selected_texts(self) -> dict:
        """{nome: texto da faixa} apenas dos hiperparâmetros marcados."""
        return {name: ed.text().strip()
                for name, (chk, ed) in self._opt_param_widgets.items()
                if chk.isChecked()}

    def _opt_select(self, mode: str):
        """Marca todos / restaura o padrão (alta+média) / desmarca todos."""
        import MODULES.pipeline_optimize as opt
        for name, (chk, ed) in self._opt_param_widgets.items():
            if mode == "all":
                chk.setChecked(True)
            elif mode == "none":
                chk.setChecked(False)
            else:
                chk.setChecked(name in opt.DEFAULT_SELECTED)
                ed.setText(opt.format_default(name))

    def _opt_update_objective_state(self):
        """Habilita/desabilita val_total conforme beta esteja ou não na busca.

        `total = recon + beta·KL`: se beta varia entre trials, comparar total
        premia quem sorteou beta menor, não quem reconstruiu melhor. Nesse
        caso val_total deixa de ser uma escolha válida e a seleção é forçada
        de volta para val_recon.
        """
        cb = getattr(self, "cb_opt_objective", None)
        if cb is None:
            return
        import MODULES.pipeline_optimize as opt

        forced = any(self._opt_param_widgets[n][0].isChecked()
                     for n in opt.BETA_PARAMS
                     if n in self._opt_param_widgets)

        names = [m["name"] for m in opt.OBJECTIVE_METRICS]
        i_total = names.index("total")
        i_recon = names.index("recon")

        # Item desabilitado dentro do combo: continua visível (o usuário vê
        # que a opção existe e por que está bloqueada), mas não selecionável.
        modelo = cb.model()
        item = modelo.item(i_total)
        if item is not None:
            item.setEnabled(not forced)
        if forced and cb.currentIndex() == i_total:
            cb.setCurrentIndex(i_recon)

        self.lbl_opt_objective_forced.setText(
            i18n.t("s4_note_objective_forced", self._idioma) if forced else "")

    def _opt_selected_objective(self) -> str:
        """Nome interno ('recon'/'total') do objetivo escolhido no combo."""
        import MODULES.pipeline_optimize as opt
        return opt.OBJECTIVE_METRICS[
            self.cb_opt_objective.currentIndex()]["name"]

    def _opt_selected_sampler(self) -> str:
        """Nome interno do algoritmo de busca escolhido no combo."""
        import MODULES.pipeline_optimize as opt
        return opt.SAMPLERS[self.cb_opt_sampler.currentIndex()]["name"]

    def _opt_update_fidelity_note(self):
        """Troca o aviso da Etapa 4 conforme o orçamento escolhido.

        A classificação vive em pipeline_optimize.fidelity_report(), a mesma
        que o log da busca usa — interface e log nunca discordam.
        """
        lbl = getattr(self, "lbl_opt_fidelity", None)
        if lbl is None:
            return
        import MODULES.pipeline_optimize as opt
        level = opt.fidelity_report(self.dsb_opt_subset.value(),
                                    self.sp_opt_epochs.value())["level"]
        key = {"screen":    "s4_note_screen",
               "near_full": "s4_note_near_full",
               "full":      "s4_note_full"}[level]
        lbl.setText(i18n.t(key, self._idioma))
        # Orçamento total merece destaque: é o caso em que o usuário pode
        # gastar semanas de GPU sem perceber.
        lbl.setStyleSheet(
            "color:#E3B341;font-size:9pt;margin-top:4px;" if level == "full"
            else "color:#6E8CA8;font-size:9pt;margin-top:4px;"
        )

    def _opt_check_disk(self):
        """Mostra a estimativa de espaço sem iniciar a busca."""
        import MODULES.pipeline_optimize as opt
        try:
            space = opt.build_search_space(self._opt_selected_texts())
        except ValueError as e:
            QMessageBox.critical(
                self, i18n.t("msg_config_error_title", self._idioma), str(e))
            return

        root = Path(self.ed_root.text().strip() or self.dp_dir)
        out_dir = Path(self.ed_opt_out.text().strip() or root / "hpo")
        disk = opt.check_disk_space(
            out_dir, space,
            self.sp_opt_trials.value(), self.sp_opt_epochs.value(),
            self.chk_opt_keep_ckpts.isChecked(),
        )
        box = QMessageBox(self)
        box.setWindowTitle(i18n.t("s4_dlg_disk_title", self._idioma))
        box.setIcon(QMessageBox.Information if disk["ok"] else QMessageBox.Warning)
        box.setText(disk["message"])
        box.exec_()

    def _browse_opt_resume(self):
        p, _ = QFileDialog.getOpenFileName(
            self, i18n.t("s5_dlg_select_best_model", self._idioma),
            self.ed_root.text(), "PyTorch (*.pt)")
        if p: self.ed_opt_resume.setText(p)

    def _browse_opt_out(self):
        d = QFileDialog.getExistingDirectory(
            self, i18n.t("s4_dlg_out_dir", self._idioma), self.ed_root.text())
        if d: self.ed_opt_out.setText(d)

    # ══════════════════════════════════════════════════════════════════════
    # TAB 7 — STEP 7: TREINAMENTO
    # ══════════════════════════════════════════════════════════════════════
    def _tab_step5(self):
        # Layout em TRES COLUNAS alinhadas, mesmo padrao da Etapa 3: de Phase
        # ate Device os campos sao escalares curtos e cabem lado a lado, o que
        # evita a coluna unica de 17 linhas que obrigava a rolar o painel.
        # Os campos largos (Retomar de / Salvar checkpoint em) e o checkbox de
        # congelar encoder ficam abaixo, em largura total: um caminho de
        # arquivo espremido em um terco da largura fica ilegivel.
        params = QWidget()
        pv = QVBoxLayout(params)
        pv.setContentsMargins(0, 0, 0, 0)
        pv.setSpacing(10)

        cols = QWidget()
        cl3 = QHBoxLayout(cols)
        cl3.setContentsMargins(0, 0, 0, 0)
        cl3.setSpacing(22)

        col_cap = QWidget()
        pf_cap = QFormLayout(col_cap)
        pf_cap.setContentsMargins(0, 0, 0, 0); pf_cap.setSpacing(10)

        col_opt = QWidget()
        pf_opt = QFormLayout(col_opt)
        pf_opt.setContentsMargins(0, 0, 0, 0); pf_opt.setSpacing(10)

        col_reg = QWidget()
        pf_reg = QFormLayout(col_reg)
        pf_reg.setContentsMargins(0, 0, 0, 0); pf_reg.setSpacing(10)

        for _c in (col_cap, col_opt, col_reg):
            _c.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
            cl3.addWidget(_c)
        pv.addWidget(cols)

        pf = QFormLayout()          # cauda de largura total
        pf.setSpacing(8)
        pv.addLayout(pf)

        self.cb_train_phase = QComboBox()
        self.cb_train_phase.addItems(["1", "2", "3"])
        # Defaults revisados nesta sessão: os valores antigos (epochs=100,
        # batch=8, latent/hidden=128, gnn_layers=3, dropout=0.35) foram
        # calibrados para um dataset de <1000 pares (ver comentário em
        # SiteEncoder — "Arquitetura reduzida para datasets pequenos").
        # O dataset curado atual tem >33.000 pares utilizáveis e a GPU
        # (RTX 4080 Super, 16GB) tem folga enorme para um modelo desse
        # tamanho (~1,8-2,4M parâmetros) — não há mais razão para manter a
        # capacidade/regularização reduzidas. latent_dim/hidden_dim/
        # n_gnn_layers/dropout voltam para os defaults de fábrica das
        # próprias classes (SiteEncoder/GNNDecoder/LigandCVAE).
        self.sp_epochs     = QSpinBox(); self.sp_epochs.setRange(1,5000); self.sp_epochs.setValue(150)
        self.sp_batch      = QSpinBox(); self.sp_batch.setRange(1,512);   self.sp_batch.setValue(32)
        self.sp_latent     = QSpinBox(); self.sp_latent.setRange(2,1024); self.sp_latent.setValue(256)
        self.sp_hidden     = QSpinBox(); self.sp_hidden.setRange(16,4096);self.sp_hidden.setValue(256)
        self.sp_gnn_layers = QSpinBox(); self.sp_gnn_layers.setRange(1,12);self.sp_gnn_layers.setValue(4)
        self.dsb_lr        = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_lr.setDecimals(6); self.dsb_lr.setRange(1e-6,1.0); self.dsb_lr.setValue(4e-4)
        self.dsb_beta      = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_beta.setDecimals(3); self.dsb_beta.setRange(0,10); self.dsb_beta.setValue(0.5)
        self.sp_warmup     = QSpinBox(); self.sp_warmup.setRange(1,500); self.sp_warmup.setValue(30)
        # Pesos das cabeças da loss e regularização/estabilidade do otimizador.
        # Defaults idênticos aos de pipeline_train.train() — mudar um lado sem
        # o outro faria a interface mentir sobre o que o treino vai usar.
        self.dsb_pos_weight = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_pos_weight.setDecimals(2); self.dsb_pos_weight.setRange(0.0, 20.0)
        self.dsb_pos_weight.setSingleStep(0.25); self.dsb_pos_weight.setValue(2.00)
        self._tr("s5_tooltip_pos_weight", self.dsb_pos_weight.setToolTip)
        self.dsb_stop_weight = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_stop_weight.setDecimals(2); self.dsb_stop_weight.setRange(0.0, 20.0)
        self.dsb_stop_weight.setSingleStep(0.25); self.dsb_stop_weight.setValue(1.00)
        self._tr("s5_tooltip_stop_weight", self.dsb_stop_weight.setToolTip)
        self.dsb_focal_weight = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_focal_weight.setDecimals(2); self.dsb_focal_weight.setRange(0.0, 20.0)
        self.dsb_focal_weight.setSingleStep(0.25); self.dsb_focal_weight.setValue(1.00)
        self._tr("s5_tooltip_focal_weight", self.dsb_focal_weight.setToolTip)
        self.dsb_dropout   = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_dropout.setDecimals(2); self.dsb_dropout.setRange(0,0.9); self.dsb_dropout.setValue(0.20)
        self.dsb_weight_decay = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_weight_decay.setDecimals(6); self.dsb_weight_decay.setRange(0.0, 1.0)
        self.dsb_weight_decay.setSingleStep(1e-5); self.dsb_weight_decay.setValue(1e-4)
        self._tr("s5_tooltip_weight_decay", self.dsb_weight_decay.setToolTip)
        self.dsb_grad_clip = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_grad_clip.setDecimals(2); self.dsb_grad_clip.setRange(0.01, 100.0)
        self.dsb_grad_clip.setSingleStep(0.1); self.dsb_grad_clip.setValue(0.50)
        self._tr("s5_tooltip_grad_clip", self.dsb_grad_clip.setToolTip)
        self.sp_patience   = QSpinBox(); self.sp_patience.setRange(1,500); self.sp_patience.setValue(15)
        self.cb_train_device = QComboBox()
        self.cb_train_device.addItems(["cuda","cpu","cuda:0","cuda:1"])
        self.cb_train_device.setCurrentText(_DEVICE_DEFAULT)

        # Campo para retomada de treino / fine-tuning
        self.ed_resume = QLineEdit(); self._tr("s5_ph_resume", self.ed_resume.setPlaceholderText)
        self.ed_resume.setReadOnly(True)
        btn_resume = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        resume_row = QWidget(); rl = QHBoxLayout(resume_row); rl.setContentsMargins(0,0,0,0)
        rl.addWidget(self.ed_resume); rl.addWidget(btn_resume)
        btn_resume.clicked.connect(self._browse_resume)
        self.chk_freeze_enc = QCheckBox(); self._tr("s5_chk_freeze_enc", self.chk_freeze_enc.setText)

        self.ed_ckpt_out = QLineEdit(); self.ed_ckpt_out.setPlaceholderText("checkpoints/")
        self.ed_ckpt_out.setReadOnly(True)
        btn_ckpt = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        ckpt_row = QWidget(); cl = QHBoxLayout(ckpt_row); cl.setContentsMargins(0,0,0,0)
        cl.addWidget(self.ed_ckpt_out); cl.addWidget(btn_ckpt)
        btn_ckpt.clicked.connect(self._browse_ckpt_out)

        # Agrupamento por natureza: capacidade do modelo | otimizacao e
        # pesos da perda | regularizacao e execucao.
        for _form, _linhas in (
            (pf_cap, [("lbl_phase",           self.cb_train_phase),
                      ("s5_lbl_epochs",       self.sp_epochs),
                      ("s5_lbl_batch",        self.sp_batch),
                      ("s5_lbl_latent",       self.sp_latent),
                      ("s5_lbl_hidden",       self.sp_hidden),
                      ("s5_lbl_gnn_layers",   self.sp_gnn_layers)]),
            (pf_opt, [("s5_lbl_lr",           self.dsb_lr),
                      ("s5_lbl_beta_max",     self.dsb_beta),
                      ("s5_lbl_beta_warmup",  self.sp_warmup),
                      ("s5_lbl_pos_weight",   self.dsb_pos_weight),
                      ("s5_lbl_stop_weight",  self.dsb_stop_weight),
                      ("s5_lbl_focal_weight", self.dsb_focal_weight)]),
            (pf_reg, [("s5_lbl_dropout",      self.dsb_dropout),
                      ("s5_lbl_weight_decay", self.dsb_weight_decay),
                      ("s5_lbl_grad_clip",    self.dsb_grad_clip),
                      ("s5_lbl_patience",     self.sp_patience),
                      ("s5_lbl_device",       self.cb_train_device)]),
        ):
            for _lk, _w in _linhas:
                _w.setMinimumWidth(110)
                _form.addRow(self._trL(_lk), _w)

        for label_key, widget in [
            ("s5_lbl_resume",      resume_row),
            (None,                 self.chk_freeze_enc),
            ("s5_lbl_ckpt_out",    ckpt_row),
        ]:
            pf.addRow(self._trL(label_key) if label_key else "", widget)

        def run_fn():
            import MODULES.pipeline_train as m

            root = Path(self.ed_root.text().strip())
            job = Path(self.job_dir)
            phase = self.cb_train_phase.currentText()

            if phase == "1":
                tensor_dir = root / "data" / "tensors"
                ckpt_out   = Path(self.ed_ckpt_out.text().strip() or root / "checkpoints" / "phase1")
                resume     = self.ed_resume.text().strip() or None

            elif phase == "2":
                tensor_dir    = job / "data" / "tensors" / "phase2"
                ckpt_out      = Path(self.ed_ckpt_out.text().strip() or job / "checkpoints" / "phase2")
                # Usa campo Browse se preenchido; caso contrário sugere fase 1 se existir
                _resume_field = self.ed_resume.text().strip()
                _resume_auto  = root / "checkpoints" / "phase1" / "best_model.pt"
                if _resume_field:
                    resume = _resume_field
                elif _resume_auto.exists():
                    resume = str(_resume_auto)
                    log.info(f"Phase 2: fine-tuning a partir de {_resume_auto}")
                else:
                    resume = None   # treina do zero com dados de fase 2

            else:  # phase == "3"
                tensor_dir    = job / "data" / "tensors" / "phase3"
                ckpt_out      = Path(self.ed_ckpt_out.text().strip() or job / "checkpoints" / "phase3")
                # Usa campo Browse se preenchido; caso contrário sugere fase 2 se existir,
                # depois fase 1, depois treina do zero
                _resume_field = self.ed_resume.text().strip()
                _resume_p2    = job  / "checkpoints" / "phase2" / "best_model.pt"
                _resume_p1    = root / "checkpoints" / "phase1" / "best_model.pt"
                if _resume_field:
                    resume = _resume_field
                elif _resume_p2.exists():
                    resume = str(_resume_p2)
                    log.info(f"Phase 3: fine-tuning a partir de {_resume_p2}")
                elif _resume_p1.exists():
                    resume = str(_resume_p1)
                    log.info(f"Phase 3: nenhum checkpoint de fase 2 encontrado, "
                            f"fine-tuning a partir de fase 1 ({_resume_p1})")
                else:
                    resume = None   # treina do zero com dados de fase 3

            if not (tensor_dir / "tensor_index.csv").exists():
                raise ValueError(i18n.t(
                    "s5_err_tensor_not_found", self._idioma,
                    phase=phase, tensor_dir=tensor_dir))

            return m.train, (), dict(
                epochs=self.sp_epochs.value(),
                batch_size=self.sp_batch.value(),
                latent_dim=self.sp_latent.value(),
                hidden_dim=self.sp_hidden.value(),
                n_gnn_layers=self.sp_gnn_layers.value(),
                lr=self.dsb_lr.value(),
                beta_max=self.dsb_beta.value(),
                beta_warmup=self.sp_warmup.value(),
                pos_weight=self.dsb_pos_weight.value(),
                stop_weight=self.dsb_stop_weight.value(),
                focal_weight=self.dsb_focal_weight.value(),
                dropout=self.dsb_dropout.value(),
                weight_decay=self.dsb_weight_decay.value(),
                grad_clip=self.dsb_grad_clip.value(),
                patience=self.sp_patience.value(),
                checkpoint_dir=str(ckpt_out),
                tensor_dir=str(tensor_dir),
                resume=resume,
                freeze_encoder=self.chk_freeze_enc.isChecked(),
                device=self.cb_train_device.currentText(),
            )

        return self._build_pipeline_tab(
            "title_step5",
            params, run_fn, "train", 4, 6, log_height=320,
            on_worker=self._open_training_plot, with_plot=True,
        )

    def _open_training_plot(self, worker):
        """Liga o worker do treino ao painel de curvas embutido na aba.

        A ligacao e feita no log_signal: o mesmo fluxo de linhas que alimenta
        o Execution Log alimenta o grafico, sem canal adicional entre
        processo filho e interface.
        """
        painel = getattr(self, "_training_plot", None)
        if painel is None:
            return
        painel.reset()
        worker.log_signal.connect(painel.feed_line)

    def _browse_resume(self):
        p, _ = QFileDialog.getOpenFileName(
            self, i18n.t("s5_dlg_select_best_model", self._idioma),
            self.ed_root.text(), "PyTorch (*.pt)")
        if p: self.ed_resume.setText(p)

    def _browse_ckpt_out(self):
        d = QFileDialog.getExistingDirectory(
            self, i18n.t("dlg_checkpoints_folder", self._idioma), self.ed_root.text())
        if d: self.ed_ckpt_out.setText(d)

    # ══════════════════════════════════════════════════════════════════════
    # TAB 7 — STEP 7: AVALIAÇÃO
    # ══════════════════════════════════════════════════════════════════════
    def _tab_step6(self):
        params = QWidget(); pf = QFormLayout(params); pf.setSpacing(10)

        self.ed_eval_ckpt = QLineEdit(); self.ed_eval_ckpt.setReadOnly(True)
        self._tr("ph_checkpoints_default", self.ed_eval_ckpt.setPlaceholderText)
        btn_eval_ckpt = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        btn_eval_ckpt.clicked.connect(self._browse_eval_ckpt)
        eck_row = QWidget(); el = QHBoxLayout(eck_row); el.setContentsMargins(0,0,0,0)
        el.addWidget(self.ed_eval_ckpt); el.addWidget(btn_eval_ckpt)
        self.chk_do_generate = QCheckBox()
        self._tr("s6_chk_do_generate", self.chk_do_generate.setText)

        pf.addRow(self._trL("s6_lbl_checkpoints"), eck_row)
        pf.addRow("",             self.chk_do_generate)

        # Botões de visualização de figuras — a chave (não o texto) é capturada na lambda, para
        # que o título repassado a _view_eval_fig reflita o idioma ATUAL no momento do clique,
        # não o idioma vigente quando o botão foi criado.
        vis_row = QWidget(); vl = QHBoxLayout(vis_row); vl.setContentsMargins(0,0,0,0)
        for name_key, stem in [("s6_btn_training_curves", "training_curves"),
                                ("s6_btn_performance_report", "performance_report")]:
            b = self._mk_btn_tr(name_key, _SS_BTN_SECONDARY, 180)
            b.clicked.connect(
                lambda _, s=stem, k=name_key: self._view_eval_fig(s, i18n.t(k, self._idioma))
            )
            vl.addWidget(b)
        pf.addRow(self._trL("s6_lbl_figures"), vis_row)

        # Diagnóstico "active units" (ver pipeline_evaluate.compute_active_units) sob demanda —
        # já entra também, automaticamente, no Performance Report gerado pelo botão Run acima
        # (título da figura); este botão existe para checar rápido um checkpoint específico sem
        # precisar rodar a avaliação inteira de novo.
        diag_row = QWidget(); dl = QHBoxLayout(diag_row); dl.setContentsMargins(0,0,0,0)
        self.btn_active_units = self._mk_btn_tr("s6_btn_active_units", _SS_BTN_SECONDARY, 220)
        self._tr("s6_tooltip_active_units", self.btn_active_units.setToolTip)
        self.btn_active_units.clicked.connect(self._run_active_units_check)
        dl.addWidget(self.btn_active_units)
        pf.addRow(self._trL("s6_lbl_diagnostics"), diag_row)

        self.cb_eval_phase = QComboBox()
        self.cb_eval_phase.addItems(["1", "2", "3"])
        pf.insertRow(0, self._trL("lbl_phase"), self.cb_eval_phase)
        
        def run_fn():
            import MODULES.pipeline_evaluate as m

            root = Path(self.ed_root.text().strip())
            job = Path(self.job_dir)
            phase = self.cb_eval_phase.currentText()

            if phase == "1":
                ckpt_dir = Path(self.ed_eval_ckpt.text().strip() or root / "checkpoints" / "phase1")
                tensor_dir = root / "data" / "tensors"
                fig_dir = root / "data" / "figures"
            elif phase == "2":
                ckpt_dir = Path(self.ed_eval_ckpt.text().strip() or job / "checkpoints" / "phase2")
                tensor_dir = job / "data" / "tensors" / "phase2"
                fig_dir = job / "data" / "figures" / "phase2"
            else:
                ckpt_dir = Path(self.ed_eval_ckpt.text().strip() or job / "checkpoints" / "phase3")
                tensor_dir = job / "data" / "tensors" / "phase3"
                fig_dir = job / "data" / "figures" / "phase3"

            return m.main, (), {
                "ckpt_dir": ckpt_dir,
                "do_generate": self.chk_do_generate.isChecked(),
                "tensor_dir": tensor_dir,
                "fig_dir": fig_dir,
            }

        return self._build_pipeline_tab(
            "title_step6",
            params, run_fn, "evaluate", 5, 7
        )

    def _browse_eval_ckpt(self):
        d = QFileDialog.getExistingDirectory(
            self, i18n.t("dlg_checkpoints_folder", self._idioma), self.ed_root.text())
        if d: self.ed_eval_ckpt.setText(d)

    def _run_active_units_check(self):
        """Dispara o diagnóstico "active units" (ver
        MODULES.pipeline_evaluate.compute_active_units) num processo filho
        (_pipeline_check_active_units), contra o checkpoint/fase selecionados
        no formulário desta aba — mesma resolução de caminho usada pelo
        run_fn() logo abaixo (campo Checkpoints se preenchido, senão
        checkpoints/phase<N>/ da fase escolhida)."""
        root = self.ed_root.text().strip()
        if not root:
            QMessageBox.warning(
                self, i18n.t("msg_warning_title", self._idioma),
                i18n.t("msg_please_start_job", self._idioma))
            return

        root_p = Path(root)
        job_p  = Path(self.job_dir) if self.job_dir else root_p
        phase  = self.cb_eval_phase.currentText()
        ed_ckpt = self.ed_eval_ckpt.text().strip()
        if phase == "1":
            ckpt_dir   = Path(ed_ckpt or root_p / "checkpoints" / "phase1")
            tensor_dir = root_p / "data" / "tensors"
        elif phase == "2":
            ckpt_dir   = Path(ed_ckpt or job_p / "checkpoints" / "phase2")
            tensor_dir = job_p / "data" / "tensors" / "phase2"
        else:
            ckpt_dir   = Path(ed_ckpt or job_p / "checkpoints" / "phase3")
            tensor_dir = job_p / "data" / "tensors" / "phase3"

        if not (ckpt_dir / "best_model.pt").exists():
            QMessageBox.warning(
                self, i18n.t("msg_warning_title", self._idioma),
                i18n.t("s7_err_no_checkpoint", self._idioma, phase=phase))
            return

        self.btn_active_units.setEnabled(False)
        self._au_log_lines = []
        worker = PipelineWorker(
            _pipeline_check_active_units, (), dict(ckpt_dir=ckpt_dir, tensor_dir=tensor_dir))

        def _collect(line):
            self._au_log_lines.append(line)

        def _done(ok):
            self.btn_active_units.setEnabled(True)
            texto = "\n".join(self._au_log_lines) or i18n.t(
                "s6_msg_active_units_no_output", self._idioma)
            titulo = i18n.t("s6_dlg_active_units_title", self._idioma)
            if ok:
                QMessageBox.information(self, titulo, texto)
            else:
                QMessageBox.critical(self, titulo, texto)
            self._workers.pop("active_units", None)

        worker.log_signal.connect(_collect)
        worker.finished_signal.connect(_done)
        self._workers["active_units"] = worker
        worker.start()

    # ══════════════════════════════════════════════════════════════════════
    # TAB 9 — STEP 9: GERAÇÃO
    # ══════════════════════════════════════════════════════════════════════
    def _tab_step7(self):
        params = QWidget(); pf = QFormLayout(params); pf.setSpacing(10)
        self.cb_gen_phase = QComboBox()
        self.cb_gen_phase.addItems(["1", "2", "3"])
        self.ed_gen_pdb = QLineEdit(); self.ed_gen_pdb.setReadOnly(True)
        self._tr("s7_ph_pdb", self.ed_gen_pdb.setPlaceholderText)
        btn_pdb = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        btn_pdb.clicked.connect(self._browse_gen_pdb)
        pdb_row = QWidget(); pl = QHBoxLayout(pdb_row); pl.setContentsMargins(0,0,0,0)
        pl.addWidget(self.ed_gen_pdb); pl.addWidget(btn_pdb)

        self.ed_gen_site_pdb = QLineEdit(); self.ed_gen_site_pdb.setReadOnly(True)
        self._tr("s7_ph_site_pdb", self.ed_gen_site_pdb.setPlaceholderText)
        btn_site_pdb = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        btn_site_pdb.clicked.connect(self._browse_gen_site_pdb)
        site_pdb_row = QWidget(); spl = QHBoxLayout(site_pdb_row); spl.setContentsMargins(0,0,0,0)
        spl.addWidget(self.ed_gen_site_pdb); spl.addWidget(btn_site_pdb)

        self.ed_gen_ckpt = QLineEdit(); self.ed_gen_ckpt.setReadOnly(True)
        self._tr("ph_checkpoints_default", self.ed_gen_ckpt.setPlaceholderText)
        btn_gc = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        btn_gc.clicked.connect(self._browse_gen_ckpt)
        gc_row = QWidget(); gl2 = QHBoxLayout(gc_row); gl2.setContentsMargins(0,0,0,0)
        gl2.addWidget(self.ed_gen_ckpt); gl2.addWidget(btn_gc)

        self.ed_gen_out = QLineEdit(); self.ed_gen_out.setReadOnly(True)
        self._tr("s7_ph_out", self.ed_gen_out.setPlaceholderText)
        btn_gout = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        btn_gout.clicked.connect(self._browse_gen_out)
        gout_row = QWidget(); gl3 = QHBoxLayout(gout_row); gl3.setContentsMargins(0,0,0,0)
        gl3.addWidget(self.ed_gen_out); gl3.addWidget(btn_gout)

        self.ed_ligand_ref = QLineEdit(); self.ed_ligand_ref.setReadOnly(True)
        self._tr("s7_ph_ligand_ref", self.ed_ligand_ref.setPlaceholderText)
        btn_ref = self._mk_btn_tr("btn_browse", _SS_BTN_SECONDARY, 100)
        btn_ref.clicked.connect(self._browse_ligand_ref)
        ref_row = QWidget(); rl2 = QHBoxLayout(ref_row); rl2.setContentsMargins(0,0,0,0)
        rl2.addWidget(self.ed_ligand_ref); rl2.addWidget(btn_ref)

        self.sp_n_samples  = QSpinBox(); self.sp_n_samples.setRange(1,10000); self.sp_n_samples.setValue(200)
        self.dsb_temp      = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_temp.setDecimals(2); self.dsb_temp.setRange(0.1,5.0); self.dsb_temp.setValue(1.0)
        self._tr("s7_tooltip_temperature", self.dsb_temp.setToolTip)
        self.dsb_stop_thr  = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_stop_thr.setDecimals(2); self.dsb_stop_thr.setRange(0.05, 0.95)
        self.dsb_stop_thr.setSingleStep(0.05); self.dsb_stop_thr.setValue(0.50)
        self._tr("s7_tooltip_stop_threshold", self.dsb_stop_thr.setToolTip)
        self.dsb_bond_thr  = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_bond_thr.setDecimals(2); self.dsb_bond_thr.setRange(0.05, 0.95)
        self.dsb_bond_thr.setSingleStep(0.05); self.dsb_bond_thr.setValue(0.50)
        self._tr("s7_tooltip_bond_threshold", self.dsb_bond_thr.setToolTip)
        self.sp_cutoff_gen = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.sp_cutoff_gen.setDecimals(1); self.sp_cutoff_gen.setRange(3.0,15.0); self.sp_cutoff_gen.setValue(6.0)
        self.sp_top_n      = QSpinBox(); self.sp_top_n.setRange(1,200); self.sp_top_n.setValue(20)
        self.sp_min_atoms_gen = QSpinBox(); self.sp_min_atoms_gen.setRange(1,30); self.sp_min_atoms_gen.setValue(5)

        # ── Definição do sítio sem ligante co-cristalizado ──────────────────
        # Quando a proteína não tem HETATM, extract_site_from_pdb recorreria
        # ao centro geométrico da proteína, que raramente é o bolso real.
        # Os dois caminhos abaixo cobrem esse caso: coordenadas informadas
        # pelo usuário, ou busca heurística pelo P2Rank. São mutuamente
        # exclusivos — marcar a busca desabilita os campos de coordenada.
        # Coordenadas do centro do sítio: aceitam ponto e vírgula, com o
        # separador exibido seguindo o idioma da interface (ver
        # LocaleAwareDoubleSpinBox). Coordenadas de PDB vêm com ponto.
        self.dsb_site_x = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_site_y = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_site_z = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        for _sp in (self.dsb_site_x, self.dsb_site_y, self.dsb_site_z):
            _sp.setDecimals(3); _sp.setRange(-9999.0, 9999.0); _sp.setValue(0.0)
            _sp.setSingleStep(0.5)
        # O locale e' reaplicado na troca de idioma pelo gancho global em
        # _definir_idioma, que varre todos os LocaleAwareDoubleSpinBox.

        self.chk_use_site_center = QCheckBox()
        self._tr("s7_chk_use_site_center", self.chk_use_site_center.setText)
        self._tr("s7_tooltip_site_center", self.chk_use_site_center.setToolTip)
        self.chk_use_site_center.setChecked(False)

        center_row = QWidget()
        crl = QHBoxLayout(center_row); crl.setContentsMargins(0,0,0,0)
        for _lbl, _sp in (("X:", self.dsb_site_x), ("Y:", self.dsb_site_y),
                          ("Z:", self.dsb_site_z)):
            crl.addWidget(QLabel(_lbl)); crl.addWidget(_sp)

        self.dsb_site_radius = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_site_radius.setDecimals(1); self.dsb_site_radius.setRange(4.0, 25.0)
        self.dsb_site_radius.setValue(10.0); self.dsb_site_radius.setSingleStep(0.5)
        self._tr("s7_tooltip_site_radius", self.dsb_site_radius.setToolTip)

        self.chk_heuristic_search = QCheckBox()
        self._tr("s7_chk_heuristic_search", self.chk_heuristic_search.setText)
        self._tr("s7_tooltip_heuristic_search", self.chk_heuristic_search.setToolTip)
        self.chk_heuristic_search.setChecked(False)

        self.sp_pocket_rank = QSpinBox()
        self.sp_pocket_rank.setRange(1, 20); self.sp_pocket_rank.setValue(1)
        self._tr("s7_tooltip_pocket_rank", self.sp_pocket_rank.setToolTip)

        def _sync_site_mode():
            """Mantém os três modos de definição de sítio mutuamente exclusivos."""
            heur = self.chk_heuristic_search.isChecked()
            manual = self.chk_use_site_center.isChecked() and not heur
            self.chk_use_site_center.setEnabled(not heur)
            for _w in (self.dsb_site_x, self.dsb_site_y, self.dsb_site_z):
                _w.setEnabled(manual)
            self.sp_pocket_rank.setEnabled(heur)
            # O raio vale para os dois caminhos: o P2Rank devolve um centro,
            # não um conjunto de resíduos, então o recorte é feito aqui.
            self.dsb_site_radius.setEnabled(manual or heur)

        self.chk_heuristic_search.toggled.connect(lambda _: _sync_site_mode())
        self.chk_use_site_center.toggled.connect(lambda _: _sync_site_mode())
        self._sync_site_mode = _sync_site_mode
        _sync_site_mode()

        # ── Protonação do sítio + método QM — DEVE bater com o que foi usado
        # para gerar os tensores de treino da fase escolhida, senão o tensor
        # de inferência não tem a mesma distribuição do treino (ver nota em
        # pipeline_generate.pdb_to_site_tensor). Defaults iguais aos da
        # Step 3 por esse motivo — mude só se souber que o treino usou algo
        # diferente.
        # NOTA (ver resolve_site_config_overrides em pipeline_generate.py):
        # desde que o checkpoint passou a gravar a config de voxelização usada
        # no treino (best_model.pt["config"]["voxel_config"]), estes campos
        # só valem como FALLBACK — usados de fato apenas (a) para checkpoints
        # treinados antes desta funcionalidade existir, ou (b) para qualquer
        # chave que o checkpoint não tenha gravado. Quando o checkpoint tem
        # um valor gravado, ele sempre vence sobre a escolha manual aqui (com
        # aviso no log se os dois divergirem) — não é mais possível gerar
        # com um mismatch treino↔inferência por engano nestes 4 campos.
        self.chk_gen_protonate_site = QCheckBox()
        self._tr("s7_chk_protonate_site", self.chk_gen_protonate_site.setText)
        self.chk_gen_protonate_site.setChecked(True)
        self.dsb_gen_ph = LocaleAwareDoubleSpinBox(idioma=self._idioma)
        self.dsb_gen_ph.setDecimals(1); self.dsb_gen_ph.setRange(0.0, 14.0)
        self.dsb_gen_ph.setValue(7.4); self.dsb_gen_ph.setSingleStep(0.5)
        self.cb_gen_site_qm_method = self._mk_combo_tr(
            ["qm_method_rhf_fragments", "qm_method_gfn_xtb_fragments",
             "qm_method_heuristic"]
        )
        self._tr("s7_tooltip_gen_qm_method", self.cb_gen_site_qm_method.setToolTip)
        self._GEN_SITE_QM_METHOD_VALUES = [
            "rhf_sto3g_fragments", "gfn_xtb_fragments", "heuristic",
        ]
        # qm_basis (base do RHF/STO-3G por resíduo) — antes desta correção
        # não existia NENHUM controle equivalente na Etapa 7: a geração
        # sempre usava o default "sto-3g" do módulo, mesmo que o treino
        # tivesse usado 3-21g/6-31g, sem nenhum aviso. Continua valendo só
        # como fallback (mesma regra acima).
        self.cb_gen_qm_basis = QComboBox()
        self.cb_gen_qm_basis.addItems(["sto-3g", "3-21g", "6-31g"])
        self._tr("s7_tooltip_gen_qm_basis", self.cb_gen_qm_basis.setToolTip)

        # ── FF de geometria final (minimização conjunta ligante+sítio) ───────
        self.cb_final_ff = self._mk_combo_tr(["ff_mmff_uff", "ff_amber_ff14sb", "ff_charmm36"])
        self.cb_final_ff.setCurrentIndex(0)   # MMFF/UFF — mais simples/rápido, pré-selecionado
        self._tr("s7_tooltip_final_ff", self.cb_final_ff.setToolTip)
        self._FINAL_FF_VALUES = ["mmff_uff", "amber_ff14sb", "charmm36"]

        # ── Induced-fit: backbone travado, cadeia lateral livre ──────────────
        self.chk_induced_fit = QCheckBox()
        self._tr("s7_chk_induced_fit", self.chk_induced_fit.setText)
        self.chk_induced_fit.setChecked(False)   # desmarcado por padrão — sítio rígido
        self._tr("s7_tooltip_induced_fit", self.chk_induced_fit.setToolTip)

        for label_key, widget in [
            ("s7_lbl_model_phase",   self.cb_gen_phase),
            ("s7_lbl_protein_pdb",   pdb_row),
            ("s7_lbl_site_pdb",      site_pdb_row),
            ("s6_lbl_checkpoints",   gc_row),
            ("s7_lbl_output",        gout_row),
            ("s7_lbl_ref_ligand",    ref_row),
            ("s7_lbl_n_samples",     self.sp_n_samples),
            ("s7_lbl_temperature",   self.dsb_temp),
            ("s7_lbl_stop_threshold", self.dsb_stop_thr),
            ("s7_lbl_bond_threshold", self.dsb_bond_thr),
            ("s7_lbl_cutoff",        self.sp_cutoff_gen),
            ("s7_lbl_top_n",         self.sp_top_n),
            ("s7_lbl_min_atoms",     self.sp_min_atoms_gen),
            (None,                   self.chk_use_site_center),
            ("s7_lbl_site_center",   center_row),
            ("s7_lbl_site_radius",   self.dsb_site_radius),
            (None,                   self.chk_heuristic_search),
            ("s7_lbl_pocket_rank",   self.sp_pocket_rank),
            (None,                   self.chk_gen_protonate_site),
            ("s3_lbl_site_ph",       self.dsb_gen_ph),
            ("s3_lbl_site_qm_method", self.cb_gen_site_qm_method),
            ("s3_lbl_qm_basis",      self.cb_gen_qm_basis),
            ("s7_lbl_final_ff",      self.cb_final_ff),
            (None,                   self.chk_induced_fit),
        ]:
            pf.addRow(self._trL(label_key) if label_key else "", widget)

        def run_fn():
            pdb = self.ed_gen_pdb.text().strip()
            if not pdb or not os.path.isfile(pdb):
                raise ValueError(i18n.t("s7_err_invalid_pdb", self._idioma))
            site_pdb = self.ed_gen_site_pdb.text().strip() or None
            if site_pdb and not os.path.isfile(site_pdb):
                raise ValueError(i18n.t("s7_err_invalid_site_pdb", self._idioma))

            heur = self.chk_heuristic_search.isChecked()
            usa_centro = self.chk_use_site_center.isChecked() and not heur
            # site_pdb já delimita o bolso; centro ou busca seriam ignorados
            # silenciosamente, então avisa em vez de deixar passar.
            if site_pdb and (heur or usa_centro):
                raise ValueError(i18n.t("s7_err_site_conflict", self._idioma))
            centro = ((self.dsb_site_x.value(), self.dsb_site_y.value(),
                       self.dsb_site_z.value()) if usa_centro else None)
            if usa_centro and centro == (0.0, 0.0, 0.0):
                raise ValueError(i18n.t("s7_err_center_zero", self._idioma))
            root   = self.ed_root.text().strip()
            phase = self.cb_gen_phase.currentText()
            if phase == "1":
                ckpt = self.ed_gen_ckpt.text().strip() or str(Path(root) / "checkpoints" / "phase1")
            elif phase == "2":
                ckpt = self.ed_gen_ckpt.text().strip() or str(Path(self.job_dir) / "checkpoints" / "phase2")
            else:
                ckpt = self.ed_gen_ckpt.text().strip() or str(Path(self.job_dir) / "checkpoints" / "phase3")

            if not (Path(ckpt) / "best_model.pt").exists():
                raise ValueError(i18n.t("s7_err_no_checkpoint", self._idioma, phase=phase))
            out    = self.ed_gen_out.text().strip() or None
            ref    = self.ed_ligand_ref.text().strip() or None
            from pathlib import Path as _P

            return _pipeline_generate, (), dict(
                root        = root,
                job_dir     = self.job_dir or None,
                pdb         = pdb,
                ckpt        = ckpt,
                n_samples   = self.sp_n_samples.value(),
                temperature = self.dsb_temp.value(),
                stop_threshold = self.dsb_stop_thr.value(),
                bond_threshold = self.dsb_bond_thr.value(),
                cutoff      = self.sp_cutoff_gen.value(),
                min_atoms   = self.sp_min_atoms_gen.value(),
                top_n       = self.sp_top_n.value(),
                out         = self.ed_gen_out.text().strip() or None,
                ligand_ref  = self.ed_ligand_ref.text().strip() or None,
                site_pdb    = site_pdb,
                site_config_overrides = dict(
                    protonate_site = self.chk_gen_protonate_site.isChecked(),
                    ph             = self.dsb_gen_ph.value(),
                    site_qm_method = self._GEN_SITE_QM_METHOD_VALUES[
                        self.cb_gen_site_qm_method.currentIndex()
                    ],
                    qm_basis       = self.cb_gen_qm_basis.currentText(),
                ),
                final_ff = self._FINAL_FF_VALUES[self.cb_final_ff.currentIndex()],
                induced_fit = self.chk_induced_fit.isChecked(),
                site_center      = centro,
                site_radius      = self.dsb_site_radius.value(),
                heuristic_search = heur,
                pocket_rank      = self.sp_pocket_rank.value(),
            )

        return self._build_pipeline_tab(
            "title_step7",
            params, run_fn, "generate", 6, 0, log_height=260
        )

    def _browse_gen_pdb(self):
        p, _ = QFileDialog.getOpenFileName(
            self, i18n.t("s7_dlg_select_pdb", self._idioma), self.ed_root.text(), "PDB (*.pdb)")
        if p: self.ed_gen_pdb.setText(p)

    def _browse_gen_site_pdb(self):
        p, _ = QFileDialog.getOpenFileName(
            self,
            i18n.t("s7_dlg_select_site_pdb", self._idioma),
            self.ed_root.text(),
            "PDB (*.pdb)",
        )
        if p: self.ed_gen_site_pdb.setText(p)

    def _browse_gen_ckpt(self):
        d = QFileDialog.getExistingDirectory(
            self, i18n.t("dlg_checkpoints_folder", self._idioma), self.ed_root.text())
        if d: self.ed_gen_ckpt.setText(d)

    def _browse_moad_dir(self):
        d = QFileDialog.getExistingDirectory(
            self, i18n.t("dlg_moad_folder", self._idioma), self.ed_root.text())
        if d: self.ed_moad_dir.setText(d)

    def _browse_gen_out(self):
        d = QFileDialog.getExistingDirectory(
            self, i18n.t("s7_dlg_output_folder", self._idioma), self.ed_root.text())
        if d: self.ed_gen_out.setText(d)

    def _browse_ligand_ref(self):
        p, _ = QFileDialog.getOpenFileName(
            self, i18n.t("s7_dlg_reference_ligand", self._idioma),
            self.ed_root.text(), "Ligand files (*.sdf *.pdb *.mol2)")
        if p: self.ed_ligand_ref.setText(p)

    # ══════════════════════════════════════════════════════════════════════
    # HELPERS GERAIS
    # ══════════════════════════════════════════════════════════════════════
    def _view_fig(self, stem, title):
        """Exibe figura a partir do fig_dir padrão (root/data/figures)."""
        root    = self.ed_root.text().strip()
        fig_dir = os.path.join(root, "data", "figures") if root else ""
        for ext in ("png", "svg"):
            path = os.path.join(fig_dir, f"{stem}.{ext}")
            if os.path.isfile(path):
                self._view_fig_path(path, title)
                return
        QMessageBox.information(
            self, i18n.t("msg_figure_not_found", self._idioma),
            i18n.t("msg_run_step_first", self._idioma, fig_dir=fig_dir))

    def _view_fig_path(self, path: str, title: str):
        """Exibe uma figura dado o caminho absoluto."""
        dlg = QDialog(self); dlg.setWindowTitle(title); dlg.resize(920, 640)
        lay = QVBoxLayout(dlg)
        scroll = QScrollArea(); lbl = QLabel()
        pix = QPixmap(path)
        if pix.isNull():
            QMessageBox.warning(
                self, i18n.t("msg_error_title", self._idioma),
                i18n.t("msg_could_not_load", self._idioma, path=path)); return
        lbl.setPixmap(pix.scaled(880, 580, Qt.KeepAspectRatio, Qt.SmoothTransformation))
        lbl.setAlignment(Qt.AlignCenter)
        scroll.setWidget(lbl); scroll.setWidgetResizable(True)
        lay.addWidget(scroll)
        br = QHBoxLayout()
        b_open = _mk_btn(i18n.t("btn_open_in_system", self._idioma), _SS_BTN_PRIMARY, 160)
        b_open.clicked.connect(lambda: subprocess.Popen(["xdg-open", path]))
        b_close = _mk_btn(i18n.t("btn_close", self._idioma), _SS_BTN_PRIMARY, 100)
        b_close.clicked.connect(dlg.accept)
        br.addStretch(); br.addWidget(b_open); br.addWidget(b_close)
        lay.addLayout(br)
        dlg.exec_()

    def _view_explore_dashboard(self):
        """Gera/atualiza e abre o dashboard da fase selecionada no grupo Data Exploration."""
        phase = self.cb_explore_phase.currentText()
        root = Path(self.ed_root.text().strip())
        job = Path(self.job_dir) if self.job_dir else root

        if phase == "1":
            curated_dir = root / "data" / "curated"
            metadata_csv = root / "data" / "curated_metadata.csv"
            fig_dir = root / "data" / "figures"
        elif phase == "2":
            curated_dir = job / "data" / "curated" / "phase2"
            metadata_csv = job / "data" / "curated" / "phase2_metadata.csv"
            fig_dir = job / "data" / "figures" / "phase2"
        else:
            curated_dir = job / "data" / "curated" / "phase3"
            metadata_csv = job / "data" / "curated" / "phase3_metadata.csv"
            fig_dir = job / "data" / "figures" / "phase3"

        try:
            import MODULES.pipeline_explore as m
            QApplication.setOverrideCursor(Qt.WaitCursor)
            m.main(
                curated_dir=curated_dir,
                metadata_csv=metadata_csv,
                fig_dir=fig_dir,
            )
        except Exception as exc:
            QMessageBox.critical(
                self,
                i18n.t("msg_config_error_title", self._idioma),
                str(exc),
            )
            return
        finally:
            QApplication.restoreOverrideCursor()

        for ext in ("png", "svg"):
            path = fig_dir / f"summary_dashboard.{ext}"
            if path.is_file():
                self._view_fig_path(
                    str(path), i18n.t("msg_summary_dashboard_title", self._idioma, phase=phase))
                return

        QMessageBox.information(
            self, i18n.t("msg_figure_not_found", self._idioma),
            i18n.t("msg_run_dataexp_first", self._idioma, phase=phase, fig_dir=str(fig_dir))
        )

    def _view_eval_fig(self, stem: str, title: str):
        """Abre figura de avaliação da fase selecionada no Step 6."""
        phase = self.cb_eval_phase.currentText()
        root  = Path(self.ed_root.text().strip())
        job   = Path(self.job_dir) if self.job_dir else root

        if phase == "1":
            fig_dir = root / "data" / "figures"
        elif phase == "2":
            fig_dir = job / "data" / "figures" / "phase2"
        else:
            fig_dir = job / "data" / "figures" / "phase3"

        for ext in ("png", "svg"):
            path = fig_dir / f"{stem}.{ext}"
            if path.exists():
                self._view_fig_path(
                    str(path),
                    i18n.t("msg_fig_title_with_phase", self._idioma, title=title, phase=phase))
                return

        QMessageBox.information(
            self, i18n.t("msg_figure_not_found", self._idioma),
            i18n.t("msg_run_step6_first", self._idioma, phase=phase, fig_dir=fig_dir)
        )

    def _show_requirements(self):
        if not _REQ_MODULE_OK:
            QMessageBox.warning(
                self, i18n.t("msg_module_not_found_title", self._idioma),
                i18n.t("msg_module_not_found_body", self._idioma)); return
        self._req_win = RequirementsInstaller(None)
        self._req_win.setWindowModality(Qt.ApplicationModal)
        self._req_win.show(); self._req_win.activateWindow(); self._req_win.raise_()

    def _open_terminal(self):
        """Abre um visualizador do log de terminal da sessão atual do CODEEP."""
        if self._terminal_viewer_proc is not None and self._terminal_viewer_proc.poll() is None:
            return

        log_path = str(_APP_TERMINAL_LOG)
        candidates = [
            ["x-terminal-emulator", "-e", "tail", "-n", "+1", "-F", log_path],
            ["gnome-terminal", "--", "tail", "-n", "+1", "-F", log_path],
            ["konsole", "-e", "tail", "-n", "+1", "-F", log_path],
            ["xfce4-terminal", "--title=CODEEP Terminal", "--command", f"tail -n +1 -F '{log_path}'"],
            ["xterm", "-T", "CODEEP Terminal", "-e", "tail", "-n", "+1", "-F", log_path],
        ]
        for cmd in candidates:
            try:
                self._terminal_viewer_proc = subprocess.Popen(cmd, cwd=str(_APP_DIR))
                return
            except Exception:
                continue
        QMessageBox.warning(
            self, i18n.t("msg_warning_title", self._idioma),
            i18n.t("home_msg_terminal_unavailable", self._idioma),
        )

    def _show_about(self):
        QMessageBox.about(
            self,
            i18n.t("about_title", self._idioma),
            f"{i18n.t('about_body', self._idioma)}\n\nVersion: {VERSAO}")

    def _generate_final_report(self):
        if not self.job_dir:
            QMessageBox.warning(
                self, i18n.t("msg_warning_title", self._idioma),
                i18n.t("msg_please_start_job", self._idioma),
            )
            return

        self._save_all_tab_states()
        report_payload = {
            "job_id": os.path.basename(os.path.normpath(self.job_dir)),
            "job_dir": self.job_dir,
            "root_dir": self.ed_root.text().strip(),
            "generated_at": datetime.now().isoformat(),
            "version": VERSAO,
            "tabs": {},
        }

        for step_key in self._tab_state_specs:
            report_payload["tabs"][step_key] = self._read_tab_state(step_key, self.job_dir)

        report_path = os.path.join(self.job_dir, "final_report.json")
        try:
            with open(report_path, "w", encoding="utf-8") as f:
                json.dump(report_payload, f, indent=2, ensure_ascii=False)
        except OSError as e:
            QMessageBox.critical(self, i18n.t("msg_error_title", self._idioma), str(e))
            return

        QMessageBox.information(
            self, i18n.t("report_title_done", self._idioma),
            i18n.t("report_saved", self._idioma, path=report_path),
        )


# ==========================================================================================================================================
# ═══════════════════════ PONTO DE ENTRADA ═════════════════════════════════
# ==========================================================================================================================================
if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setApplicationName("CODEEP")

    window = MainWindow()
    window.show()
    sys.exit(app.exec_())
